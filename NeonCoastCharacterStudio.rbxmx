	}
end

------------------------------------------------------------------ neck: chains, pendants, ties (frame "chest")
-- in the chest frame the neck base sits at about (0, 0.78, 0.6), the chest surface at z = 0
local function chainPath(drop, n, spread)
	local s = spread or 0.3
	local left = bezier(V3(-s, 0.78, 0.44), V3(-s * 1.05, 0.78 - drop * 0.62, -0.1), V3(0, 0.78 - drop, -0.06), n)
	local right = bezier(V3(0, 0.78 - drop, -0.06), V3(s * 1.05, 0.78 - drop * 0.62, -0.1), V3(s, 0.78, 0.44), n)
	local pts = left
	for i = 2, #right do
		table.insert(pts, right[i])
	end
	return pts, V3(0, 0.78 - drop, -0.06)
end

local function pendant(kind, at, x)
	local t = {}
	local g = x.iced and "c2" or "c1"
	local gm = x.iced and { m = GLA, refl = 0.45, spark = true } or { m = MET, refl = 0.3 }
	local below = at + V3(0, -0.04, -0.03)
	if kind == "cross" then
		table.insert(t, p("Block", "chest", V3(0.05, 0.34, 0.03), below + V3(0, -0.17, 0), nil, g, gm))
		table.insert(t, p("Block", "chest", V3(0.2, 0.05, 0.03), below + V3(0, -0.1, 0), nil, g, gm))
	elseif kind == "medallion" then
		table.insert(t, cylZ("chest", 0.035, 0.32, below + V3(0, -0.17, 0), "c1", { m = MET, refl = 0.3 }))
		table.insert(t, cylZ("chest", 0.04, 0.16, below + V3(0, -0.17, -0.02), "c2", { m = GLA, refl = 0.45, spark = x.iced }))
	elseif kind == "diamond" then
		table.insert(t, p("Block", "chest", V3(0.14, 0.14, 0.06), below + V3(0, -0.12, 0), V3(0, 0, 45), "c2", { m = GLA, refl = 0.5, spark = true }))
	elseif kind == "crown" then
		table.insert(t, p("Block", "chest", V3(0.26, 0.1, 0.03), below + V3(0, -0.2, 0), nil, g, gm))
		for i = -1, 1 do
			table.insert(t, p("Wedge", "chest", V3(0.06, 0.12, 0.03), below + V3(i * 0.09, -0.1, 0), nil, g, gm))
		end
	elseif kind == "heart" then
		add(t, mirror({ p("Ball", "chest", V3(0.13, 0.13, 0.04), below + V3(0.045, -0.12, 0), nil, g, gm) }))
		table.insert(t, p("Block", "chest", V3(0.12, 0.12, 0.035), below + V3(0, -0.18, 0), V3(0, 0, 45), g, gm))
	elseif kind == "bolt" then
		table.insert(t, p("Block", "chest", V3(0.06, 0.2, 0.03), below + V3(0.03, -0.12, 0), V3(0, 0, -20), g, gm))
		table.insert(t, p("Block", "chest", V3(0.06, 0.2, 0.03), below + V3(-0.02, -0.26, 0), V3(0, 0, -20), g, gm))
	elseif kind == "lock" then
		table.insert(t, p("Block", "chest", V3(0.2, 0.16, 0.06), below + V3(0, -0.2, 0), nil, g, gm))
		table.insert(t, cylZ("chest", 0.03, 0.14, below + V3(0, -0.1, 0), "c1", { m = MET }))
	elseif kind == "dogtags" then
		table.insert(t, p("Block", "chest", V3(0.12, 0.2, 0.015), below + V3(-0.02, -0.12, 0), V3(0, 0, 8), "c1", { m = MET, refl = 0.2 }))
		table.insert(t, p("Block", "chest", V3(0.12, 0.2, 0.015), below + V3(0.03, -0.15, -0.01), V3(0, 0, -6), "c1", { m = MET, refl = 0.2 }))
	elseif kind == "piece" then -- a big iced square piece
		table.insert(t, p("Block", "chest", V3(0.36, 0.36, 0.05), below + V3(0, -0.2, 0), nil, "c1", { m = MET, refl = 0.3 }))
		for i = -1, 1 do
			for j = -1, 1 do
				table.insert(t, p("Ball", "chest", V3(0.09, 0.09, 0.04), below + V3(i * 0.1, -0.2 + j * 0.1, -0.03), nil, "c2", { m = GLA, refl = 0.5, spark = (i == 0 and j == 0) }))
			end
		end
	elseif kind == "money" then -- a money bag
		table.insert(t, p("Ball", "chest", V3(0.24, 0.26, 0.12), below + V3(0, -0.2, 0), nil, g, gm))
		table.insert(t, p("Ball", "chest", V3(0.1, 0.08, 0.08), below + V3(0, -0.07, 0), nil, g, gm))
	elseif kind == "letter" then -- a big iced initial / name plate
		table.insert(t, p("Block", "chest", V3(0.34, 0.34, 0.05), below + V3(0, -0.2, 0), nil, "c1", { m = MET, refl = 0.3, t = 0.0 }))
		table.insert(t, p("Block", "chest", V3(0.32, 0.32, 0.01), below + V3(0, -0.2, -0.03), nil, "c2", { m = GLA, refl = 0.5, t = 1, spark = true, txt = { text = x.letter or "N", color = "c2", face = "Front" } }))
	elseif kind == "palm" then -- a palm tree (Neon Coast)
		table.insert(t, p("Block", "chest", V3(0.04, 0.24, 0.03), below + V3(0, -0.2, 0), V3(0, 0, 6), g, gm))
		for i = 0, 4 do
			table.insert(t, p("Block", "chest", V3(0.16, 0.03, 0.03), below + V3(math.cos(rad(i * 45)) * 0.06, -0.08 + math.sin(rad(i * 45)) * 0.03, 0), V3(0, 0, i * 45 - 90), g, gm))
		end
	end
	return t
end

F.chain = function(pp)
	local drop = pp.drop or 0.6
	local pts, low = chainPath(drop, pp.n or 9, pp.spread)
	local style = pp.style or "cuban"
	local c = pp.iced and "c2" or "c1"
	local x = pp.iced and { m = GLA, refl = 0.45 } or { m = MET, refl = 0.3 }
	if style == "pearl" then
		x = { m = SMO, refl = 0.15 }
	elseif style == "puka" then
		x = { m = SMO }
	end
	local t = along("chest", pts, (style == "pearl" or style == "puka") and "c1" or c, style, pp.w or 0.06, x)
	if pp.iced and #t > 0 then
		t[math.floor(#t / 2)].spark = true
		t[1].spark = true
	end
	if pp.pendant then
		add(t, pendant(pp.pendant, low, pp))
	end
	if pp.layer then -- a second, shorter chain (layered look)
		local pts2 = chainPath(drop * 0.6, 7, (pp.spread or 0.3) * 0.95)
		add(t, along("chest", pts2, c, pp.layer, (pp.w or 0.06) * 0.8, x))
	end
	return t
end
F.choker = function(pp)
	return ring("neck", V3(0, -0.02, 0.06), 0.33, 16, pp.studs and "Ball" or "Block", "c1", "Y", { m = pp.studs and MET or LEA }, pp.studs and V3(0.06, 0.06, 0.06) or V3(0.05, 0.1, 0.16))
end
F.tie = function(pp)
	local t = {
		p("Block", "chest", V3(0.13, 0.11, 0.06), V3(0, 0.7, -0.08), nil, "c1", { m = FAB }),
	}
	if pp.bow then
		add(t, mirror({ p("Wedge", "chest", V3(0.04, 0.12, 0.16), V3(0.09, 0.7, -0.09), V3(0, -90, 0), "c1", { m = FAB }) }))
	else
		table.insert(t, p("Block", "chest", V3(0.15, 0.85, 0.03), V3(0, 0.22, -0.07), V3(-4, 0, 0), "c1", { m = FAB }))
		table.insert(t, p("Block", "chest", V3(0.15, 0.1, 0.03), V3(0, -0.24, -0.08), V3(0, 0, 45), "c1", { m = FAB }))
	end
	return t
end
F.scarf = function()
	local t = {
		cylY("neck", 0.3, 0.72, V3(0, 0.0, 0.06), "c1", { m = FAB }),
		p("Block", "chest", V3(0.24, 0.85, 0.07), V3(0.14, 0.25, -0.1), V3(-5, 0, 4), "c1", { m = FAB }),
		p("Block", "chest", V3(0.24, 0.6, 0.07), V3(-0.14, 0.35, -0.12), V3(-5, 0, -4), "c2", { m = FAB }),
	}
	return t
end

------------------------------------------------------------------ grillz (frame "head")
F.grillz = function(pp)
	local t = {}
	local function row(y, n, h)
		for i = 1, n do
			local a = rad((i - (n + 1) / 2) * (80 / n))
			local pos = V3(math.sin(a) * 0.55, y, FACE.mouthZ + 0.53 - math.cos(a) * 0.55)
			local key = pp.iced and "c2" or "c1"
			if pp.fang and (i == 2 or i == n - 1) then
				h = h * 1.5
			end
			local q = p("Block", "head", V3(0.105, h, 0.05), pos, V3(0, math.deg(a), 0), key, pp.iced and { m = GLA, refl = 0.5 } or { m = MET, refl = 0.35 })
			if pp.iced and i == math.ceil(n / 2) then
				q.spark = true
			end
			if pp.gap and i == math.ceil(n / 2) then
				q.c = "tooth"
				q.m = SMO
			end
			table.insert(t, q)
		end
	end
	row(FACE.mouthY + 0.06, pp.top or 6, 0.12)
	if (pp.bottom or 0) > 0 then
		row(FACE.mouthY - 0.07, pp.bottom, 0.1)
	end
	return t
end

------------------------------------------------------------------ earrings (frame "head")
F.earrings = function(pp)
	local lobe = V3(FACE.earX + 0.03, FACE.lobeY, FACE.earZ)
	local t = {}
	local kind = pp.kind or "stud"
	if kind == "stud" then
		table.insert(t, p("Ball", "head", V3(pp.size or 0.14, pp.size or 0.14, pp.size or 0.14), lobe, nil, "c2", { m = GLA, refl = 0.5, spark = true }))
	elseif kind == "hoop" then
		add(t, ring("head", lobe + V3(0.02, -(pp.size or 0.22), 0), pp.size or 0.22, 12, "Cyl", "c1", "X", { m = MET, refl = 0.35 }, V3(0.12, 0.04, 0.04)))
	elseif kind == "cross" then
		table.insert(t, p("Block", "head", V3(0.03, 0.24, 0.03), lobe + V3(0.02, -0.14, 0), nil, "c1", { m = MET, refl = 0.3 }))
		table.insert(t, p("Block", "head", V3(0.03, 0.03, 0.14), lobe + V3(0.02, -0.08, 0), nil, "c1", { m = MET, refl = 0.3 }))
	elseif kind == "pearl" then
		table.insert(t, p("Ball", "head", V3(0.15, 0.15, 0.15), lobe + V3(0.02, -0.08, 0), nil, "pearl", { m = SMO, refl = 0.15 }))
	elseif kind == "dangle" then
		table.insert(t, p("Block", "head", V3(0.03, 0.3, 0.03), lobe + V3(0.02, -0.15, 0), nil, "c1", { m = MET }))
		table.insert(t, p("Block", "head", V3(0.03, 0.14, 0.14), lobe + V3(0.02, -0.34, 0), V3(45, 0, 0), "c2", { m = GLA, refl = 0.5, spark = true }))
	end
	if pp.one then
		return t
	end
	return mirror(t)
end

------------------------------------------------------------------ wrists, hands (frames "LWrist"/"RWrist"/"LHand"/"RHand")
F.watch = function(pp)
	local f = pp.right and "RWrist" or "LWrist"
	local side = pp.right and 1 or -1
	local t = {
		cylY(f, 0.28, 1.14, V3(0, 0, 0), pp.iced and "c2" or "c1", pp.iced and { m = GLA, refl = 0.45 } or { m = pp.smart and RUB or MET, refl = 0.3 }),
	}
	if pp.smart then
		table.insert(t, p("Block", f, V3(0.12, 0.45, 0.4), V3(side * 0.56, 0, 0), nil, "black", { m = GLA, refl = 0.3 }))
		table.insert(t, p("Block", f, V3(0.02, 0.36, 0.3), V3(side * 0.63, 0, 0), nil, "c2", { glow = true, m = NEO }))
	else
		table.insert(t, p("Cyl", f, V3(0.12, 0.55, 0.55), V3(side * 0.56, 0, 0), nil, "c1", { m = MET, refl = 0.3 }))
		table.insert(t, p("Cyl", f, V3(0.06, 0.42, 0.42), V3(side * 0.62, 0, 0), nil, pp.iced and "c2" or "dial", { m = pp.iced and GLA or SMO, refl = 0.3, spark = pp.iced }))
	end
	return t
end
F.bracelet = function(pp)
	local f = pp.left and "LWrist" or "RWrist"
	local c = pp.iced and "c2" or "c1"
	local x = pp.iced and { m = GLA, refl = 0.45 } or { m = MET, refl = 0.3 }
	local t = ring(f, V3(0, 0.05, 0), 0.56, pp.n or 12, pp.beads and "Ball" or "Block", c, "Y", x, pp.beads and V3(0.16, 0.16, 0.16) or V3(0.14, 0.12, 0.34))
	if pp.iced then
		t[1].spark = true
	end
	if pp.both then
		local t2 = ring(pp.left and "RWrist" or "LWrist", V3(0, 0.05, 0), 0.56, pp.n or 12, pp.beads and "Ball" or "Block", c, "Y", x, pp.beads and V3(0.16, 0.16, 0.16) or V3(0.14, 0.12, 0.34))
		add(t, t2)
	end
	return t
end
F.rings = function(pp)
	local t = {}
	for i = 1, (pp.n or 2) do
		table.insert(t, cylY("RHand", 0.08, 0.32, V3(0.1 - i * 0.12, -0.3, -0.05), pp.iced and "c2" or "c1", pp.iced and { m = GLA, refl = 0.5, spark = (i == 1) } or { m = MET, refl = 0.35, fit = true }))
	end
	if pp.both then
		t = mirror(t)
	end
	for _, q in ipairs(t) do
		q.fit = true
	end
	return t
end
F.gloves = function(pp)
	local t = mirror({ cylY("RWrist", 0.3, 1.2, V3(0, 0.05, 0), "c1", { m = pp.leather and LEA or FAB }) })
	return t, { Hand = { c = "c1", m = pp.leather and LEA or FAB } }
end

------------------------------------------------------------------ back and waist (frames "back", "chest", "hips")
F.backpack = function(pp)
	local t = {
		p("Block", "back", V3(0.9, 1.05, 0.42), V3(0, -0.15, 0.24), nil, "c1", { m = FAB }),
		p("Block", "back", V3(0.8, 0.4, 0.15), V3(0, -0.4, 0.5), nil, "c2", { m = FAB }),
	}
	add(t, mirror({ p("Block", "chest", V3(0.1, 0.9, 0.04), V3(0.28, 0.3, -0.02), V3(-6, 0, 0), "c1", { m = FAB }) }))
	if pp.mini then
		for _, q in ipairs(t) do
			if q.f == "back" then
				q.s = q.s * 0.65
			end
		end
	end
	return t
end
F.duffel = function()
	-- a heist duffel slung across the back, strap across the chest
	local t = {
		p("Cyl", "back", V3(1.25, 0.6, 0.6), V3(0, -0.35, 0.36), V3(0, 0, 25), "c1", { m = FAB }),
		p("Block", "back", V3(1.1, 0.06, 0.04), V3(0, -0.12, 0.66), V3(0, 0, 25), "c2", { m = MET }),
		p("Block", "chest", V3(0.1, 1.5, 0.04), V3(0, 0.1, -0.03), V3(0, 0, 35), "c1", { m = FAB }),
	}
	return t
end
F.sling = function()
	return {
		p("Block", "chest", V3(0.1, 1.5, 0.04), V3(0, 0.1, -0.03), V3(0, 0, -38), "c1", { m = FAB }),
		p("Block", "chest", V3(0.5, 0.3, 0.16), V3(0.12, 0.1, -0.1), V3(0, 0, -38), "c1", { m = FAB }),
		p("Block", "chest", V3(0.46, 0.03, 0.02), V3(0.12, 0.13, -0.19), V3(0, 0, -38), "c2", { m = MET }),
	}
end
F.cape = function(pp)
	local l = pp.len or 2.6
	return {
		p("Block", "back", V3(1.35, l, 0.05), V3(0, 0.55 - l / 2, 0.14), V3(-6, 0, 0), "c1", { m = FAB }),
		p("Block", "back", V3(1.4, 0.15, 0.25), V3(0, 0.6, 0.06), nil, "c2", { m = FAB }),
	}
end
F.wings = function(pp)
	local t = {}
	for i = 1, 3 do
		add(t, mirror({ p("Wedge", "back", V3(0.06, 1.2 - i * 0.15, 0.9 + i * 0.2), V3(0.45 + i * 0.35, 0.25 - i * 0.15, 0.35), V3(0, -100, 25 + i * 10), i == 1 and "c2" or "c1", { m = pp.neon and NEO or FAB }) }))
	end
	return t
end
F.jetpack = function()
	local t = { p("Block", "back", V3(0.6, 0.8, 0.3), V3(0, -0.1, 0.25), nil, "c1", { m = MET, refl = 0.2 }) }
	add(t, mirror({
		cylY("back", 1.1, 0.42, V3(0.4, -0.1, 0.35), "c1", { m = MET, refl = 0.25 }),
		cylY("back", 0.15, 0.3, V3(0.4, -0.72, 0.35), "c2", { m = NEO }),
	}))
	return t
end
F.guitar = function()
	return {
		p("Ball", "back", V3(0.9, 1.1, 0.3), V3(0.1, -0.55, 0.3), V3(0, 0, 20), "c1", { m = SMO }),
		p("Block", "back", V3(0.14, 1.4, 0.12), V3(-0.2, 0.4, 0.3), V3(0, 0, 20), "c2", { m = SMO }),
	}
end
F.sword = function()
	return {
		p("Block", "back", V3(0.1, 2.0, 0.06), V3(0, -0.1, 0.25), V3(0, 0, 30), "c1", { m = LEA }),
		p("Block", "back", V3(0.08, 0.5, 0.08), V3(-0.53, 0.85, 0.25), V3(0, 0, 30), "c2", { m = FAB }),
		cylY("back", 0.04, 0.24, V3(-0.4, 0.62, 0.25), "gold", { m = MET }, 0),
	}
end
F.belt = function(pp)
	local t = ring("hips", V3(0, 0.25, 0), 0.62, 18, "Block", "c1", "Y", { m = LEA }, V3(0.05, 0.14, 0.24))
	for _, q in ipairs(t) do -- flatten the ring to the hips' oval
		local pos = q.lcf.Position
		q.lcf = CFrame.new(pos.X * 1.05, pos.Y, pos.Z * 0.7) * (q.lcf - pos)
	end
	table.insert(t, p("Block", "hips", V3(pp.big and 0.32 or 0.16, pp.big and 0.2 or 0.13, 0.04), V3(0, 0.25, -0.46), nil, "c2", { m = MET, refl = 0.35, spark = pp.iced }))
	return t
end
F.pocketbandana = function()
	return { p("Wedge", "hips", V3(0.03, 0.5, 0.3), V3(0.35, -0.2, 0.46), V3(180, 90, 0), "c1", { m = FAB }) }
end
F.beltbag = function()
	return {
		p("Block", "hips", V3(0.6, 0.3, 0.22), V3(0.15, 0.25, -0.55), nil, "c1", { m = FAB }),
		p("Block", "hips", V3(0.56, 0.03, 0.02), V3(0.15, 0.3, -0.67), nil, "c2", { m = MET }),
	}
end
F.utility = function()
	local t = F.belt({})
	for i = -2, 2 do
		table.insert(t, p("Block", "hips", V3(0.18, 0.2, 0.12), V3(i * 0.24, 0.18, -0.5 + math.abs(i) * 0.07), nil, "c1", { m = FAB }))
	end
	return t
end
F.walletchain = function()
	local pts = bezier(V3(0.35, 0.25, -0.45), V3(0.6, -0.35, -0.3), V3(0.6, 0.1, 0.25), 8)
	return along("hips", pts, "c1", "cuban", 0.05, { m = MET, refl = 0.3 })
end

------------------------------------------------------------------ tops (body + details on "chest"/"neck"/"back")
local SLEEVE = {
	tank = { Torso = "c1", UArm = "skin", LArm = "skin" },
	tee = { Torso = "c1", UArm = "c1", LArm = "skin" },
	long = { Torso = "c1", UArm = "c1", LArm = "c1" },
}
local function bodyOf(sleeve, m)
	local b = {}
	for k, v in pairs(SLEEVE[sleeve or "tee"]) do
		b[k] = (v == "skin") and "skin" or { c = v, m = m or FAB }
	end
	return b
end
local function collarRing(c, h, d)
	return cylY("neck", h or 0.07, d or 0.62, V3(0, -0.02, 0.06), c or "dark", { m = FAB })
end
local function textPlate(f, text, o, size, color, face, rot)
	return p("Block", f, size or V3(0.7, 0.34, 0.02), o, rot, "c1", { t = 1, txt = { text = text, color = color or "c2", face = face or "Front" } })
end

local function camo(n, seed)
	-- irregular blotches over the chest, back and sleeves (camo prints, splatter, tie-dye)
	local out = {}
	for i = 1, n do
		local k = (i * 7919 + (seed or 0) * 104729) % 1000
		local x = ((k % 10) - 4.5) * 0.11
		local y = (math.floor(k / 10) % 10 - 4.5) * 0.13
		local sz = 0.18 + (k % 7) * 0.035
		local key = (i % 3 == 0) and "dark" or "c2"
		table.insert(out, p("Ball", (i % 2 == 0) and "chest" or "back", V3(sz * 1.5, sz, 0.03), V3(x, y, (i % 2 == 0) and -0.035 or 0.035), V3(0, 0, (k % 90) - 45), key, { m = FAB }))
		if i % 4 == 0 then
			table.insert(out, p("Ball", (i % 8 == 0) and "RUpperArm" or "LUpperArm", V3(0.5, 0.35, 0.04), V3((i % 8 == 0) and 0.5 or -0.5, y * 0.4, 0), V3(0, 90, 0), key, { m = FAB, fit = true }))
		end
	end
	return out
end
B.camo = camo

F.tee = function(pp)
	local t = { collarRing("dark") }
	if pp.text then
		table.insert(t, textPlate("chest", pp.text, V3(0, 0.08, -0.04), V3(0.75, 0.38, 0.02), "c2"))
	end
	if pp.pocket then
		table.insert(t, p("Block", "chest", V3(0.2, 0.22, 0.02), V3(0.22, 0.32, -0.035), nil, "c2", { m = FAB }))
	end
	if pp.stripe then
		table.insert(t, p("Block", "chest", V3(1.05, 0.14, 0.02), V3(0, 0.15, -0.035), nil, "c2", { m = FAB }))
	end
	return t, bodyOf(pp.sleeve or "tee")
end
F.hoodie = function(pp)
	local t = {
		p("Ball", "neck", V3(1.0, 0.5, 0.6), V3(0, -0.02, 0.42), nil, "c1", { m = FAB }),
		p("Block", "chest", V3(0.8, 0.32, 0.03), V3(0, -0.5, -0.04), nil, "dark", { m = FAB }),
	}
	add(t, mirror({ cylY("chest", 0.45, 0.04, V3(0.12, 0.45, -0.05), "c2", { m = FAB }) }))
	if pp.zip then
		table.insert(t, p("Block", "chest", V3(0.04, 1.4, 0.03), V3(0, 0.05, -0.045), nil, "silver", { m = MET }))
	end
	if pp.text then
		table.insert(t, textPlate("chest", pp.text, V3(0, 0.1, -0.05), V3(0.75, 0.3, 0.02), "c2"))
	end
	if pp.camo then
		add(t, camo(pp.camo, 3))
	end
	if pp.puff then -- a big puff-print graphic across the chest
		table.insert(t, p("Block", "chest", V3(0.7, 0.5, 0.025), V3(0, 0.1, -0.045), nil, "c2", { m = FAB }))
		table.insert(t, p("Block", "chest", V3(0.5, 0.3, 0.03), V3(0, 0.1, -0.05), nil, "dark", { m = FAB }))
	end
	return t, bodyOf("long")
end
F.sweater = function(pp)
	local t = { collarRing("dark", 0.1, 0.64) }
	if pp.chunky then
		for i = -2, 2 do
			table.insert(t, p("Block", "chest", V3(0.06, 1.2, 0.03), V3(i * 0.2, 0.0, -0.04), nil, "dark", { m = FAB }))
		end
	end
	if pp.vneck then
		add(t, mirror({ p("Wedge", "chest", V3(0.02, 0.3, 0.16), V3(0.08, 0.6, -0.04), V3(180, -90, 0), "under", { m = FAB }) }))
	end
	if pp.qzip then -- quarter-zip: a stand collar and a short zip
		t[1] = cylY("neck", 0.22, 0.66, V3(0, 0.04, 0.06), "c1", { m = FAB })
		table.insert(t, p("Block", "chest", V3(0.035, 0.45, 0.03), V3(0, 0.55, -0.05), nil, "silver", { m = MET }))
	end
	if pp.turtle then
		t[1] = cylY("neck", 0.38, 0.64, V3(0, 0.12, 0.06), "c1", { m = FAB })
	end
	return t, bodyOf("long")
end
F.shirt = function(pp)
	local t = {
		p("Block", "chest", V3(0.1, 1.4, 0.025), V3(0, 0.05, -0.04), nil, pp.placket or "c1", { m = FAB }),
	}
	add(t, mirror({ p("Wedge", "neck", V3(0.03, 0.2, 0.18), V3(0.13, -0.08, -0.25), V3(150, -90, 0), "c2", { m = FAB }) }))
	for i = 0, 3 do
		table.insert(t, p("Ball", "chest", V3(0.04, 0.04, 0.02), V3(0, 0.55 - i * 0.35, -0.055), nil, "white", { m = SMO }))
	end
	if pp.open then -- open collar over a white undershirt
		table.insert(t, p("Wedge", "chest", V3(0.24, 0.3, 0.02), V3(0, 0.62, -0.05), V3(180, 0, 0), "white", { m = FAB }))
	end
	if pp.print then -- a few blooms on a resort / Hawaiian shirt
		for i = 1, 6 do
			table.insert(t, p("Ball", "chest", V3(0.12, 0.12, 0.02), V3(((i * 37) % 9 - 4) * 0.1, ((i * 53) % 7 - 3) * 0.17, -0.04), nil, "c2", { m = FAB }))
		end
	end
	return t, bodyOf(pp.sleeve or "long")
end
F.polo = function(pp)
	local t = {
		p("Block", "chest", V3(0.12, 0.35, 0.025), V3(0, 0.6, -0.04), nil, "c1", { m = FAB }),
	}
	add(t, mirror({ p("Wedge", "neck", V3(0.03, 0.18, 0.18), V3(0.13, -0.08, -0.25), V3(150, -90, 0), "c2", { m = FAB }) }))
	return t, bodyOf("tee")
end
F.jersey = function(pp)
	local t = {
		textPlate("chest", pp.num or "23", V3(0, 0.05, -0.04), V3(0.6, 0.55, 0.02), "c2"),
		textPlate("back", pp.num or "23", V3(0, 0.05, 0.04), V3(0.6, 0.55, 0.02), "c2", "Back"),
		collarRing("c2", 0.06, 0.66),
	}
	if pp.sleeve == "long" then -- hockey stripes
		add(t, mirror({ cylY("RLowerArm", 0.18, 1.12, V3(0, -0.1, 0), "c2", { m = FAB }) }))
	end
	return t, bodyOf(pp.sleeve or "tank")
end
F.croptop = function(pp)
	local t = { collarRing("c1", 0.05, 0.6) }
	if pp.bow then
		add(t, mirror({ p("Wedge", "chest", V3(0.03, 0.1, 0.14), V3(0.07, 0.62, -0.06), V3(0, -90, 0), "c2", { m = SMO }) }))
	end
	return t, { Torso = { c = "c1", m = FAB }, UArm = pp.sleeve and { c = "c1", m = FAB } or "skin", LArm = "skin" }
end
F.corset = function()
	local t = {}
	for i = 0, 4 do
		table.insert(t, p("Block", "chest", V3(0.24, 0.02, 0.02), V3(0, 0.2 - i * 0.16, -0.045), V3(0, 0, (i % 2 == 0) and 25 or -25), "c2", { m = FAB }))
	end
	add(t, mirror({ p("Block", "chest", V3(0.05, 0.4, 0.04), V3(0.32, 0.88, 0.0), nil, "c1", { m = FAB }) }))
	return t, { Torso = { c = "c1", m = FAB }, UArm = { c = "c1", m = FAB }, LArm = "skin" }
end
F.vest = function(pp)
	-- a tactical vest / plate carrier over whatever top is worn (keeps the top's sleeves)
	local t = {
		p("Block", "chest", V3(1.0, 1.05, 0.2), V3(0, 0.05, -0.04), nil, "c1", { m = FAB }),
		p("Block", "back", V3(1.0, 1.05, 0.2), V3(0, 0.05, 0.04), nil, "c1", { m = FAB }),
	}
	add(t, mirror({ p("Block", "neck", V3(0.18, 0.12, 1.05), V3(0.3, -0.06, 0.06), nil, "c1", { m = FAB }) }))
	for i = -1, 1 do
		table.insert(t, p("Block", "chest", V3(0.24, 0.3, 0.14), V3(i * 0.28, -0.3, -0.18), nil, "dark", { m = FAB }))
	end
	if pp.text then
		table.insert(t, textPlate("back", pp.text, V3(0, 0.25, 0.15), V3(0.8, 0.22, 0.02), "c2", "Back"))
		table.insert(t, textPlate("chest", pp.text, V3(0, 0.3, -0.15), V3(0.5, 0.14, 0.02), "c2"))
	end
	if pp.suit then -- a suit waistcoat instead (no pouches, buttons)
		t = {
			p("Block", "chest", V3(0.95, 0.95, 0.06), V3(0, 0.0, -0.035), nil, "c1", { m = FAB }),
			p("Wedge", "chest", V3(0.3, 0.4, 0.02), V3(0, 0.55, -0.07), V3(180, 0, 0), "under", { m = FAB }),
		}
		for i = 0, 3 do
			table.insert(t, p("Ball", "chest", V3(0.04, 0.04, 0.02), V3(0, 0.3 - i * 0.2, -0.075), nil, "c2", { m = MET }))
		end
	end
	return t
end
F.overalls = function()
	local t = {
		p("Block", "chest", V3(0.6, 0.6, 0.04), V3(0, -0.15, -0.04), nil, "c1", { m = FAB }),
	}
	add(t, mirror({
		p("Block", "chest", V3(0.08, 0.7, 0.04), V3(0.24, 0.45, -0.04), nil, "c1", { m = FAB }),
		p("Ball", "chest", V3(0.06, 0.06, 0.03), V3(0.24, 0.16, -0.07), nil, "brass", { m = MET }),
		p("Block", "back", V3(0.08, 1.0, 0.04), V3(0.18, 0.1, 0.04), V3(0, 0, 10), "c1", { m = FAB }),
	}))
	return t, { Hips = { c = "c1", m = FAB }, ULeg = { c = "c1", m = FAB }, LLeg = { c = "c1", m = FAB } }
end
F.jumpsuit = function(pp)
	-- coveralls, prison orange, flight suits, scrubs, spacesuits: one colour head to toe (but the hands and head)
	local m = pp.m == "leather" and LEA or (pp.m == "smooth" and SMO or FAB)
	local t = { p("Block", "chest", V3(0.04, 1.4, 0.025), V3(0, -0.05, -0.045), nil, pp.zip or "c2", { m = MET }) }
	add(t, mirror({ p("Wedge", "neck", V3(0.03, 0.18, 0.2), V3(0.14, -0.08, -0.25), V3(150, -90, 0), "c1", { m = m }) }))
	if pp.text then
		table.insert(t, textPlate("back", pp.text, V3(0, 0.25, 0.05), V3(0.9, 0.25, 0.02), "c2", "Back"))
	end
	if pp.patches then
		add(t, mirror({ p("Block", "LUpperArm", V3(0.5, 0.4, 0.04), V3(-0.52, 0.1, 0), V3(0, 90, 0), "c2", { m = FAB }) }))
	end
	if pp.space then -- life-support pack, collar ring, hose
		table.insert(t, p("Block", "back", V3(0.95, 1.1, 0.45), V3(0, -0.05, 0.25), nil, "c1", { m = SMO }))
		table.insert(t, cylY("neck", 0.2, 0.95, V3(0, -0.02, 0.06), "c2", { m = MET }))
		table.insert(t, p("Block", "chest", V3(0.5, 0.35, 0.12), V3(0, -0.25, -0.1), nil, "c2", { m = SMO }))
	end
	local b = { Torso = { c = "c1", m = m }, UArm = { c = "c1", m = m }, LArm = { c = "c1", m = m }, Hips = { c = "c1", m = m },
		ULeg = { c = "c1", m = m }, LLeg = { c = "c1", m = m } }
	if pp.shortSleeve then
		b.LArm = "skin"
	end
	return t, b
end
F.armor = function(pp)
	-- bronze cuirass (ancient Greek / Mediterranean epic), knight plate or sci-fi trooper armour
	local mm = pp.scifi and SMO or MET
	local t = {
		p("Block", "chest", V3(1.05, 1.1, 0.18), V3(0, 0.0, -0.04), nil, "c1", { m = mm, refl = pp.scifi and 0.05 or 0.2 }),
		p("Block", "back", V3(1.05, 1.1, 0.18), V3(0, 0.0, 0.04), nil, "c1", { m = mm, refl = pp.scifi and 0.05 or 0.2 }),
	}
	add(t, mirror({ p("Ball", "RUpperArm", V3(1.5, 0.9, 1.5), V3(0, 0.3, 0), nil, "c1", { m = mm, refl = 0.2 }) }))
	if pp.skirt then -- pteruges: leather strips round the hips
		for i = 0, 9 do
			local a = i / 10 * math.pi * 2
			table.insert(t, p("Block", "hips", V3(0.2, 0.75, 0.05), V3(math.sin(a) * 0.6, -0.3, math.cos(a) * 0.42), V3(0, math.deg(a), 0), "c2", { m = LEA }))
		end
	end
	if pp.scifi then
		table.insert(t, p("Block", "chest", V3(0.5, 0.05, 0.02), V3(0, 0.3, -0.14), nil, "neon", { m = NEO }))
		add(t, mirror({ p("Block", "RLowerLeg", V3(1.2, 0.8, 1.2), V3(0, 0.1, 0), nil, "c1", { m = SMO }) }))
	end
	return t, { UArm = { c = pp.under or "c2", m = FAB }, LArm = { c = "c2", m = FAB } }
end
F.robe = function(pp)
	local l = pp.len or 2.4
	local t = {}
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		table.insert(t, p("Block", "hips", V3(0.36, l, 0.05), V3(math.sin(a) * 0.62, 0.1 - l / 2, math.cos(a) * 0.48), V3(math.cos(a) * -6, math.deg(a), 0), "c1", { m = FAB }))
	end
	if pp.belt then
		table.insert(t, cylY("hips", 0.12, 1.28, V3(0, 0.2, 0), "c2", { m = FAB }))
	end
	if pp.hood then
		table.insert(t, p("Ball", "neck", V3(1.1, 0.55, 0.7), V3(0, -0.02, 0.42), nil, "c1", { m = FAB }))
	end
	return t, { Torso = { c = "c1", m = FAB }, UArm = { c = "c1", m = FAB }, LArm = { c = "c1", m = FAB }, Hips = { c = "c1", m = FAB } }
end
F.dress = function(pp)
	local l = pp.len or 1.4
	local t = {}
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local flare = pp.flare or 10
		table.insert(t, p("Block", "hips", V3(0.36, l, 0.04), V3(math.sin(a) * 0.62, 0.1 - l / 2, math.cos(a) * 0.48), V3(-flare * math.cos(0), math.deg(a), 0), "c1", { m = pp.sequin and Enum.Material.Foil or FAB, refl = pp.sequin and 0.2 or 0 }))
	end
	return t, { Torso = { c = "c1", m = pp.sequin and Enum.Material.Foil or FAB }, UArm = pp.sleeve and { c = "c1", m = FAB } or "skin", LArm = "skin",
		Hips = { c = "c1", m = FAB }, ULeg = "skin", LLeg = "skin" }
end

------------------------------------------------------------------ outerwear (over the top)
local function lapels(c, deep)
	return mirror({ p("Wedge", "chest", V3(0.03, deep or 0.65, 0.22), V3(0.11, 0.42, -0.06), V3(180, -90, 0), c, { m = FAB }) })
end
local function openFront(w, c)
	return p("Block", "chest", V3(w or 0.3, 1.25, 0.02), V3(0, 0.05, -0.04), nil, c or "under", { m = FAB })
end
F.blazer = function(pp)
	local t = { openFront(0.28, "under") }
	add(t, lapels(pp.satin and "c2" or "dark", 0.7))
	for i = 0, (pp.double and 3 or 1) do
		local col = pp.double and ((i % 2 == 0) and -0.12 or 0.12) or 0.17
		table.insert(t, p("Ball", "chest", V3(0.05, 0.05, 0.02), V3(col, -0.15 - math.floor(i / (pp.double and 2 or 1)) * 0.25, -0.05), nil, pp.brass and "brass" or "dark", { m = pp.brass and MET or SMO }))
	end
	table.insert(t, p("Block", "chest", V3(0.16, 0.07, 0.02), V3(0.3, 0.45, -0.045), nil, "c2", { m = FAB })) -- pocket square
	return t, { Torso = { c = "c1", m = FAB }, UArm = { c = "c1", m = FAB }, LArm = { c = "c1", m = FAB } }
end
F.jacket = function(pp)
	-- denim, bomber, moto, field, track, racing, varsity, windbreaker, flannel, suede: one family with options
	local m = (pp.m == "leather" and LEA) or (pp.m == "smooth" and SMO) or FAB
	local t = {}
	if pp.open ~= false then
		table.insert(t, openFront(pp.openW or 0.26, "under"))
	end
	if pp.collar == "lapel" then
		add(t, lapels(pp.collarC or "dark", 0.45))
	elseif pp.collar == "rib" then
		table.insert(t, cylY("neck", 0.14, 0.68, V3(0, -0.01, 0.06), pp.collarC or "c2", { m = FAB }))
	elseif pp.collar == "funnel" then
		table.insert(t, cylY("neck", 0.4, 0.74, V3(0, 0.1, 0.06), "c1", { m = m }))
	elseif pp.collar == "fur" then
		for i = 0, 7 do
			local a = rad(-110 + i * 31)
			table.insert(t, p("Ball", "neck", V3(0.32, 0.3, 0.32), V3(math.sin(a) * 0.36, -0.04, -math.cos(a) * 0.34 + 0.06), nil, pp.collarC or "c2", { m = FAB }))
		end
	elseif pp.collar == "stand" then
		table.insert(t, cylY("neck", 0.2, 0.7, V3(0, 0.02, 0.06), pp.collarC or "c1", { m = m }))
	elseif pp.collar == "hood" then
		table.insert(t, p("Ball", "neck", V3(1.0, 0.5, 0.6), V3(0, -0.02, 0.42), nil, "c1", { m = m }))
	end
	if pp.zip then
		local zx = pp.zip == "diag" and 0.12 or 0
		table.insert(t, p("Block", "chest", V3(0.035, 1.3, 0.03), V3(zx, 0.0, -0.05), V3(0, 0, pp.zip == "diag" and -12 or 0), "silver", { m = MET }))
	end
	if pp.cuffs then
		add(t, mirror({ cylY("RLowerArm", 0.16, 1.12, V3(0, -0.42, 0), pp.cuffC or "c2", { m = FAB }) }))
	end
	if pp.stripes then -- stripes down the sleeves
		add(t, mirror({
			p("Block", "RUpperArm", V3(0.08, 1.0, 0.1), V3(0.52, 0, 0), nil, "c2", { m = FAB, fit = true }),
			p("Block", "RLowerArm", V3(0.08, 1.0, 0.1), V3(0.52, 0, 0), nil, "c2", { m = FAB, fit = true }),
		}))
	end
	if pp.pockets then
		add(t, mirror({ p("Block", "chest", V3(0.24, 0.22, 0.03), V3(0.25, 0.3, -0.05), nil, "dark", { m = m }) }))
	end
	if pp.puffer then
		for i = 0, 3 do
			table.insert(t, p("Block", "chest", V3(1.05, 0.08, 0.06), V3(0, 0.55 - i * 0.35, -0.04), nil, "dark", { m = SMO }))
			table.insert(t, p("Block", "back", V3(1.05, 0.08, 0.06), V3(0, 0.55 - i * 0.35, 0.04), nil, "dark", { m = SMO }))
		end
		table.insert(t, p("Block", "chest", V3(1.12, 1.4, 0.16), V3(0, 0, -0.02), nil, "c1", { m = SMO }))
		table.insert(t, p("Block", "back", V3(1.12, 1.4, 0.16), V3(0, 0, 0.02), nil, "c1", { m = SMO }))
		add(t, mirror({ p("Ball", "RUpperArm", V3(1.35, 1.0, 1.35), V3(0, 0, 0), nil, "c1", { m = SMO }) }))
		m = SMO
	end
	if pp.fur then -- a full statement fur coat
		for i = 0, 5 do
			add(t, mirror({ p("Ball", "chest", V3(0.36, 0.4, 0.2), V3(0.3 + (i % 2) * 0.1, 0.5 - i * 0.22, -0.08), nil, "c1", { m = FAB }) }))
		end
		add(t, mirror({ cylY("RLowerArm", 0.4, 1.35, V3(0, -0.38, 0), "c1", { m = FAB }) }))
	end
	if pp.letter then
		table.insert(t, textPlate("chest", pp.letter, V3(0.27, 0.32, -0.06), V3(0.3, 0.3, 0.02), "c2"))
	end
	if pp.camo then
		add(t, camo(pp.camo, 5))
	end
	if pp.back then
		table.insert(t, textPlate("back", pp.back, V3(0, 0.25, 0.05), V3(0.95, 0.28, 0.02), "c2", "Back"))
	end
	if pp.epaulettes then
		add(t, mirror({ p("Block", "neck", V3(0.28, 0.06, 0.36), V3(0.45, -0.1, 0.06), nil, "brass", { m = MET }) }))
	end
	if pp.neon then -- cyber trim
		add(t, mirror({ p("Block", "chest", V3(0.03, 1.2, 0.02), V3(0.16, 0.0, -0.055), nil, "neon", { m = NEO }) }))
		add(t, mirror({ cylY("RLowerArm", 0.06, 1.12, V3(0, -0.3, 0), "neon", { m = NEO }) }))
	end
	if pp.long then -- coat skirt down to mid-thigh / knee
		local l = pp.long
		for i = 0, 9 do
			local a = i / 10 * math.pi * 2
			if math.abs(math.sin(a)) > 0.2 or math.cos(a) > 0 then -- open at the front
				table.insert(t, p("Block", "hips", V3(0.4, l, 0.05), V3(math.sin(a) * 0.62, 0.0 - l / 2, math.cos(a) * 0.48), V3(math.cos(a) * -5, math.deg(a), 0), "c1", { m = m }))
			end
		end
		if pp.belted then
			table.insert(t, cylY("hips", 0.12, 1.3, V3(0, 0.32, 0), "c1", { m = m }))
		end
	end
	local b = { Torso = { c = "c1", m = m }, UArm = { c = pp.sleeveC or "c1", m = pp.sleeveM == "leather" and LEA or m },
		LArm = { c = pp.sleeveC or "c1", m = pp.sleeveM == "leather" and LEA or m } }
	if pp.vest then -- sleeveless (puffer vest, denim vest): keep the top's arms
		b.UArm, b.LArm = nil, nil
		for i = #t, 1, -1 do
			if t[i].f == "RUpperArm" or t[i].f == "LUpperArm" or t[i].f == "RLowerArm" or t[i].f == "LLowerArm" then
				table.remove(t, i)
			end
		end
	end
	return t, b
end
F.labcoat = function(pp)
	return F.jacket({ open = true, collar = "lapel", collarC = "c1", long = pp.long or 1.3, pockets = true, back = pp.back })
end

------------------------------------------------------------------ bottoms (body: Hips ULeg LLeg)
F.pants = function(pp)
	local m = pp.m == "leather" and LEA or FAB
	local t = {}
	if pp.stack then -- baggy jeans stacking over the shoes
		add(t, mirror({ p("Ball", "RAnkle", V3(1.45, 0.75, 1.45), V3(0, 0.25, 0), nil, "c1", { m = m }) }))
	end
	if pp.cuff then -- joggers' ribbed cuff
		add(t, mirror({ cylY("RAnkle", 0.3, 1.1, V3(0, 0.2, 0), "dark", { m = FAB }) }))
	end
	if pp.cargo then
		add(t, mirror({ p("Block", "RUpperLeg", V3(0.12, 0.3, 0.4), V3(0.55, -0.1, 0), nil, "c1", { m = m, fit = true }) }))
	end
	if pp.rips then
		add(t, mirror({ p("Block", "RLowerLeg", V3(1.02, 0.12, 0.5), V3(0, 0.38, -0.25), nil, "skin", { fit = true }) }))
	end
	if pp.stripe then -- track pants side stripes
		add(t, mirror({
			p("Block", "RUpperLeg", V3(0.06, 1.0, 0.16), V3(0.51, 0, 0), nil, "c2", { m = FAB, fit = true }),
			p("Block", "RLowerLeg", V3(0.06, 1.0, 0.16), V3(0.51, 0, 0), nil, "c2", { m = FAB, fit = true }),
		}))
	end
	if pp.wide then -- barrel / wide-leg: volume round the knee and shin
		add(t, mirror({ p("Ball", "RLowerLeg", V3(1.35, 1.1, 1.35), V3(0, 0.15, 0), nil, "c1", { m = m, fit = true }) }))
	end
	if pp.crease then
		add(t, mirror({ p("Block", "RLowerLeg", V3(0.02, 1.0, 0.02), V3(0, 0, -0.5), nil, "dark", { m = FAB, fit = true }) }))
	end
	return t, { Hips = { c = "c1", m = m }, ULeg = { c = "c1", m = m }, LLeg = { c = "c1", m = m } }
end
F.shorts = function(pp)
	local t = {}
	if pp.long then -- long basketball shorts / jorts past the knee
		add(t, mirror({ cylY("RLowerLeg", 0.35, 1.2, V3(0, 0.3, 0), "c1", { m = FAB, fit = true }) }))
	end
	if pp.stripe then
		add(t, mirror({ p("Block", "RUpperLeg", V3(0.06, 1.0, 0.16), V3(0.51, 0, 0), nil, "c2", { m = FAB, fit = true }) }))
	end
	if pp.socks then -- long shorts with tall white socks pulled up to the knee
		return t, { Hips = { c = "c1", m = FAB }, ULeg = { c = "c1", m = FAB }, LLeg = { c = "c2", m = FAB } }
	end
	return t, { Hips = { c = "c1", m = FAB }, ULeg = { c = "c1", m = FAB }, LLeg = "skin" }
end
F.skirt = function(pp)
	local l = pp.len or 0.9
	local t = {}
	local n = pp.pleats and 16 or 12
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		table.insert(t, p("Block", "hips", V3(0.3, l, 0.04), V3(math.sin(a) * 0.62, 0.15 - l / 2, math.cos(a) * 0.46), V3(-(pp.flare or 8), math.deg(a), 0), (pp.pleats and i % 2 == 0) and "dark" or "c1", { m = FAB }))
	end
	local b = { Hips = { c = "c1", m = FAB }, ULeg = "skin", LLeg = "skin" }
	if pp.tights then
		b.ULeg, b.LLeg = { c = "c2", m = FAB }, { c = "c2", m = FAB }
	end
	return t, b
end
F.leggings = function()
	return {}, { Hips = { c = "c1", m = SMO }, ULeg = { c = "c1", m = SMO }, LLeg = { c = "c1", m = SMO } }
end

------------------------------------------------------------------ shoes (frames LFoot/RFoot with fit, LAnkle/RAnkle)
F.shoes = function(pp)
	local h = pp.sole or 0.16
	local m = pp.m == "leather" and LEA or (pp.m == "rubber" and RUB or FAB)
	local t = {
		p("Block", "RFoot", V3(1.0, h, 1.02), V3(0, -0.5 - h / 2 + 0.06, 0), nil, pp.gum and "gum" or pp.soleC or "c2", { m = RUB, fit = true }),
	}
	if pp.panel then
		table.insert(t, p("Block", "RFoot", V3(0.06, 0.35, 0.6), V3(0.52, -0.1, 0.05), nil, "c2", { m = m, fit = true }))
	end
	if pp.high then
		table.insert(t, cylY("RAnkle", 0.55, 1.18, V3(0, 0.15, 0), "c1", { m = m }))
	end
	if pp.boot then
		table.insert(t, cylY("RAnkle", pp.boot, 1.22, V3(0, pp.boot / 2 - 0.1, 0), "c1", { m = m }))
		table.insert(t, cylY("RAnkle", 0.1, 1.28, V3(0, pp.boot - 0.1, 0), pp.collarC or "dark", { m = m }))
	end
	if pp.heel then
		table.insert(t, p("Block", "RFoot", V3(0.2, pp.heel, 0.2), V3(0, -0.5 - pp.heel / 2, 0.38), nil, "c2", { m = SMO, fit = true }))
	end
	if pp.wedge then
		table.insert(t, p("Wedge", "RFoot", V3(0.9, 0.45, 0.9), V3(0, -0.6, 0.05), V3(0, 180, 0), "c2", { m = FAB, fit = true }))
	end
	if pp.laces then
		table.insert(t, p("Block", "RFoot", V3(0.3, 0.05, 0.4), V3(0, 0.45, -0.15), nil, "white", { m = FAB, fit = true }))
	end
	local foot = { c = "c1", m = m }
	if pp.slides then -- slides over socks
		t = {
			p("Block", "RFoot", V3(1.08, 0.18, 1.06), V3(0, -0.56, 0), nil, "c1", { m = RUB, fit = true }),
			p("Block", "RFoot", V3(1.1, 0.35, 0.45), V3(0, 0.0, -0.15), nil, "c1", { m = RUB, fit = true }),
		}
		foot = { c = "c2", m = FAB }
	elseif pp.sandal then
		t = {
			p("Block", "RFoot", V3(1.06, 0.12, 1.04), V3(0, -0.56, 0), nil, "c1", { m = LEA, fit = true }),
			p("Block", "RFoot", V3(1.1, 0.12, 0.2), V3(0, 0.1, -0.2), nil, "c1", { m = LEA, fit = true }),
		}
		foot = "skin"
	end
	return mirror(t), { Foot = foot }
end

------------------------------------------------------------------ tattoos (ink that only shows on bare skin)
-- q.skin = the body region the ink sits on; Apply drops the piece if that region is covered by clothes
local function ink(f, region, s, o, r, x)
	local t = x or {}
	t.skin, t.fit, t.m = region, true, SMO
	t.t = t.t or 0.15
	return p("Ball", f, s, o, r, "c1", t)
end
local function inkText(f, region, text, o, size, rot, face, fit)
	return p("Block", f, size, o, rot, "c1", { fit = fit ~= false, t = 1, skin = region,
		txt = { text = text, color = "c1", face = face or "Right", font = "Fantasy" } })
end
local function armSleeve(side, limbs, n, seed)
	-- black-and-grey sleeve: a soft grey wash that fades out at the ends, then flowing linework and a few
	-- solid motifs laid flat on the skin (each piece faces out from the limb)
	local t = {}
	for li, pr in ipairs(limbs) do
		local f, region = side .. pr[1], pr[2]
		table.insert(t, ink(f, region, V3(1.06, 0.94, 1.06), V3(0, 0, 0), nil, { t = 0.68 }))
		for i = 1, n do
			local k = (i * 7919 + seed * 131 + li * 17) % 211
			local ang = (k % 16) / 16 * math.pi * 2 + li
			local y = ((k % 11) - 5) * 0.075
			local solid = (i % 4 == 0)
			local s = solid and V3(0.05, 0.16 + (k % 3) * 0.04, 0.2 + (k % 2) * 0.08) or V3(0.04, 0.24 + (k % 4) * 0.05, 0.05)
			local lcf = CFrame.new(math.cos(ang) * 0.52, y, math.sin(ang) * 0.52) * CFrame.Angles(0, -ang, 0)
				* CFrame.Angles(math.rad((k % 70) - 35), 0, 0)
			table.insert(t, ink(f, region, s, nil, nil, { lcf = lcf, t = solid and 0.12 or 0.05 }))
		end
	end
	return t
end
F.tattoo = function(pp)
	local t = {}
	local kind = pp.kind
	local sides = pp.both and { "R", "L" } or { "R" }
	for si, side in ipairs(sides) do
		local sx = side == "R" and 1 or -1
		local face = side == "R" and "Right" or "Left"
		if kind == "sleeve" then
			add(t, armSleeve(side, { { "UpperArm", "UArm" }, { "LowerArm", "LArm" } }, 22, si))
		elseif kind == "half" then
			add(t, armSleeve(side, { { "LowerArm", "LArm" } }, 18, si + 2))
		elseif kind == "forearm" then
			table.insert(t, inkText(side .. "LowerArm", "LArm", (si == 2 and pp.text2) or pp.text or "FAMILIA", V3(0, -0.08, -0.37), V3(1.14, 0.24, 0.02), V3(0, 0, 90), "Front"))
		elseif kind == "rose" then -- a rose with leaves on the forearm
			table.insert(t, ink(side .. "LowerArm", "LArm", V3(0.1, 0.22, 0.4), V3(sx * 0.47, 0.1, 0), V3(0, 0, 0), { t = 0.05 }))
			table.insert(t, ink(side .. "LowerArm", "LArm", V3(0.1, 0.3, 0.12), V3(sx * 0.48, -0.12, 0.08), V3(30, 0, 0), { t = 0.2 }))
			table.insert(t, ink(side .. "LowerArm", "LArm", V3(0.1, 0.3, 0.12), V3(sx * 0.48, -0.12, -0.08), V3(-30, 0, 0), { t = 0.2 }))
		elseif kind == "calf" then
			add(t, armSleeve(side, { { "LowerLeg", "LLeg" } }, 16, si + 5))
		elseif kind == "hands" then
			table.insert(t, inkText(side .. "Hand", "Hand", (si == 2 and pp.text2) or pp.text or "LOVE", V3(0, 0.05, 0.51), V3(0.8, 0.35, 0.02), V3(0, 0, 0), "Back"))
		end
	end
	if kind == "neck" then
		table.insert(t, inkText("neck", "Head", pp.text or "FAMILIA", V3(0, 0.1, -0.31), V3(0.6, 0.2, 0.02), V3(-6, 0, 0), "Front", false))
	elseif kind == "face" then
		local ex = FACE.eyeX + 0.06
		local mark = pp.mark or "star"
		if mark == "star" then
			table.insert(t, p("Block", "head", V3(0.1, 0.1, 0.02), V3(ex, FACE.eyeY - 0.3, -0.93), V3(0, 0, 45), "c1", { m = SMO, skin = "Head" }))
			table.insert(t, p("Block", "head", V3(0.1, 0.1, 0.02), V3(ex, FACE.eyeY - 0.3, -0.931), nil, "c1", { m = SMO, skin = "Head" }))
		elseif mark == "cross" then
			table.insert(t, p("Block", "head", V3(0.03, 0.14, 0.02), V3(ex, FACE.eyeY - 0.3, -0.93), nil, "c1", { m = SMO, skin = "Head" }))
			table.insert(t, p("Block", "head", V3(0.09, 0.03, 0.02), V3(ex, FACE.eyeY - 0.27, -0.931), nil, "c1", { m = SMO, skin = "Head" }))
		elseif mark == "dots" then
			for i = 0, 2 do
				table.insert(t, p("Ball", "head", V3(0.04, 0.04, 0.02), V3(ex + i * 0.06, FACE.eyeY - 0.28, -0.93), nil, "c1", { m = SMO, skin = "Head" }))
			end
		elseif mark == "script" then -- a small word over the eyebrow
			table.insert(t, p("Block", "head", V3(0.42, 0.1, 0.02), V3(ex, FACE.browY + 0.1, -0.95), V3(-15, 0, 0), "c1", { t = 1, skin = "Head",
				txt = { text = pp.text or "BLESSED", color = "c1", face = "Front", font = "Fantasy" } }))
		end
	end
	return t
end

------------------------------------------------------------------ lowrider pieces
F.suspenders = function()
	local t = mirror({
		p("Block", "chest", V3(0.07, 1.25, 0.03), V3(0.24, 0.05, -0.05), V3(0, 0, 3), "c1", { m = FAB }),
		p("Block", "back", V3(0.07, 1.25, 0.03), V3(0.16, 0.05, 0.05), V3(0, 0, -12), "c1", { m = FAB }),
		p("Block", "chest", V3(0.09, 0.06, 0.04), V3(0.24, -0.55, -0.06), nil, "c2", { m = MET }),
	})
	return t
end
F.hairnet = function()
	return { p("Ball", "head", V3(2.16, 1.5, 2.26), V3(0, 0.44, 0.12), nil, "c1", { m = FAB, t = 0.55 }) }
end
F.foldedband = function()
	-- a bandana folded flat and tied low across the forehead, knot at the back
	local t = {
		cylY("head", 0.26, 2.14, V3(0, 0.38, 0.06), "c1", { m = FAB }, -10),
		p("Ball", "head", V3(0.3, 0.26, 0.26), V3(0, 0.25, 1.1), nil, "c1", { m = FAB }),
	}
	add(t, mirror({ p("Wedge", "head", V3(0.04, 0.45, 0.22), V3(0.12, -0.05, 1.14), V3(0, 90, 12), "c1", { m = FAB }) }))
	return t
end

---------------------------------------------------------------------------------------------------- frames
local function attWorld(part, name)
	local a = part and part:FindFirstChild(name)
	if a and a:IsA("Attachment") then
		return a.WorldPosition
	end
	return nil
end

function B.frames(char)
	local fr = {}
	local head = char:FindFirstChild("Head")
	if head then
		local rot = head.CFrame - head.CFrame.Position
		local c = attWorld(head, "FaceCenterAttachment") or head.Position
		local f = attWorld(head, "FaceFrontAttachment")
		local R = f and (f - c).Magnitude or head.Size.X * 0.5
		R = math.clamp(R, head.Size.X * 0.3, head.Size.X * 0.75)
		fr.head = { part = head, cf = CFrame.new(c) * rot, u = R }
	end
	local ut = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if ut then
		local rot = ut.CFrame - ut.CFrame.Position
		local n = attWorld(ut, "NeckAttachment") or (ut.CFrame * CFrame.new(0, ut.Size.Y / 2, 0)).Position
		local bf = attWorld(ut, "BodyFrontAttachment") or (ut.CFrame * CFrame.new(0, 0, -ut.Size.Z / 2)).Position
		local bb = attWorld(ut, "BodyBackAttachment") or (ut.CFrame * CFrame.new(0, 0, ut.Size.Z / 2)).Position
		local u = (bf - n).Magnitude
		fr.neck = { part = ut, cf = CFrame.new(n) * rot, u = u }
		fr.chest = { part = ut, cf = CFrame.new(bf) * rot, u = u }
		fr.back = { part = ut, cf = CFrame.new(bb) * rot, u = u }
	end
	local lt = char:FindFirstChild("LowerTorso")
	if lt and fr.neck then
		local rot = lt.CFrame - lt.CFrame.Position
		local w = attWorld(lt, "WaistCenterAttachment") or lt.Position
		fr.hips = { part = lt, cf = CFrame.new(w) * rot, u = fr.neck.u }
	end
	for _, side in ipairs({ "Left", "Right" }) do
		local s = side:sub(1, 1)
		for _, limb in ipairs({ "UpperArm", "LowerArm", "Hand", "UpperLeg", "LowerLeg", "Foot" }) do
			local part = char:FindFirstChild(side .. limb)
			if part then
				fr[s .. limb] = { part = part, cf = part.CFrame, u = math.min(part.Size.X, part.Size.Z), size = part.Size }
			end
		end
		local la = char:FindFirstChild(side .. "LowerArm")
		if la then
			local w = attWorld(la, side .. "WristRigAttachment")
			local cf = w and (CFrame.new(w) * (la.CFrame - la.CFrame.Position)) or (la.CFrame * CFrame.new(0, -la.Size.Y * 0.42, 0))
			fr[s .. "Wrist"] = { part = la, cf = cf, u = math.min(la.Size.X, la.Size.Z) }
		end
		local ll = char:FindFirstChild(side .. "LowerLeg")
		if ll then
			local a = attWorld(ll, side .. "AnkleRigAttachment")
			local cf = a and (CFrame.new(a) * (ll.CFrame - ll.CFrame.Position)) or (ll.CFrame * CFrame.new(0, -ll.Size.Y * 0.45, 0))
			fr[s .. "Ankle"] = { part = ll, cf = cf, u = math.min(ll.Size.X, ll.Size.Z) }
		end
	end
	return fr
end

---------------------------------------------------------------------------------------------------- build
local REGION_PARTS = {
	Head = { "Head" },
	Torso = { "UpperTorso", "Torso" },
	Hips = { "LowerTorso" },
	UArm = { "LeftUpperArm", "RightUpperArm" },
	LArm = { "LeftLowerArm", "RightLowerArm" },
	Hand = { "LeftHand", "RightHand" },
	ULeg = { "LeftUpperLeg", "RightUpperLeg" },
	LLeg = { "LeftLowerLeg", "RightLowerLeg" },
	Foot = { "LeftFoot", "RightFoot" },
}
B.REGION_PARTS = REGION_PARTS

local function colourFor(key, ctx)
	if typeof(key) == "Color3" then
		return key
	end
	if key == "c1" then
		return ctx.c1
	elseif key == "c2" then
		return ctx.c2
	elseif key == "skin" then
		return ctx.skin
	elseif key == "under" then
		return ctx.under or ctx.c1
	elseif key == "dark" then
		return mix(ctx.c1, Color3.new(0, 0, 0), 0.35)
	elseif key == "light" then
		return mix(ctx.c1, Color3.new(1, 1, 1), 0.3)
	elseif key == "fade" then
		return mix(ctx.c1, ctx.skin, 0.55)
	elseif key == "dial" then
		return mix(ctx.c1, Color3.new(0, 0, 0), 0.7)
	elseif key == "hair" then
		return ctx.hair or ctx.c1
	end
	return FIXED[key] or ctx.c1
end

-- where a piece goes: its size and world CFrame, from its frame
function B.place(q, fr)
	local scale
	if q.fit and fr.size then
		scale = fr.size
	else
		scale = V3(fr.u, fr.u, fr.u)
	end
	local sizeScale = scale
	if q.sh == "Cyl" and q.fit and fr.size then
		-- a fitted cylinder: its length follows whichever limb axis it lies along and its diameter hugs the
		-- limb's thickest side (a Roblox cylinder is always round, so a stretched one would shrink inside the limb)
		local rot = q.lcf and (q.lcf - q.lcf.Position) or CFrame.Angles(rad(q.r.X), rad(q.r.Y), rad(q.r.Z))
		local ax = rot * V3(1, 0, 0) - rot.Position
		local a = { math.abs(ax.X), math.abs(ax.Y), math.abs(ax.Z) }
		local dims = { fr.size.X, fr.size.Y, fr.size.Z }
		local i = (a[1] >= a[2] and a[1] >= a[3]) and 1 or ((a[2] >= a[3]) and 2 or 3)
		local d = 0
		for k = 1, 3 do
			if k ~= i then
				d = math.max(d, dims[k])
			end
		end
		sizeScale = V3(dims[i], d, d)
	end
	local size = q.s * sizeScale
	size = V3(math.max(size.X, 0.02), math.max(size.Y, 0.02), math.max(size.Z, 0.02))
	local cf
	if q.lcf then
		cf = fr.cf * CFrame.new(q.lcf.Position * scale) * (q.lcf - q.lcf.Position)
	else
		cf = fr.cf * CFrame.new(q.o * scale) * CFrame.Angles(rad(q.r.X), rad(q.r.Y), rad(q.r.Z))
	end
	return size, cf
end

B.colourFor, B.KEY_MAT, B.KEY_REFL = colourFor, KEY_MAT, KEY_REFL

local function makePart(q, fr, ctx, model, item)
	local sh = q.sh
	local part
	if sh == "Wedge" then
		part = Instance.new("WedgePart")
	elseif sh == "Corner" then
		part = Instance.new("CornerWedgePart")
	else
		part = Instance.new("Part")
		if sh == "Ball" then
			-- a Ball-shaped Part is always a perfect sphere; a block with a sphere mesh stretches to any size, so
			-- hair caps, puffers and pendants keep their egg / ellipsoid shapes
			part.Shape = Enum.PartType.Block
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		elseif sh == "Cyl" then
			part.Shape = Enum.PartType.Cylinder
		else
			part.Shape = Enum.PartType.Block
		end
	end
	local size, cf = B.place(q, fr)
	part.Size = size
	part.CFrame = cf
	part.Color = colourFor(q.c, ctx)
	part.Material = q.m or KEY_MAT[q.c] or (item.mat and Enum.Material[item.mat]) or FAB
	part.Reflectance = q.refl or KEY_REFL[q.c] or 0
	part.Transparency = q.t or 0
	part.CastShadow = (part.Size.Magnitude > 0.25 * fr.u)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Name = sh
	if q.txt then
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId[q.txt.face or "Front"]
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 60
		sg.LightInfluence = 1
		local tl = Instance.new("TextLabel")
		tl.BackgroundTransparency = 1
		tl.Size = UDim2.fromScale(1, 1)
		tl.Text = q.txt.text
		tl.TextScaled = true
		tl.Font = Enum.Font[q.txt.font or "GothamBlack"]
		tl.TextColor3 = colourFor(q.txt.color or "c2", ctx)
		tl.Parent = sg
		sg.Parent = part
	end
	if q.spark and ctx.sparkle then
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Rate = 1.6
		pe.Lifetime = NumberRange.new(0.25, 0.45)
		pe.Speed = NumberRange.new(0)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.18 * fr.u), NumberSequenceKeypoint.new(1, 0) })
		pe.LightEmission = 1
		pe.Color = ColorSequence.new(Color3.new(1, 1, 1))
		pe.Parent = part
	end
	if q.glow and ctx.sparkle then
		local l = Instance.new("PointLight")
		l.Range, l.Brightness, l.Color = 3, 0.6, part.Color
		l.Parent = part
	end
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = fr.part, part
	w.Parent = part
	part.Parent = model
	return part
end

-- resolve a look against the catalog: returns a list of { slot, item, c1, c2 } in the order they layer
function B.resolve(look, Catalog)
	local out = {}
	for _, slot in ipairs(Catalog.SLOTS) do
		local e = look[slot.id]
		local item = e and Catalog.ITEMS_BY_ID[e.id]
		if item and item.slot == slot.id then
			table.insert(out, {
				slot = slot.id,
				item = item,
				c1 = hex(e.c1 or item.def1 or "#808080"),
				c2 = hex(e.c2 or item.def2 or item.def1 or "#808080"),
			})
		end
	end
	return out
end

-- strip anything on the torso / hips / thighs that could show skin (a skin texture, a SurfaceAppearance) and
-- put the plain base layer on. Safe to call on any character at any time; Apply calls it too.
function B.ApplyBaseLayer(char)
	for region, colour in pairs(B.BASE_LAYER) do
		for _, name in ipairs(REGION_PARTS[region]) do
			local part = char:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				for _, ch in ipairs(part:GetChildren()) do
					if ch:IsA("SurfaceAppearance") or ch:IsA("Decal") or ch:IsA("Texture") then
						ch:Destroy()
					end
				end
				if part:IsA("MeshPart") then
					pcall(function()
						part.TextureID = ""
					end)
				end
				part.Color = colour
				part.Material = FAB
			end
		end
	end
	B.ApplyEyes(char)
end

-- eyes for the MakeHuman bodies: their heads have real eye openings and an NC_<Side>EyeAttachment at the centre of
-- each eyeball (put there by AssembleMakeHumanBodies, radius in the Head's NC_EyeRadius attribute). A white
-- eyeball, an iris and a pupil, welded to the head, looking straight ahead. Bodies without the attachments (stock
-- avatars) are left alone. Kept outside the look folder, so changing outfits never removes them.
B.EYE = { white = Color3.fromRGB(238, 236, 230), iris = Color3.fromRGB(78, 52, 32), pupil = Color3.fromRGB(14, 12, 12) }
function B.ApplyEyes(char, irisColour)
	local head = char:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return
	end
	local old = char:FindFirstChild("NC_Eyes")
	if old and not irisColour and old:GetAttribute("For") == head:GetDebugId() then
		return
	end
	if old then
		old:Destroy()
	end
	local r = head:GetAttribute("NC_EyeRadius") or 0.06
	local folder
	for _, side in ipairs({ "Left", "Right" }) do
		local at = head:FindFirstChild("NC_" .. side .. "EyeAttachment")
		if at and at:IsA("Attachment") then
			if not folder then
				folder = Instance.new("Folder")
				folder.Name = "NC_Eyes"
				folder:SetAttribute("For", head:GetDebugId())
			end
			local centre = CFrame.new(at.WorldPosition) * (head.CFrame - head.CFrame.Position)
			local function bit(name, shape, size, cf, colour, mat)
				local part = Instance.new("Part")
				part.Name = side .. name
				part.Shape = shape
				part.Size = size
				part.CFrame = cf
				part.Color = colour
				part.Material = mat
				part.CanCollide, part.CanTouch, part.CanQuery, part.Massless, part.Anchored = false, false, false, true, false
				part.CastShadow = false
				part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
				local w = Instance.new("WeldConstraint")
				w.Part0, w.Part1 = head, part
				w.Parent = part
				part.Parent = folder
			end
			bit("Eye", Enum.PartType.Ball, Vector3.one * 2 * r, centre, B.EYE.white, Enum.Material.SmoothPlastic)
			-- discs face forward (-Z): a cylinder's axis is X, turned a quarter round Y
			local disc = CFrame.Angles(0, math.rad(90), 0)
			bit("Iris", Enum.PartType.Cylinder, Vector3.new(0.06 * r, 1.0 * r, 1.0 * r), centre * CFrame.new(0, 0, -0.99 * r) * disc,
				irisColour or B.EYE.iris, Enum.Material.SmoothPlastic)
			bit("Pupil", Enum.PartType.Cylinder, Vector3.new(0.06 * r, 0.42 * r, 0.42 * r), centre * CFrame.new(0, 0, -1.02 * r) * disc,
				B.EYE.pupil, Enum.Material.SmoothPlastic)
		end
	end
	if folder then
		folder.Parent = char
	end
end

function B.Clear(char)
	local old = char:FindFirstChild(B.FOLDER)
	if old then
		old:Destroy()
	end
	for _, a in ipairs(char:GetChildren()) do
		if a:IsA("Accessory") and a:GetAttribute("NC_Look") then
			a:Destroy()
		end
	end
end

-- Plan(look, Catalog, opts) -> regions, builds: the pure part of Apply (no Instances), also used by the offline
-- preview renderer. regions[name] = { colour, material, bare }; builds = { { e, item, ctx, pieces, skip } }
function B.Plan(look, Catalog, opts)
	opts = opts or {}
	local entries = B.resolve(look, Catalog)

	-- skin first, then which slots hide others (helmets / ski masks hide hair; hats flatten hair volume)
	local skin = Color3.fromRGB(198, 140, 105)
	local hairColour
	local hideHair, hatOn, hideBeard = false, false, false
	local topColour
	for _, e in ipairs(entries) do
		if e.slot == "Skin" then
			skin = e.c1
		elseif e.slot == "Hair" then
			hairColour = e.c1
		elseif e.slot == "Top" then
			topColour = e.c1
		end
		local pp = e.item.p or {}
		if pp.hideHair then
			hideHair = true
		end
		if pp.hideBeard then
			hideBeard = true
		end
		if e.slot == "Head" and not pp.noFlatten then
			hatOn = true
		end
	end

	-- body regions. NO NUDITY, EVER (Roblox rules): the torso, hips and thighs start dressed in a plain base
	-- layer (undershirt + boxer shorts) and can never be set to skin by any item, so even a broken or empty look,
	-- a failed load or a missing top/bottom still shows a clothed body. Only arms, lower legs, hands, feet and the
	-- head may show skin.
	local regions = {}
	for name in pairs(REGION_PARTS) do
		regions[name] = { colour = skin, material = Enum.Material.SmoothPlastic }
	end
	for name, colour in pairs(B.BASE_LAYER) do
		regions[name] = { colour = colour, material = FAB }
	end

	-- pass 1: every item's body colours (so pass 2 knows which regions are bare skin, for tattoos)
	local built = {}
	for name, st in pairs(regions) do
		st.bare = not B.BASE_LAYER[name]
	end
	for _, e in ipairs(entries) do
		local item = e.item
		local ctx = { c1 = e.c1, c2 = e.c2, skin = skin, hair = hairColour, under = topColour, sparkle = opts.sparkle ~= false }
		local fam = F[item.fam]
		if not fam then
			warn("NCLookBuilder: no family " .. tostring(item.fam) .. " for " .. item.id)
			continue
		end
		local pieces, body = fam(item.p or {}, item)
		if body then
			for region, v in pairs(body) do
				local key, m = v, nil
				if type(v) == "table" then
					key, m = v.c, v.m
				end
				if key == "skin" and B.BASE_LAYER[region] then
					continue -- never bare: the base layer stays (under skirts and dresses it reads as bike shorts)
				end
				regions[region] = { colour = colourFor(key, ctx), material = m or (key == "skin" and Enum.Material.SmoothPlastic or FAB), bare = key == "skin" }
			end
		end
		local skip = (e.slot == "Hair" and hideHair) or (e.slot == "FacialHair" and hideBeard)
		table.insert(built, { e = e, item = item, ctx = ctx, pieces = pieces, skip = skip })
	end

	return regions, built, hatOn, hideHair, hideBeard
end

-- should this piece of this build be made? (hats flatten hair, clothes cover tattoos)
function B.wants(b, q, regions, hatOn)
	if q.skin and not (regions[q.skin] and regions[q.skin].bare) then
		return false
	end
	if q.top and hatOn and b.e.slot == "Hair" then
		return false
	end
	return true
end

-- Apply(char, look, Catalog, opts) -> the folder of built pieces
--   opts.assets: { [itemId] = Accessory } real meshes to wear instead of the procedural pieces
--   opts.sparkle: particle twinkles on iced pieces and small lights on glowing parts (default true)
--   opts.stripAvatar: remove the Roblox avatar's own clothing, accessories and BodyColors (default true)
function B.Apply(char, look, Catalog, opts)
	opts = opts or {}
	B.Clear(char)
	if opts.stripAvatar ~= false then
		for _, d in ipairs(char:GetChildren()) do
			if d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") then
				d:Destroy()
			elseif d:IsA("Accessory") and not d:GetAttribute("NC_Keep") then
				d:Destroy()
			end
		end
	end
	B.ApplyBaseLayer(char)
	local folder = Instance.new("Folder")
	folder.Name = B.FOLDER
	local fr = B.frames(char)
	local regions, built, hatOn = B.Plan(look, Catalog, opts)
	for _, b in ipairs(built) do
		local item, ctx, pieces, skip = b.item, b.ctx, b.pieces, b.skip
		local asset = opts.assets and opts.assets[item.id]
		if asset and not skip then
			local acc = asset:Clone()
			acc:SetAttribute("NC_Look", item.id)
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:AddAccessory(acc)
			end
		elseif not skip and pieces and #pieces > 0 then
			local model = Instance.new("Model")
			model.Name = item.id
			for _, q in ipairs(pieces) do
				if B.wants(b, q, regions, hatOn) then
					local f = fr[q.f]
					if f then
						makePart(q, f, ctx, model, item)
					end
				end
			end
			model.Parent = folder
		end
	end

	for region, st in pairs(regions) do
		for _, name in ipairs(REGION_PARTS[region]) do
			local part = char:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				part.Color = st.colour
				part.Material = st.material
				-- standard avatar heads carry a mesh with its own texture: keep the face decal, drop the texture
				if part:IsA("MeshPart") and region ~= "Head" then
					pcall(function()
						part.TextureID = ""
					end)
					local sa = part:FindFirstChildOfClass("SurfaceAppearance")
					if sa then
						sa:Destroy()
					end
				end
			end
		end
	end
	folder.Parent = char
	char:SetAttribute("NC_LookApplied", os.clock())
	return folder
end

return B
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX3"><Properties><string name="Name">LookStudioService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- LookStudioService (Script in ServerScriptService): the server half of the Character Studio.
--   * Saves each player's look, the items they own and 8 named outfit slots (DataStore "NeonCoast_Look_v1").
--   * Puts the look on every character as it spawns (before FitnessService scales the body, which keeps working:
--     it remembers the look's own build through the NC_LookBase attribute).
--   * Buying goes through NCWallet, so clothes cost the same Cash jobs and robberies pay into.
--   * Everything the client sends is checked here: the item exists, it's in the right slot, the colours are on the
--     item's palette, required slots stay filled, and the player can pay.
-- Remote: ReplicatedStorage.Remotes.LookStudio (RemoteFunction)
--   "Get"                         -> { look, owned, outfits, cash, free }
--   "Wear", look                  -> ok, msg, state       (buys anything not owned, then wears it)
--   "SaveOutfit", index, name     -> ok, msg, state       (saves the current look in slot 1..8)
--   "DeleteOutfit", index         -> ok, msg, state
-- Config (attributes on this script, set them in Studio):
--   FreeMode (bool)     everything is free (testing / a creative server)
--   Sparkle (bool, default true) iced pieces twinkle
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")
local DataStoreService = game:GetService("DataStoreService")
local InsertService = game:GetService("InsertService")

-- one-drag install: if this script arrived inside the NeonCoastCharacterStudio folder (the .rbxmx dropped into
-- ServerScriptService), move the shared modules to ReplicatedStorage and the client to StarterPlayerScripts
do
	local here = script.Parent
	for _, n in ipairs({ "NCLookCatalog", "NCLookBuilder", "NCBodyData" }) do
		local m = here:FindFirstChild(n)
		if m and m:IsA("ModuleScript") then
			local old = RS:FindFirstChild(n)
			if old then
				old:Destroy() -- the package copy is the newer one
			end
			m.Parent = RS
		end
	end
	local cl = here:FindFirstChild("LookStudioClient")
	if cl then
		local sps = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts")
		local old = sps:FindFirstChild(cl.Name)
		if old then
			old:Destroy()
		end
		cl.Parent = sps
	end
end

local Catalog = require(RS:WaitForChild("NCLookCatalog"))
local Builder = require(RS:WaitForChild("NCLookBuilder"))

local Wallet
do
	local m = SSS:FindFirstChild("NCWallet")
	if m then
		local ok, res = pcall(require, m)
		if ok then
			Wallet = res
		end
	end
end

local Remotes = RS:FindFirstChild("Remotes")
if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "Remotes"
	Remotes.Parent = RS
end
local LookRF = Remotes:FindFirstChild("LookStudio") or Instance.new("RemoteFunction")
LookRF.Name = "LookStudio"
LookRF.Parent = Remotes
local LookChanged = Remotes:FindFirstChild("LookChanged") or Instance.new("RemoteEvent") -- tells the client its look changed
LookChanged.Name = "LookChanged"
LookChanged.Parent = Remotes

if script:GetAttribute("Sparkle") == nil then
	script:SetAttribute("Sparkle", true)
end

local MAX_OUTFITS = 8
local store
pcall(function()
	store = DataStoreService:GetDataStore("NeonCoast_Look_v1")
end)

local D = {} -- [player] = { look, owned, outfits, dirty, loaded }

---------------------------------------------------------------------------------------------------- helpers
local function freeMode()
	return script:GetAttribute("FreeMode") == true or Wallet == nil
end

local function cash(player)
	return Wallet and Wallet.Balance(player) or 0
end

local function notify(player, text, color)
	if Wallet then
		Wallet.Notify(player, text, color)
	end
end

local function copyLook(look)
	local out = {}
	for slot, e in pairs(look) do
		out[slot] = { id = e.id, c1 = e.c1, c2 = e.c2 }
	end
	return out
end

-- clean a look sent by a client: unknown items, wrong slots and colours off the palette are dropped or reset
local function sanitize(raw)
	if type(raw) ~= "table" then
		return nil, "bad look"
	end
	local look = {}
	for slot, e in pairs(raw) do
		if type(slot) == "string" and Catalog.SLOT_BY_ID[slot] and type(e) == "table" and type(e.id) == "string" then
			local item = Catalog.ITEMS_BY_ID[e.id]
			if item and item.slot == slot then
				local c1 = (Catalog.ColourAllowed(item, 1, e.c1) and e.c1) or item.def1
				local c2 = (Catalog.ColourAllowed(item, 2, e.c2) and e.c2) or item.def2
				look[slot] = { id = item.id, c1 = c1, c2 = c2 }
			end
		end
	end
	for _, s in ipairs(Catalog.SLOTS) do
		if s.required and not look[s.id] then
			look[s.id] = copyLook({ x = Catalog.DEFAULT_LOOK[s.id] }).x
		end
	end
	return look
end

local function state(player)
	local d = D[player]
	if not d then
		return nil
	end
	local owned = {}
	for id in pairs(d.owned) do
		table.insert(owned, id)
	end
	return { look = copyLook(d.look), owned = owned, outfits = d.outfits, cash = cash(player), free = freeMode(), made = d.made == true }
end

---------------------------------------------------------------------------------------------------- real meshes
-- items with an assetId (e.g. the creator's own Loose Bandana) are loaded once and worn as real accessories
local assetCache = {}
local function assetsFor(look)
	local out = {}
	for _, e in pairs(look) do
		local item = Catalog.ITEMS_BY_ID[e.id]
		if item and item.assetId then
			local cached = assetCache[item.assetId]
			if cached == nil then
				local ok, model = pcall(InsertService.LoadAsset, InsertService, item.assetId)
				local acc = ok and model and model:FindFirstChildWhichIsA("Accessory", true)
				if acc then
					acc.Parent = nil
					assetCache[item.assetId] = acc
				else
					warn("LookStudio: couldn't load asset " .. tostring(item.assetId) .. " for " .. item.id .. ", using the built-in version")
					assetCache[item.assetId] = false
				end
				if ok and model then
					model:Destroy()
				end
				cached = assetCache[item.assetId]
			end
			if cached then
				out[item.id] = cached
			end
		end
	end
	return out
end

---------------------------------------------------------------------------------------------------- apply
local function apply(player)
	local d = D[player]
	local char = player.Character
	if not (d and char and char.Parent) then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return
	end
	local ok, err = pcall(Builder.Apply, char, d.look, Catalog, { assets = assetsFor(d.look), sparkle = script:GetAttribute("Sparkle") })
	if not ok then
		warn("LookStudio: couldn't dress " .. player.Name .. ": " .. tostring(err))
		pcall(Builder.ApplyBaseLayer, char)
	end
end

---------------------------------------------------------------------------------------------------- save / load
local function load(player)
	local d = { look = copyLook(Catalog.DEFAULT_LOOK), owned = {}, outfits = {}, dirty = false, loaded = false }
	D[player] = d
	if store then
		local ok, data
		for _ = 1, 3 do
			ok, data = pcall(store.GetAsync, store, "u" .. player.UserId)
			if ok then
				break
			end
			task.wait(1)
		end
		if ok and type(data) == "table" then
			d.look = sanitize(data.look) or d.look
			d.made = data.made == true or data.look ~= nil
			if type(data.owned) == "table" then
				for _, id in ipairs(data.owned) do
					if Catalog.ITEMS_BY_ID[id] then
						d.owned[id] = true
					end
				end
			end
			if type(data.outfits) == "table" then
				for i = 1, MAX_OUTFITS do
					local o = data.outfits[i]
					if type(o) == "table" and type(o.look) == "table" then
						d.outfits[i] = { name = tostring(o.name or ("Outfit " .. i)):sub(1, 24), look = sanitize(o.look) }
					end
				end
			end
		elseif not ok then
			d.noSave = true -- don't overwrite their data with defaults if the store was down at join
			warn("LookStudio: DataStore load failed for " .. player.Name .. "; changes this session won't be saved")
		end
	end
	d.loaded = true
	return d
end

local function save(player)
	local d = D[player]
	if not (store and d and d.loaded and d.dirty and not d.noSave) then
		return
	end
	local owned = {}
	for id in pairs(d.owned) do
		table.insert(owned, id)
	end
	local data = { v = 1, look = d.look, owned = owned, outfits = d.outfits, made = d.made }
	local ok = pcall(store.SetAsync, store, "u" .. player.UserId, data)
	if ok then
		d.dirty = false
	end
end

---------------------------------------------------------------------------------------------------- remote
local last = {}
LookRF.OnServerInvoke = function(player, action, a, b)
	local d = D[player]
	if not (d and d.loaded) then
		return false, "Still loading your closet..."
	end
	local now = os.clock()
	if last[player] and now - last[player] < 0.25 and action ~= "Get" then
		return false, "Slow down"
	end
	last[player] = now

	if action == "Get" then
		return true, "", state(player)

	elseif action == "Wear" then
		local look, err = sanitize(a)
		if not look then
			return false, err, state(player)
		end
		local cost, missing = Catalog.Cost(look, d.owned)
		if cost > 0 and not freeMode() then
			if not Wallet.Spend(player, cost) then
				return false, ("You need $%d more"):format(cost - cash(player)), state(player)
			end
		end
		for _, id in ipairs(missing) do
			d.owned[id] = true
		end
		d.look = look
		d.made = true
		d.dirty = true
		apply(player)
		if cost > 0 then
			notify(player, (freeMode() and "Unlocked %d item%s" or "Bought %d item%s"):format(#missing, #missing == 1 and "" or "s"), Color3.fromRGB(120, 230, 140))
		end
		task.defer(save, player)
		LookChanged:FireClient(player)
		return true, cost > 0 and ("Spent $" .. cost) or "Looking good", state(player)

	elseif action == "SaveOutfit" then
		local i = tonumber(a)
		if not i or i < 1 or i > MAX_OUTFITS or i % 1 ~= 0 then
			return false, "Pick a slot 1-" .. MAX_OUTFITS, state(player)
		end
		local name = (type(b) == "string" and b ~= "") and b:sub(1, 24) or ("Outfit " .. i)
		-- names are shown to the player themself only, but run them through the filter anyway
		local okF, filtered = pcall(function()
			return game:GetService("TextService"):FilterStringAsync(name, player.UserId):GetNonChatStringForBroadcastAsync()
		end)
		d.outfits[i] = { name = okF and filtered or ("Outfit " .. i), look = copyLook(d.look) }
		d.dirty = true
		task.defer(save, player)
		return true, "Saved", state(player)

	elseif action == "DeleteOutfit" then
		local i = tonumber(a)
		if i and d.outfits[i] then
			d.outfits[i] = nil
			d.dirty = true
			task.defer(save, player)
		end
		return true, "Deleted", state(player)
	end
	return false, "Unknown action"
end

---------------------------------------------------------------------------------------------------- players
local function onPlayer(player)
	-- no nudity, ever: every character gets the base layer the moment it spawns, before the saved look has
	-- even loaded (and again if anything goes wrong dressing it)
	local function baseLayer(char)
		char:WaitForChild("UpperTorso", 10)
		pcall(Builder.ApplyBaseLayer, char)
	end
	player.CharacterAdded:Connect(baseLayer)
	if player.Character then
		task.spawn(baseLayer, player.Character)
	end
	load(player)
	local function dress(char)
		-- wait until the body parts are in, then dress before FitnessService (2.5 s) scales the build
		char:WaitForChild("Humanoid", 10)
		char:WaitForChild("Head", 10)
		char:WaitForChild("UpperTorso", 10)
		task.wait(0.2)
		if player.Character == char then
			apply(player)
		end
	end
	player.CharacterAdded:Connect(dress)
	if player.Character then
		task.spawn(dress, player.Character)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, p)
end
Players.PlayerRemoving:Connect(function(p)
	save(p)
	D[p], last[p] = nil, nil
end)
task.spawn(function()
	while true do
		task.wait(120)
		for _, p in ipairs(Players:GetPlayers()) do
			save(p)
		end
	end
end)
game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(save, p)
	end
	task.wait(3)
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX4"><Properties><string name="Name">LookStudioClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- LookStudioClient (LocalScript in StarterPlayerScripts): the Character Studio screen.
-- Opens from any closet ("Change outfit" fires ReplicatedStorage.LocalSignals.OpenCharacterStudio), on a player's
-- very first spawn (so new players make their character), and optionally from a hotkey.
--   Left: a live 3D preview of YOUR body (drag to spin, Face / Body zoom) wearing what you're trying on.
--   Right: Looks (one-tap preset outfits by collection), Body / Clothes / Headwear / Bling / Extras (every slot),
--          Saved (8 outfit slots). Search, collection filter, Trending and Owned filters, two colour rows per item.
--   Trying things on is free; "Wear" buys anything you don't own yet (Cash) and puts it on for everyone.
-- Attributes on this script: HotKey (string, KeyCode name, "" = none), OpenOnFirstJoin (bool, default true).
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local Catalog = require(RS:WaitForChild("NCLookCatalog"))
local Builder = require(RS:WaitForChild("NCLookBuilder"))
local Remotes = RS:WaitForChild("Remotes")
local LookRF = Remotes:WaitForChild("LookStudio")

local Signals = RS:FindFirstChild("LocalSignals")
if not Signals then
	Signals = Instance.new("Folder")
	Signals.Name = "LocalSignals"
	Signals.Parent = RS -- client-side only; the closet script finds it here
end
local OpenSig = Signals:FindFirstChild("OpenCharacterStudio")
if not OpenSig then
	OpenSig = Instance.new("BindableEvent")
	OpenSig.Name = "OpenCharacterStudio"
	OpenSig.Parent = Signals
end
if script:GetAttribute("OpenOnFirstJoin") == nil then
	script:SetAttribute("OpenOnFirstJoin", true)
end

---------------------------------------------------------------------------------------------------- theme
local COL = {
	bg = Color3.fromRGB(12, 14, 20), panel = Color3.fromRGB(22, 25, 34), card = Color3.fromRGB(32, 36, 48),
	cardHi = Color3.fromRGB(44, 50, 66), text = Color3.fromRGB(240, 242, 248), dim = Color3.fromRGB(150, 156, 172),
	accent = Color3.fromRGB(0, 230, 200), pink = Color3.fromRGB(255, 60, 200), gold = Color3.fromRGB(240, 196, 80),
	bad = Color3.fromRGB(255, 90, 90), good = Color3.fromRGB(110, 230, 140),
}
local FONT, FONT_B = Enum.Font.GothamMedium, Enum.Font.GothamBlack

local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	for _, c in ipairs(children or {}) do
		c.Parent = o
	end
	return o
end
local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end
local function stroke(c, t)
	return new("UIStroke", { Color = c or COL.cardHi, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function pad(p)
	return new("UIPadding", { PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p), PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p) })
end
local function label(text, size, color, font, props)
	local l = new("TextLabel", { BackgroundTransparency = 1, Text = text, TextSize = size or 14, TextColor3 = color or COL.text,
		Font = font or FONT, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true })
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	return l
end
local function button(text, color, props)
	local b = new("TextButton", { AutoButtonColor = true, BackgroundColor3 = color or COL.card, Text = text, TextSize = 15,
		TextColor3 = COL.text, Font = FONT_B }, { corner(8) })
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	return b
end

---------------------------------------------------------------------------------------------------- state
local S = {
	server = nil, -- last state from the server { look, owned, outfits, cash, free }
	owned = {},
	draft = {}, -- what you're trying on
	tab = "Looks",
	slot = nil,
	search = "",
	collection = nil,
	trendOnly = false,
	ownedOnly = false,
	open = false,
}

local function copyLook(look)
	local out = {}
	for k, e in pairs(look or {}) do
		out[k] = { id = e.id, c1 = e.c1, c2 = e.c2 }
	end
	return out
end

local function refreshServer(st)
	if type(st) ~= "table" then
		return
	end
	S.server = st
	S.owned = {}
	for _, id in ipairs(st.owned or {}) do
		S.owned[id] = true
	end
end

---------------------------------------------------------------------------------------------------- screen
local gui = new("ScreenGui", { Name = "NCLookStudio", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false, DisplayOrder = 20,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
local scale = new("UIScale", { Parent = gui })
local root = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = COL.bg, BackgroundTransparency = 0.08, Parent = gui })
new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(18, 20, 30), Color3.fromRGB(8, 9, 14)), Parent = root })

-- preview side
local left = new("Frame", { BackgroundTransparency = 1, Parent = root })
local vp = new("ViewportFrame", { Size = UDim2.new(1, 0, 1, -118), BackgroundColor3 = COL.panel, Ambient = Color3.fromRGB(150, 150, 160),
	LightColor = Color3.fromRGB(255, 246, 232), LightDirection = Vector3.new(-0.4, -0.8, -0.6), Parent = left }, { corner(16) })
new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(40, 46, 64), Color3.fromRGB(16, 18, 26)), Parent = vp })
local world = new("WorldModel", { Parent = vp })
local cam = new("Camera", { FieldOfView = 30, Parent = vp })
vp.CurrentCamera = cam
local title = label("CHARACTER STUDIO", 22, COL.text, FONT_B, { Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 28), Parent = vp })
local hint = label("drag to spin", 12, COL.dim, FONT, { Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 16), Parent = vp })
local zoomRow = new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 12, 1, -48), Size = UDim2.new(1, -24, 0, 36), Parent = vp },
	{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) })
local bBody = button("Body", COL.card, { Size = UDim2.fromOffset(70, 36), Parent = zoomRow })
local bFace = button("Face", COL.card, { Size = UDim2.fromOffset(70, 36), Parent = zoomRow })
local bRandom = button("🎲 Random", COL.card, { Size = UDim2.fromOffset(110, 36), Parent = zoomRow })

local footer = new("Frame", { BackgroundColor3 = COL.panel, Position = UDim2.new(0, 0, 1, -108), Size = UDim2.new(1, 0, 0, 108), Parent = left }, { corner(16), pad(12) })
local costLabel = label("", 16, COL.text, FONT_B, { Size = UDim2.new(1, -100, 0, 22), Parent = footer })
local cashLabel = label("", 13, COL.dim, FONT, { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, -100, 0, 18), Parent = footer })
local bWear = button("WEAR IT", COL.accent, { Position = UDim2.new(0, 0, 1, -44), Size = UDim2.new(0.62, -6, 0, 44), TextColor3 = COL.bg, TextSize = 18, Parent = footer })
local bReset = button("Undo all", COL.card, { Position = UDim2.new(0.62, 6, 1, -44), Size = UDim2.new(0.38, -6, 0, 44), Parent = footer })
local bClose = button("✕", COL.card, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(40, 40), TextSize = 18, Parent = footer })

-- browser side
local right = new("Frame", { BackgroundColor3 = COL.panel, Parent = root }, { corner(16), pad(12) })
local tabsBar = new("ScrollingFrame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X,
	ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 0, Parent = right },
	{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
local slotBar = new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 34), CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 0, Parent = right },
	{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
local filterBar = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 34), Parent = right })
local searchBox = new("TextBox", { BackgroundColor3 = COL.card, PlaceholderText = "🔎 search (chain, locs, suit...)", Text = "", ClearTextOnFocus = false,
	TextColor3 = COL.text, PlaceholderColor3 = COL.dim, Font = FONT, TextSize = 14, Size = UDim2.new(0.4, -6, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
	Parent = filterBar }, { corner(8), pad(8) })
local bCollection = button("All worlds ▾", COL.card, { Position = UDim2.new(0.4, 0, 0, 0), Size = UDim2.new(0.28, -6, 1, 0), TextSize = 13, Parent = filterBar })
local bTrend = button("🔥 Trending", COL.card, { Position = UDim2.new(0.68, 0, 0, 0), Size = UDim2.new(0.18, -6, 1, 0), TextSize = 13, Parent = filterBar })
local bOwned = button("Owned", COL.card, { Position = UDim2.new(0.86, 0, 0, 0), Size = UDim2.new(0.14, 0, 1, 0), TextSize = 13, Parent = filterBar })

local grid = new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 128), Size = UDim2.new(1, 0, 1, -128 - 112), CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, ScrollBarImageColor3 = COL.cardHi, Parent = right })
local gridLayout = new("UIGridLayout", { CellSize = UDim2.fromOffset(150, 96), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = grid })

local colourPanel = new("Frame", { BackgroundColor3 = COL.card, Position = UDim2.new(0, 0, 1, -104), Size = UDim2.new(1, 0, 0, 104), Parent = right }, { corner(12), pad(8) })
local selLabel = label("", 14, COL.text, FONT_B, { Size = UDim2.new(1, -110, 0, 20), Parent = colourPanel })
local bRemove = button("Take off", COL.cardHi, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(100, 24), TextSize = 12, Parent = colourPanel })
local function swatchRow(y)
	local row = new("ScrollingFrame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 34), CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 0, Parent = colourPanel },
		{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), VerticalAlignment = Enum.VerticalAlignment.Center }) })
	return row
end
local row1 = swatchRow(24)
local row2 = swatchRow(60)

local toast = label("", 15, COL.text, FONT_B, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(420, 40),
	BackgroundColor3 = COL.card, BackgroundTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 10, Parent = root })
corner(10).Parent = toast

-- collection picker (overlay list)
local picker = new("ScrollingFrame", { BackgroundColor3 = COL.panel, Visible = false, ZIndex = 20, Size = UDim2.fromOffset(260, 360), CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, Parent = root }, { corner(12), stroke(COL.cardHi), pad(8),
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })

gui.Parent = player:WaitForChild("PlayerGui")

local toastToken = 0
local function say(text, color)
	toastToken += 1
	local my = toastToken
	toast.Text = text
	toast.TextColor3 = color or COL.text
	toast.Visible = true
	task.delay(2.4, function()
		if my == toastToken then
			toast.Visible = false
		end
	end)
end

---------------------------------------------------------------------------------------------------- layout (desktop / phone)
local function layout()
	local cam0 = workspace.CurrentCamera
	local vs = cam0 and cam0.ViewportSize or Vector2.new(1280, 720)
	local portrait = vs.Y > vs.X * 1.05
	local s = math.clamp(math.min(vs.X / 1280, vs.Y / 720), 0.62, 1.25)
	if portrait then
		s = math.clamp(vs.X / 520, 0.6, 1.2)
	end
	scale.Scale = s
	local W, H = vs.X / s, vs.Y / s
	local inset = GuiService:GetGuiInset().Y / s
	local m = 14
	if portrait then
		left.Position = UDim2.fromOffset(m, inset + m)
		left.Size = UDim2.fromOffset(W - m * 2, H * 0.42 - inset)
		right.Position = UDim2.fromOffset(m, H * 0.42 + m)
		right.Size = UDim2.fromOffset(W - m * 2, H * 0.58 - m * 2)
	else
		local lw = math.clamp(W * 0.36, 300, 520)
		left.Position = UDim2.fromOffset(m, inset + m)
		left.Size = UDim2.fromOffset(lw, H - inset - m * 2)
		right.Position = UDim2.fromOffset(lw + m * 2, inset + m)
		right.Size = UDim2.fromOffset(W - lw - m * 3, H - inset - m * 2)
	end
	local gw = right.Size.X.Offset - 24 - 14
	local cols = math.max(2, math.floor(gw / 158))
	gridLayout.CellSize = UDim2.fromOffset(math.floor((gw - (cols - 1) * 8) / cols), 96)
	picker.Position = UDim2.fromOffset(right.Position.X.Offset + right.Size.X.Offset * 0.4, right.Position.Y.Offset + 128)
end

---------------------------------------------------------------------------------------------------- preview mannequin
local dummy
local yaw = math.rad(200)
local zoom = "body"
local function buildDummy()
	if dummy then
		dummy:Destroy()
		dummy = nil
	end
	local char = player.Character
	if not char then
		return
	end
	local was = char.Archivable
	char.Archivable = true
	local ok, c = pcall(function()
		return char:Clone()
	end)
	char.Archivable = was
	if not ok or not c then
		return
	end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") or d:IsA("Sound") or d:IsA("ForceField") or d:IsA("Tool") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = false
		end
	end
	local hrp = c:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = true
		c.PrimaryPart = hrp
		c:PivotTo(CFrame.new(0, 3.7, 0))
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.PlatformStand = true
	end
	c.Parent = world
	dummy = c
end

local function placeCamera()
	if not dummy then
		return
	end
	local cf, size = dummy:GetBoundingBox()
	local head = dummy:FindFirstChild("Head")
	local target, dist
	if zoom == "face" and head then
		target = head.Position + Vector3.new(0, 0.05, 0)
		dist = head.Size.Y * 6.5
	else
		target = cf.Position
		dist = math.max(size.Y, 4) * 2.15
	end
	cam.CFrame = CFrame.new(target + Vector3.new(math.sin(yaw) * dist, (zoom == "face") and 0.1 or size.Y * 0.08, math.cos(yaw) * dist), target)
end

local function renderDraft()
	if not dummy or not dummy.Parent then
		buildDummy()
	end
	if dummy then
		local ok, err = pcall(Builder.Apply, dummy, S.draft, Catalog, { sparkle = true })
		if not ok then
			warn("LookStudio preview: " .. tostring(err))
		end
		placeCamera()
	end
end

-- drag to spin
local dragging, lastX = false, 0
vp.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging, lastX = true, input.Position.X
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		yaw -= (input.Position.X - lastX) * 0.012
		lastX = input.Position.X
		placeCamera()
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
bBody.MouseButton1Click:Connect(function()
	zoom = "body"
	placeCamera()
end)
bFace.MouseButton1Click:Connect(function()
	zoom = "face"
	yaw = math.rad(180)
	placeCamera()
end)
-- a slow idle spin when nobody's touching it
RunService.RenderStepped:Connect(function(dt)
	if S.open and not dragging and zoom == "body" then
		yaw += dt * 0.12
		placeCamera()
	end
end)

---------------------------------------------------------------------------------------------------- cost / footer
local function updateFooter()
	local cost, missing = Catalog.Cost(S.draft, S.owned)
	local free = S.server and S.server.free
	if free then
		costLabel.Text = #missing > 0 and ("Unlock %d new item%s: FREE"):format(#missing, #missing == 1 and "" or "s") or "Everything here is yours"
	else
		costLabel.Text = cost > 0 and ("$%s for %d new item%s"):format(tostring(cost), #missing, #missing == 1 and "" or "s") or "Everything here is yours"
	end
	local cash = S.server and S.server.cash or 0
	cashLabel.Text = free and "Free mode" or ("Your cash: $" .. tostring(cash))
	costLabel.TextColor3 = (not free and cost > cash) and COL.bad or COL.text
	bWear.Text = (cost > 0 and not free) and ("BUY & WEAR  $" .. cost) or "WEAR IT"
end

---------------------------------------------------------------------------------------------------- colours
local function colourPanelFor(slotId)
	for _, r in ipairs({ row1, row2 }) do
		for _, ch in ipairs(r:GetChildren()) do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
	end
	local e = slotId and S.draft[slotId]
	local item = e and Catalog.ITEMS_BY_ID[e.id]
	local slotDef = slotId and Catalog.SLOT_BY_ID[slotId]
	bRemove.Visible = item ~= nil and slotDef and not slotDef.required
	if not item then
		selLabel.Text = slotDef and (slotDef.name .. ": nothing on") or "Pick something to try on"
		return
	end
	selLabel.Text = item.name
	local function fill(r, which)
		local pal = Catalog.PALETTES[which == 1 and item.pal1 or item.pal2 or ""]
		if not pal then
			r.Visible = false
			return
		end
		r.Visible = true
		new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(46, 30), Text = which == 1 and "Main" or "Accent", TextColor3 = COL.dim,
			Font = FONT, TextSize = 12, Parent = r })
		local cur = (which == 1 and e.c1 or e.c2) or (which == 1 and item.def1 or item.def2)
		for _, h in ipairs(pal) do
			local sw = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Builder.hex(h), Parent = r },
				{ new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
			if cur and cur:upper() == h:upper() then
				stroke(COL.accent, 3).Parent = sw
			else
				stroke(Color3.fromRGB(0, 0, 0), 1).Parent = sw
			end
			sw.MouseButton1Click:Connect(function()
				if which == 1 then
					e.c1 = h
					-- keep the beard matching the hair if it was matching
					if slotId == "Hair" and S.draft.FacialHair then
						S.draft.FacialHair.c1 = h
					end
				else
					e.c2 = h
				end
				renderDraft()
				colourPanelFor(slotId)
			end)
		end
	end
	fill(row1, 1)
	fill(row2, 2)
	if not row2.Visible then
		row1.Position = UDim2.fromOffset(0, 34)
	else
		row1.Position = UDim2.fromOffset(0, 24)
	end
end

---------------------------------------------------------------------------------------------------- grid
local refreshGrid -- forward
local function clearGrid()
	for _, ch in ipairs(grid:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	grid.CanvasPosition = Vector2.zero
end

local function matches(item)
	if S.search ~= "" then
		local q = S.search:lower()
		if not item.name:lower():find(q, 1, true) and not item.id:find(q, 1, true) then
			local hit = false
			for _, c in ipairs(item.cols) do
				if c:find(q, 1, true) then
					hit = true
				end
			end
			if not hit then
				return false
			end
		end
	end
	if S.collection and not table.find(item.cols, S.collection) then
		return false
	end
	if S.trendOnly and not item.trend then
		return false
	end
	if S.ownedOnly and not (S.owned[item.id] or item.price == 0) then
		return false
	end
	return true
end

local function itemCard(item, order)
	local worn = S.draft[item.slot] and S.draft[item.slot].id == item.id
	local card = new("TextButton", { Text = "", AutoButtonColor = true, BackgroundColor3 = worn and COL.cardHi or COL.card, LayoutOrder = order, Parent = grid },
		{ corner(10), stroke(worn and COL.accent or COL.cardHi, worn and 2 or 1) })
	local col = Builder.hex(item.def1 or "#808080")
	new("Frame", { BackgroundColor3 = col, Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(30, 30), Parent = card },
		{ new("UICorner", { CornerRadius = UDim.new(1, 0) }), stroke(Color3.new(0, 0, 0), 1) })
	if item.def2 and item.pal2 then
		new("Frame", { BackgroundColor3 = Builder.hex(item.def2), Position = UDim2.fromOffset(28, 26), Size = UDim2.fromOffset(14, 14), Parent = card },
			{ new("UICorner", { CornerRadius = UDim.new(1, 0) }), stroke(Color3.new(0, 0, 0), 1) })
	end
	local badge = (item.trend and "🔥" or "") .. (item.new and "✨" or "")
	label(badge, 14, COL.text, FONT, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), Size = UDim2.fromOffset(40, 18),
		TextXAlignment = Enum.TextXAlignment.Right, Parent = card })
	label(item.name, 13, COL.text, FONT_B, { Position = UDim2.fromOffset(8, 42), Size = UDim2.new(1, -16, 0, 32), TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
	local priceText, pc
	if S.owned[item.id] then
		priceText, pc = "Owned", COL.good
	elseif item.price == 0 then
		priceText, pc = "Free", COL.good
	else
		priceText, pc = "$" .. item.price, COL.gold
	end
	label(priceText, 12, pc, FONT_B, { Position = UDim2.new(0, 8, 1, -20), Size = UDim2.new(1, -16, 0, 16), Parent = card })
	card.MouseButton1Click:Connect(function()
		local prev = S.draft[item.slot]
		if prev and prev.id == item.id and not Catalog.SLOT_BY_ID[item.slot].required then
			S.draft[item.slot] = nil -- tap again to take it off
		else
			-- keep the colour you picked if the new item uses the same palette (e.g. switching hairstyles)
			local prevItem = prev and Catalog.ITEMS_BY_ID[prev.id]
			local c1 = (prevItem and prevItem.pal1 == item.pal1 and item.pal1 ~= nil) and prev.c1 or item.def1
			local c2 = (prevItem and prevItem.pal2 == item.pal2 and item.pal2 ~= nil) and prev.c2 or item.def2
			if item.slot == "FacialHair" and S.draft.Hair and not prev then
				c1 = S.draft.Hair.c1 -- new beards start in your hair colour
			end
			S.draft[item.slot] = { id = item.id, c1 = c1, c2 = c2 }
		end
		S.slot = item.slot
		renderDraft()
		updateFooter()
		refreshGrid()
	end)
end

local function lookCard(lk, order)
	local card = new("TextButton", { Text = "", AutoButtonColor = true, BackgroundColor3 = COL.card, LayoutOrder = order, Parent = grid }, { corner(10), stroke(COL.cardHi) })
	local coll
	for _, c in ipairs(Catalog.COLLECTIONS) do
		if c.id == lk.col then
			coll = c
		end
	end
	-- a strip of the outfit's main colours
	local strip = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 14), Parent = card },
		{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3) }) })
	for _, slotId in ipairs({ "Hair", "Head", "Top", "Outer", "Bottom", "Shoes", "Neck" }) do
		local en = lk.look[slotId]
		local it = en and Catalog.ITEMS_BY_ID[en.id]
		if it then
			new("Frame", { BackgroundColor3 = Builder.hex(en.c1 or it.def1), Size = UDim2.fromOffset(14, 14), Parent = strip }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		end
	end
	local trend = table.find(lk.tags, "trend") and "🔥" or ""
	label(trend .. lk.name, 14, COL.text, FONT_B, { Position = UDim2.fromOffset(8, 28), Size = UDim2.new(1, -16, 0, 36), TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
	local cost = Catalog.Cost(lk.look, S.owned)
	label((coll and coll.name or "") .. "  ·  " .. (cost > 0 and ("$" .. cost) or "Owned"), 11, COL.dim, FONT, { Position = UDim2.new(0, 8, 1, -20), Size = UDim2.new(1, -16, 0, 16), Parent = card })
	card.MouseButton1Click:Connect(function()
		local skin = S.draft.Skin
		S.draft = copyLook(lk.look)
		if skin then
			S.draft.Skin = skin -- presets never change who you are
		end
		-- keep your own hair colour when the look doesn't specify one
		renderDraft()
		updateFooter()
		say("Trying on: " .. lk.name)
	end)
end

local function outfitCard(i, order)
	local o = S.server and S.server.outfits and S.server.outfits[i]
	local card = new("Frame", { BackgroundColor3 = COL.card, LayoutOrder = order, Parent = grid }, { corner(10), stroke(COL.cardHi) })
	label(o and o.name or ("Empty slot " .. i), 14, o and COL.text or COL.dim, FONT_B, { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 34), Parent = card })
	local bSave = button(o and "Overwrite" or "Save here", COL.cardHi, { Position = UDim2.new(0, 6, 1, -34), Size = UDim2.new(0.5, -9, 0, 28), TextSize = 12, Parent = card })
	bSave.MouseButton1Click:Connect(function()
		-- saving stores what you're WEARING (bought), not an unbought try-on
		local ok, msg, st = LookRF:InvokeServer("SaveOutfit", i, (o and o.name) or ("Outfit " .. i))
		refreshServer(st)
		say(ok and "Saved what you're wearing to slot " .. i or msg, ok and COL.good or COL.bad)
		refreshGrid()
	end)
	if o then
		local bTry = button("Try on", COL.accent, { Position = UDim2.new(0.5, 3, 1, -34), Size = UDim2.new(0.5, -9, 0, 28), TextSize = 12, TextColor3 = COL.bg, Parent = card })
		bTry.MouseButton1Click:Connect(function()
			S.draft = copyLook(o.look)
			renderDraft()
			updateFooter()
		end)
		local bDel = button("🗑", COL.card, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 4), Size = UDim2.fromOffset(26, 22), TextSize = 12, Parent = card })
		bDel.MouseButton1Click:Connect(function()
			local _, _, st = LookRF:InvokeServer("DeleteOutfit", i)
			refreshServer(st)
			refreshGrid()
		end)
	end
end

local function setChip(b, on)
	b.BackgroundColor3 = on and COL.accent or COL.card
	b.TextColor3 = on and COL.bg or COL.text
end

local tabButtons, slotButtons = {}, {}
local function buildSlotBar()
	for _, b in ipairs(slotButtons) do
		b:Destroy()
	end
	slotButtons = {}
	local tabDef
	for _, t in ipairs(Catalog.TABS) do
		if t.name == S.tab then
			tabDef = t
		end
	end
	slotBar.Visible = tabDef ~= nil
	if not tabDef then
		return
	end
	if not S.slot or not table.find(tabDef.slots, S.slot) then
		S.slot = tabDef.slots[1]
	end
	for i, slotId in ipairs(tabDef.slots) do
		local sd = Catalog.SLOT_BY_ID[slotId]
		local b = button(sd.icon .. " " .. sd.name, COL.card, { Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, LayoutOrder = i, Parent = slotBar })
		pad(10).Parent = b
		setChip(b, slotId == S.slot)
		b.MouseButton1Click:Connect(function()
			S.slot = slotId
			buildSlotBar()
			refreshGrid()
		end)
		table.insert(slotButtons, b)
	end
	-- the body frame (NCBodyService): Male / Female MakeHuman body; the build comes from your fitness
	local BodyRF = tabDef.name == "Body" and Remotes:FindFirstChild("NCBody")
	if BodyRF then
		local cur = player:GetAttribute("BodyGender") or "Male"
		for i, g in ipairs({ "Male", "Female" }) do
			local b = button((g == "Male" and "♂ " or "♀ ") .. g .. " body", COL.card, { Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, LayoutOrder = 100 + i, Parent = slotBar })
			pad(10).Parent = b
			setChip(b, g == cur)
			b.MouseButton1Click:Connect(function()
				if g == (player:GetAttribute("BodyGender") or "Male") then
					return
				end
				local before = player.Character
				local ok, msg = BodyRF:InvokeServer("SetGender", g)
				if not ok then
					say(msg or "Couldn't change body", COL.bad or Color3.fromRGB(255, 120, 110))
					return
				end
				local t0 = os.clock()
				while player.Character == before and os.clock() - t0 < 3 do
					task.wait(0.05)
				end
				task.wait(0.3) -- let the new body get dressed
				buildDummy()
				renderDraft()
				buildSlotBar()
			end)
			table.insert(slotButtons, b)
		end
	end
end

function refreshGrid()
	clearGrid()
	for name, b in pairs(tabButtons) do
		setChip(b, name == S.tab)
	end
	filterBar.Visible = S.tab ~= "Saved"
	if S.tab == "Looks" then
		local n = 0
		for _, lk in ipairs(Catalog.LOOKS) do
			local ok = true
			if S.collection and lk.col ~= S.collection then
				ok = false
			end
			if S.trendOnly and not table.find(lk.tags, "trend") then
				ok = false
			end
			if S.search ~= "" and not lk.name:lower():find(S.search:lower(), 1, true) then
				ok = false
			end
			if ok then
				n += 1
				lookCard(lk, n)
			end
		end
		colourPanelFor(nil)
		selLabel.Text = "Tap a look to try the whole outfit. Then fine-tune any piece in the other tabs."
	elseif S.tab == "Saved" then
		for i = 1, 8 do
			outfitCard(i, i)
		end
		colourPanelFor(nil)
		selLabel.Text = "Saved outfits store what you're wearing. Wear a look first, then save it here."
	else
		local list = Catalog.ITEMS_BY_SLOT[S.slot] or {}
		local n = 0
		-- trending first, then by price
		local sorted = table.clone(list)
		table.sort(sorted, function(a, b)
			if a.trend ~= b.trend then
				return a.trend
			end
			return a.price < b.price
		end)
		for _, item in ipairs(sorted) do
			if matches(item) then
				n += 1
				itemCard(item, n)
			end
		end
		if n == 0 then
			label("Nothing matches. Clear the search or filters.", 14, COL.dim, FONT, { Size = UDim2.fromOffset(300, 40), Parent = grid })
		end
		colourPanelFor(S.slot)
	end
end

-- tabs
local TAB_NAMES = { "Looks" }
for _, t in ipairs(Catalog.TABS) do
	table.insert(TAB_NAMES, t.name)
end
table.insert(TAB_NAMES, "Saved")
for i, name in ipairs(TAB_NAMES) do
	local icon = ({ Looks = "✨ ", Body = "🧍 ", Clothes = "👕 ", Headwear = "🧢 ", Bling = "💎 ", Extras = "🎒 ", Saved = "💾 " })[name] or ""
	local b = button(icon .. name, COL.card, { Size = UDim2.fromOffset(0, 38), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i, Parent = tabsBar })
	pad(12).Parent = b
	tabButtons[name] = b
	b.MouseButton1Click:Connect(function()
		S.tab = name
		buildSlotBar()
		refreshGrid()
	end)
end

-- filters
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	S.search = searchBox.Text
	refreshGrid()
end)
bTrend.MouseButton1Click:Connect(function()
	S.trendOnly = not S.trendOnly
	setChip(bTrend, S.trendOnly)
	refreshGrid()
end)
bOwned.MouseButton1Click:Connect(function()
	S.ownedOnly = not S.ownedOnly
	setChip(bOwned, S.ownedOnly)
	refreshGrid()
end)
local function buildPicker()
	for _, ch in ipairs(picker:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	local function opt(id, name, blurb, order)
		local b = button("", S.collection == id and COL.cardHi or COL.card, { Size = UDim2.new(1, 0, 0, blurb and 50 or 34), LayoutOrder = order, ZIndex = 21, Parent = picker })
		label(name, 14, COL.text, FONT_B, { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 18), ZIndex = 22, Parent = b })
		if blurb then
			label(blurb, 11, COL.dim, FONT, { Position = UDim2.fromOffset(10, 22), Size = UDim2.new(1, -20, 0, 26), ZIndex = 22, Parent = b })
		end
		b.MouseButton1Click:Connect(function()
			S.collection = id
			bCollection.Text = (name or "All worlds") .. " ▾"
			setChip(bCollection, id ~= nil)
			picker.Visible = false
			refreshGrid()
		end)
	end
	opt(nil, "All worlds", nil, 0)
	for i, c in ipairs(Catalog.COLLECTIONS) do
		opt(c.id, c.name, c.blurb, i)
	end
end
bCollection.MouseButton1Click:Connect(function()
	buildPicker()
	picker.Visible = not picker.Visible
end)

---------------------------------------------------------------------------------------------------- actions
bRemove.MouseButton1Click:Connect(function()
	if S.slot and not Catalog.SLOT_BY_ID[S.slot].required then
		S.draft[S.slot] = nil
		renderDraft()
		updateFooter()
		refreshGrid()
	end
end)
bReset.MouseButton1Click:Connect(function()
	S.draft = copyLook(S.server and S.server.look or Catalog.DEFAULT_LOOK)
	renderDraft()
	updateFooter()
	refreshGrid()
end)

local function pick(list)
	return list[math.random(1, #list)]
end
bRandom.MouseButton1Click:Connect(function()
	-- a random look that hangs together: pick a world, then mostly items from it
	local coll = pick(Catalog.COLLECTIONS).id
	local d = { Skin = S.draft.Skin }
	for _, s in ipairs(Catalog.SLOTS) do
		if s.id ~= "Skin" then
			local pool = {}
			for _, it in ipairs(Catalog.ITEMS_BY_SLOT[s.id]) do
				if table.find(it.cols, coll) then
					table.insert(pool, it)
				end
			end
			local chance = s.required and 1 or ((s.id == "Hair") and 0.95 or (#pool > 0 and 0.55 or 0.12))
			if #pool == 0 then
				pool = Catalog.ITEMS_BY_SLOT[s.id]
			end
			if #pool > 0 and math.random() < chance and s.id ~= "Neck2" then
				local it = pick(pool)
				local p1, p2 = Catalog.PALETTES[it.pal1 or ""], Catalog.PALETTES[it.pal2 or ""]
				d[s.id] = { id = it.id, c1 = (p1 and math.random() < 0.5) and pick(p1) or it.def1, c2 = (p2 and math.random() < 0.4) and pick(p2) or it.def2 }
			end
		end
	end
	if d.Hair and d.FacialHair then
		d.FacialHair.c1 = d.Hair.c1
	end
	S.draft = d
	renderDraft()
	updateFooter()
	refreshGrid()
	for _, c in ipairs(Catalog.COLLECTIONS) do
		if c.id == coll then
			say("🎲 " .. c.name)
		end
	end
end)

local busy = false
bWear.MouseButton1Click:Connect(function()
	if busy then
		return
	end
	busy = true
	bWear.Text = "..."
	local ok, msg, st = LookRF:InvokeServer("Wear", S.draft)
	busy = false
	refreshServer(st)
	if ok then
		say("✅ " .. (msg or "Looking good"), COL.good)
		S.draft = copyLook(S.server.look)
	else
		say(msg or "Couldn't do that", COL.bad)
	end
	updateFooter()
	refreshGrid()
end)

local function close()
	S.open = false
	gui.Enabled = false
	picker.Visible = false
	if dummy then
		dummy:Destroy()
		dummy = nil
	end
end
bClose.MouseButton1Click:Connect(close)

local function open()
	if S.open then
		return
	end
	local ok, msg, st = LookRF:InvokeServer("Get")
	if not ok then
		say(msg or "Closet not ready", COL.bad)
		return
	end
	refreshServer(st)
	S.draft = copyLook(S.server.look)
	S.open = true
	layout()
	gui.Enabled = true
	buildDummy()
	buildSlotBar()
	renderDraft()
	updateFooter()
	refreshGrid()
end

OpenSig.Event:Connect(open)
UIS.InputBegan:Connect(function(input, gp)
	if gp then
		return
	end
	local key = script:GetAttribute("HotKey")
	if type(key) == "string" and key ~= "" and input.KeyCode.Name == key then
		if S.open then
			close()
		else
			open()
		end
	elseif S.open and input.KeyCode == Enum.KeyCode.Escape then
		close()
	end
end)
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	if S.open then
		layout()
		refreshGrid()
	end
end)
player.CharacterAdded:Connect(function()
	if S.open then
		task.wait(0.5)
		buildDummy()
		renderDraft()
	end
end)

-- first ever join: open the studio so new players make their character
task.spawn(function()
	if not script:GetAttribute("OpenOnFirstJoin") then
		return
	end
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("Head", 10)
	task.wait(3)
	local ok, _, st = LookRF:InvokeServer("Get")
	if ok and st and not st.made then
		open()
		say("Welcome! Make your character. Try a look, then tap WEAR IT.")
	end
end)
