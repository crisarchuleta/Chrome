end
F.goalie = function()
	local t = { p("Ball", "head", V3(2.0, 2.45, 1.25), V3(0, -0.15, -0.6), nil, "c1", { m = SMO }) }
	add(t, mirror({ p("Ball", "head", V3(0.36, 0.2, 0.1), V3(FACE.eyeX, FACE.eyeY, -1.2), nil, "black", { m = SMO }) }))
