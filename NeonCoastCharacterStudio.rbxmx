	for i = 0, 6 do
		table.insert(t, p("Block", "head", V3(0.02, 0.3, 0.05), V3((i - 3) * 0.14, -0.7, -1.12 + math.abs(i - 3) * 0.04), nil, "black", { m = SMO }))
	end
