F.respirator = function()
	return {
		p("Ball", "head", V3(1.55, 0.95, 0.75), V3(0, -0.68, -0.75), nil, "c1", { m = SMO }),
		p("Block", "head", V3(0.9, 0.06, 0.06), V3(0, -0.6, -1.12), nil, "c2", { m = NEO }),
		p("Block", "head", V3(0.6, 0.06, 0.06), V3(0, -0.78, -1.1), nil, "c2", { m = NEO }),
