		p("Block", "head", V3(1.25, 0.38, 0.1), V3(0, FACE.eyeY, -1.12), nil, "c2", { m = GLA, t = 0.3, refl = 0.4 }),
		cylZ("head", 0.45, 0.45, V3(0, -0.85, -1.25), "black", { m = RUB }),
		cylZ("head", 0.35, 0.4, V3(0.62, -0.75, -1.05), "black", { m = RUB }, V3(0, -35, 0)),
