			{18.6, 0.0, -41.0, 20.4, 1.8, -37.8, "rock"},
			{35.7, 0.35, -23.1, 40.075, 1.6, -20.5, "stand"},
		},
		Cut = {
			Max = {35.1, 0.0, -7.0},
			Min = {-35.1, -11.55, -36.2},
		},
		Extents = {
