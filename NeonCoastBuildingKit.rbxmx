		},
		Colliders = {
			{-35.05, 0, -25.05, 35.05, 0.45, 25.05, "floor"},
			{-34.45, 0.45, -24.45, 34.45, 0.8, 24.45, "floor"},
			{-32.0, 0.582, -7.05, -27.6, 1.482, -5.9, "stairs"},
			{-32.0, 1.264, -8.2, -27.6, 2.164, -7.05, "stairs"},
			{-32.0, 1.945, -9.35, -27.6, 2.845, -8.2, "stairs"},
			{-32.0, 2.627, -10.5, -27.6, 3.527, -9.35, "stairs"},
			{-32.0, 3.309, -11.65, -27.6, 4.209, -10.5, "stairs"},
			{-32.0, 3.991, -12.8, -27.6, 4.891, -11.65, "stairs"},
			{-32.0, 4.673, -13.95, -27.6, 5.573, -12.8, "stairs"},
			{-32.0, 5.355, -15.1, -27.6, 6.255, -13.95, "stairs"},
			{-32.0, 6.036, -16.25, -27.6, 6.936, -15.1, "stairs"},
			{-32.0, 6.718, -17.4, -27.6, 7.618, -16.25, "stairs"},
			{-32.0, 7.4, -18.55, -27.6, 8.3, -17.4, "stairs"},
			{-32.0, 7.4, -22.95, -22.6, 8.3, -18.55, "landing"},
			{-27.0, 8.082, -18.55, -22.6, 8.982, -17.4, "stairs"},
			{-27.0, 8.764, -17.4, -22.6, 9.664, -16.25, "stairs"},
			{-27.0, 9.445, -16.25, -22.6, 10.345, -15.1, "stairs"},
			{-27.0, 10.127, -15.1, -22.6, 11.027, -13.95, "stairs"},
			{-27.0, 10.809, -13.95, -22.6, 11.709, -12.8, "stairs"},
			{-27.0, 11.491, -12.8, -22.6, 12.391, -11.65, "stairs"},
			{-27.0, 12.173, -11.65, -22.6, 13.073, -10.5, "stairs"},
			{-27.0, 12.855, -10.5, -22.6, 13.755, -9.35, "stairs"},
			{-27.0, 13.536, -9.35, -22.6, 14.436, -8.2, "stairs"},
			{-27.0, 14.218, -8.2, -22.6, 15.118, -7.05, "stairs"},
			{-27.0, 14.9, -7.05, -22.6, 15.8, -5.9, "stairs"},
			{-27.6, 0.8, -18.55, -27.0, 15.8, -5.9, "stairwall"},
			{-32.0, 15.567, -7.05, -27.6, 16.467, -5.9, "stairs"},
			{-32.0, 16.233, -8.2, -27.6, 17.133, -7.05, "stairs"},
			{-32.0, 16.9, -9.35, -27.6, 17.8, -8.2, "stairs"},
			{-32.0, 17.567, -10.5, -27.6, 18.467, -9.35, "stairs"},
			{-32.0, 18.233, -11.65, -27.6, 19.133, -10.5, "stairs"},
			{-32.0, 18.9, -12.8, -27.6, 19.8, -11.65, "stairs"},
			{-32.0, 19.567, -13.95, -27.6, 20.467, -12.8, "stairs"},
			{-32.0, 20.233, -15.1, -27.6, 21.133, -13.95, "stairs"},
			{-32.0, 20.9, -16.25, -27.6, 21.8, -15.1, "stairs"},
			{-32.0, 20.9, -20.65, -22.6, 21.8, -16.25, "landing"},
			{-27.0, 21.567, -16.25, -22.6, 22.467, -15.1, "stairs"},
