<roblox version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">NeonCoastBuildingKit</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">BuildingKit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- BuildingKit: turns an inserted Blender building (a Model of MeshParts named <Style>_<Piece>) into a game-ready
-- building. Materials and colours per piece, exact invisible colliders from the Blender data (the meshes themselves
-- don't collide), doors that swing on their hinges and garage doors that roll up (BuildingDoors runs those), all
-- anchored under one Root at the Blender origin (ground level, front of the building toward Root's -Z... see FixYaw).
-- Data: BuildingKitData (generated by make_kit_data.py next to the .blend scripts).
local CollectionService = game:GetService("CollectionService")

local Data = require(script:WaitForChild("BuildingKitData"))
local Kit = {}
Kit.Data = Data

-- Turn (degrees about up) to apply after insert if the importer arrived rotated. Checked per style against an
-- asymmetric feature (houses: the garage is on +X in Blender) the first time each one is imported.
Kit.FixYaw = {}

local M = Enum.Material
local MAT = {
	WallsOut = { M.Plaster, Color3.fromRGB(236, 205, 160) },
	WallsIn = { M.Plaster, Color3.fromRGB(242, 238, 228) },
	Trim = { M.SmoothPlastic, Color3.fromRGB(246, 246, 240) },
	Roof = { M.ClayRoofTiles, Color3.fromRGB(176, 88, 58) },
	Floor = { M.WoodPlanks, Color3.fromRGB(150, 104, 66) },
	Tile = { M.CeramicTiles, Color3.fromRGB(222, 220, 210) },
	Foundation = { M.Concrete, Color3.fromRGB(160, 160, 155) },
	Ceiling = { M.Plaster, Color3.fromRGB(248, 248, 244) },
	Glass = { M.Glass, Color3.fromRGB(160, 205, 235), 0.45 },
	DoorGlass = { M.Glass, Color3.fromRGB(160, 205, 235), 0.45 },
	GarageGlass = { M.Glass, Color3.fromRGB(160, 205, 235), 0.4 },
	Sash = { M.Glass, Color3.fromRGB(160, 205, 235), 0.45 },
	Lamp = { M.Neon, Color3.fromRGB(255, 236, 200) },
	Screen = { M.SmoothPlastic, Color3.fromRGB(60, 62, 66) },
	Mulch = { M.Ground, Color3.fromRGB(86, 58, 38) },
	Edging = { M.Limestone, Color3.fromRGB(190, 186, 176) },
	Pavers = { M.Pavement, Color3.fromRGB(206, 186, 156) },
	Water = { M.Glass, Color3.fromRGB(70, 170, 220), 0.35 },
	PoolTile = { M.CeramicTiles, Color3.fromRGB(140, 205, 230) },
	MetalRoof = { M.Metal, Color3.fromRGB(200, 204, 206) },
	Lattice = { M.WoodPlanks, Color3.fromRGB(242, 242, 236) },
	Door = { M.Wood, Color3.fromRGB(110, 60, 36) },
	DoorKnob = { M.Metal, Color3.fromRGB(196, 170, 100) },
	GarageDoor = { M.SmoothPlastic, Color3.fromRGB(238, 238, 232) },
	Accent = { M.WoodPlanks, Color3.fromRGB(134, 88, 52) },
	Metal = { M.Metal, Color3.fromRGB(45, 45, 50) },
	Shutter = { M.Wood, Color3.fromRGB(46, 92, 102) },
	Stone = { M.Cobblestone, Color3.fromRGB(150, 142, 128) },
	Siding = { M.SmoothPlastic, Color3.fromRGB(176, 210, 220) },
	Brick = { M.Brick, Color3.fromRGB(150, 76, 58) },
	Awning = { M.Fabric, Color3.fromRGB(30, 140, 158) },
	Sign = { M.SmoothPlastic, Color3.fromRGB(24, 24, 30) },
	Deck = { M.WoodPlanks, Color3.fromRGB(142, 102, 70) },
	Gutter = { M.SmoothPlastic, Color3.fromRGB(244, 244, 240) },
	Patio = { M.Concrete, Color3.fromRGB(198, 196, 188) },
	-- downtown (build_city.py)
	DecoWall = { M.Plaster, Color3.fromRGB(178, 228, 208) }, DecoAccent = { M.SmoothPlastic, Color3.fromRGB(250, 246, 232) },
	DecoCoral = { M.SmoothPlastic, Color3.fromRGB(245, 142, 132) }, Terrazzo = { M.Marble, Color3.fromRGB(226, 218, 204) },
	Stucco = { M.Plaster, Color3.fromRGB(242, 220, 180) }, AwningB = { M.Fabric, Color3.fromRGB(216, 64, 64) },
	DarkGlass = { M.Glass, Color3.fromRGB(26, 40, 56), 0.15 }, Concrete = { M.Concrete, Color3.fromRGB(178, 178, 172) },
	Louver = { M.Metal, Color3.fromRGB(140, 145, 148) }, Wood = { M.Wood, Color3.fromRGB(108, 78, 52) },
	NeonPink = { M.Neon, Color3.fromRGB(255, 64, 166) }, NeonBlue = { M.Neon, Color3.fromRGB(52, 204, 255) },
	NeonRed = { M.Neon, Color3.fromRGB(255, 40, 40) }, NeonGreen = { M.Neon, Color3.fromRGB(76, 255, 116) },
	Hazard = { M.SmoothPlastic, Color3.fromRGB(242, 204, 26) }, Pack = { M.Fabric, Color3.fromRGB(40, 46, 56) },
}
local ROOF = {
	SafeHouse = { M.RoofShingles, Color3.fromRGB(70, 72, 78) },
	Modern = { M.Concrete, Color3.fromRGB(196, 196, 192) },
	Shop = { M.Concrete, Color3.fromRGB(190, 190, 186) },
	SchoolMain = { M.Concrete, Color3.fromRGB(190, 190, 186) },
	SchoolWing = { M.Concrete, Color3.fromRGB(190, 190, 186) },
}
Kit.Materials, Kit.RoofByStyle = MAT, ROOF

-- Colour schemes a placed copy can take (outside walls, trim, shutters, front door, roof)
Kit.Schemes = {
	{ WallsOut = Color3.fromRGB(236, 205, 160), Shutter = Color3.fromRGB(46, 92, 102), Door = Color3.fromRGB(110, 60, 36) },
	{ WallsOut = Color3.fromRGB(246, 228, 196), Shutter = Color3.fromRGB(120, 58, 48), Door = Color3.fromRGB(40, 70, 110) },
	{ WallsOut = Color3.fromRGB(196, 222, 214), Shutter = Color3.fromRGB(250, 250, 246), Door = Color3.fromRGB(180, 70, 60) },
	{ WallsOut = Color3.fromRGB(250, 214, 200), Shutter = Color3.fromRGB(70, 110, 90), Door = Color3.fromRGB(90, 50, 30) },
	{ WallsOut = Color3.fromRGB(214, 222, 236), Shutter = Color3.fromRGB(40, 50, 70), Door = Color3.fromRGB(150, 30, 40) },
	{ WallsOut = Color3.fromRGB(244, 236, 214), Shutter = Color3.fromRGB(90, 110, 60), Door = Color3.fromRGB(60, 40, 30) },
}

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function pieceName(inst, style)
	local cur = inst
	while cur do
		local p = cur.Name:match("^" .. style .. "_(%w+)")
		if p then
			return p
		end
		cur = cur.Parent
		if cur and cur:IsA("Model") and cur.Name == style then
			break
		end
	end
	return nil
end

local function worldAABB(parts)
	local mn, mx = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, p in parts do
		local h = p.Size / 2
		for _, s in { Vector3.new(1, 1, 1), Vector3.new(1, 1, -1), Vector3.new(1, -1, 1), Vector3.new(1, -1, -1), Vector3.new(-1, 1, 1), Vector3.new(-1, 1, -1), Vector3.new(-1, -1, 1), Vector3.new(-1, -1, -1) } do
			local w = p.CFrame:PointToWorldSpace(h * s)
			mn = mn:Min(w)
			mx = mx:Max(w)
		end
	end
	return mn, mx
end

local function invisiblePart(name, size, cf, collide)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.CanCollide = collide
	p.CanTouch = false
	p.CanQuery = collide
	p.CastShadow = false
	p.Transparency = 1
	return p
end

-- Swimmable water: an invisible box tagged NC_Water whose top face is the water surface (PoolClient swims in it).
local function waterVolume(cf, box, parent)
	local a, b = v3(box.Min), v3(box.Max)
	local w = invisiblePart("Water", b - a, cf * CFrame.new((a + b) / 2), false)
	w.CanQuery = false
	CollectionService:AddTag(w, "NC_Water")
	w.Parent = parent
	return w
end
Kit.WaterVolume = waterVolume

-- model: what insert_asset put in the place. Returns the finished building Model (the import model is emptied
-- and removed). The meshes must already be level; FixYaw[style] turns them if the importer rotated the model.
function Kit.Prepare(model, style)
	local d = Data[style]
	assert(d, "BuildingKit: no data for " .. tostring(style))
	local yaw = Kit.FixYaw[style] or 0
	if yaw ~= 0 then
		model:PivotTo(model:GetPivot() * CFrame.Angles(0, math.rad(yaw), 0))
	end
	local parts = {}
	for _, p in model:GetDescendants() do
		if p:IsA("MeshPart") then
			table.insert(parts, p)
		end
	end
	assert(#parts > 0, "BuildingKit: no MeshParts in " .. model:GetFullName())
	local mn = worldAABB(parts)
	local origin = mn - v3(d.Extents.Min)

	local out = Instance.new("Model")
	out.Name = style
	out:SetAttribute("Style", style)
	local root = invisiblePart("Root", Vector3.new(1, 1, 1), CFrame.new(origin), false)
	root.Parent = out
	out.PrimaryPart = root
	local meshes = Instance.new("Folder")
	meshes.Name = "Meshes"
	meshes.Parent = out
	local byPiece = {}
	for _, p in parts do
		local piece = pieceName(p, style)
		local base = piece and piece:gsub("%d+$", "")
		local m = (base == "Roof" and ROOF[style]) or (base and MAT[base])
		if m then
			p.Material = m[1]
			p.Color = m[2]
			p.Transparency = m[3] or 0
		end
		p.Anchored = true
		p.CanCollide = false -- the colliders below do the blocking
		p.CanTouch = false
		p.CanQuery = false
		p.Name = piece or p.Name
		p.Parent = meshes
		if piece then
			byPiece[piece] = p
		end
	end

	local cf = root.CFrame
	local cols = Instance.new("Folder")
	cols.Name = "Colliders"
	cols.Parent = out
	for _, c in d.Colliders do
		if c[7] ~= "garagedoor" then -- garage doors carry their own collider (they move)
			local a, b = Vector3.new(c[1], c[2], c[3]), Vector3.new(c[4], c[5], c[6])
			invisiblePart(c[7], b - a, cf * CFrame.new((a + b) / 2), true).Parent = cols
		end
	end

	local doors = Instance.new("Folder")
	doors.Name = "Doors"
	doors.Parent = out
	for i, dd in d.Doors do
		local dm = Instance.new("Model")
		dm.Name = "Door" .. i
		local hinge = invisiblePart("Hinge", Vector3.new(0.2, 0.2, 0.2), cf * CFrame.new(v3(dd.Hinge)), false)
		hinge.Parent = dm
		dm.PrimaryPart = hinge
		for _, pn in dd.Pieces do
			local mp = byPiece[pn]
			if mp then
				mp.Parent = dm
			end
		end
		local a, b = Vector3.new(dd.Box[1], dd.Box[2], dd.Box[3]), Vector3.new(dd.Box[4], dd.Box[5], dd.Box[6])
		local leaf = invisiblePart("Leaf", b - a - Vector3.new(0.1, 0.1, 0.1), cf * CFrame.new((a + b) / 2), true)
		leaf.Parent = dm
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Open"
		pp.ObjectText = (dd.Kind == "front" and "Front Door") or "Door"
		pp.HoldDuration = 0
		pp.MaxActivationDistance = 8
		pp.RequiresLineOfSight = false
		pp.Parent = leaf
		dm:SetAttribute("Kind", dd.Kind)
		dm:SetAttribute("Outward", v3(dd.Outward)) -- building-local; Hinge shares the building's rotation
		CollectionService:AddTag(dm, "NC_Door")
		dm.Parent = doors
	end
	for i, g in d.Garages do
		local gm = Instance.new("Model")
		gm.Name = "GarageDoor" .. i
		local a, b = Vector3.new(g.Box[1], g.Box[2], g.Box[3]), Vector3.new(g.Box[4], g.Box[5], g.Box[6])
		local top = invisiblePart("Top", Vector3.new(0.2, 0.2, 0.2), cf * CFrame.new((a.X + b.X) / 2, b.Y, (a.Z + b.Z) / 2), false)
		top.Parent = gm
		gm.PrimaryPart = top
		for _, pn in g.Pieces do
			local mp = byPiece[pn]
			if mp then
				mp.Parent = gm
			end
		end
		local slab = invisiblePart("Leaf", b - a, cf * CFrame.new((a + b) / 2), true)
		slab.Parent = gm
		gm:SetAttribute("Height", b.Y - a.Y)
		CollectionService:AddTag(gm, "NC_GarageDoor")
		gm.Parent = doors
	end
	-- windows: the lower sash slides up (HouseInteractables, tag NC_Window); the prompt sits just inside the glass
	local windows = Instance.new("Folder")
	windows.Name = "Windows"
	windows.Parent = out
	for i, w in d.Windows or {} do
		local wm = Instance.new("Model")
		wm.Name = "Window" .. i
		local sash = Instance.new("Model")
		sash.Name = "Sash"
		sash.Parent = wm
		for _, pn in w.Pieces do
			local mp = byPiece[pn]
			if mp then
				mp.Parent = sash
			end
		end
		local a, b = Vector3.new(w.Box[1], w.Box[2], w.Box[3]), Vector3.new(w.Box[4], w.Box[5], w.Box[6])
		local c = (a + b) / 2 + v3(w.Inward) * 0.8
		invisiblePart("Prompt", Vector3.new(0.4, 0.4, 0.4), cf * CFrame.new(c), false).Parent = wm
		wm:SetAttribute("Slide", w.Slide)
		CollectionService:AddTag(wm, "NC_Window")
		wm.Parent = windows
	end
	-- room lights: one per ceiling, all on one switch by the front door (HouseInteractables, tag NC_Light)
	local lights = Instance.new("Folder")
	lights.Name = "Lights"
	lights.Parent = out
	local front = nil
	for _, dd in d.Doors do
		if dd.Kind == "front" then
			front = dd
			break
		end
	end
	for i, p in d.CeilingLights or {} do
		local lm = Instance.new("Model")
		lm.Name = "CeilingLight" .. i
		local bulb = Instance.new("Part")
		bulb.Name = "Bulb"
		bulb.Shape = Enum.PartType.Cylinder
		bulb.Size = Vector3.new(0.3, 2.2, 2.2)
		bulb.CFrame = cf * CFrame.new(v3(p)) * CFrame.Angles(0, 0, math.rad(90))
		bulb.Anchored = true
		bulb.CanCollide = false
		bulb.Material = M.SmoothPlastic
		bulb.Color = Color3.fromRGB(235, 232, 225)
		bulb.Parent = lm
		lm:SetAttribute("Group", "House")
		lm:SetAttribute("Range", 26)
		if i == 1 and front then
			-- the switch plate: inside, beside the front door's hinge
			local hinge = v3(front.Hinge)
			local inward = -v3(front.Outward)
			local along = Vector3.yAxis:Cross(inward).Unit
			local at = hinge + inward * 0.6 + along * (front.HingeAtStart and -1.2 or 1.2) + Vector3.new(0, 4.4, 0)
			local plate = invisiblePart("Prompt", Vector3.new(0.5, 0.8, 0.5), cf * CFrame.new(at), false)
			plate.Transparency = 0
			plate.Material = M.SmoothPlastic
			plate.Color = Color3.fromRGB(245, 245, 240)
			plate.Parent = lm
		else
			lm:SetAttribute("NoSwitch", true)
		end
		CollectionService:AddTag(lm, "NC_Light")
		lm.Parent = lights
	end
	-- porch / coach / lantern lights: on at dusk, off at dawn (tag NC_NightLight)
	local night = Instance.new("Folder")
	night.Name = "NightLights"
	night.Parent = out
	for _, key in { "lights" } do
		local list = d.Notes[key]
		if typeof(list) == "table" and typeof(list[1]) == "table" then
			for _, p in list do
				local a = Instance.new("Attachment")
				a.Name = "Lantern"
				a.Position = v3(p)
				a.Parent = root
				local l = Instance.new("PointLight")
				l.Color = Color3.fromRGB(255, 214, 160)
				l.Range = 16
				l.Brightness = 1.3
				l.Enabled = false
				l.Parent = a
				local ref = Instance.new("ObjectValue")
				ref.Name = "Light"
				ref.Value = l
				ref.Parent = night
			end
		end
	end
	CollectionService:AddTag(night, "NC_NightLight")
	if typeof(d.Notes.pool) == "table" and d.Notes.pool.Min then
		waterVolume(cf, d.Notes.pool, out) -- the caged pool is swimmable
	end
	-- the office tower's express elevator (Elevator script builds the car, doors and paid call panels)
	local el = d.Notes.elevator
	if typeof(el) == "table" and el.Stop0 then
		local er = invisiblePart("ElevatorRoot", Vector3.new(1, 1, 1), cf, false)
		for _, k in { "Stop0", "Stop1", "DoorX", "DoorZ0", "DoorZ1", "DoorH" } do
			er:SetAttribute(k, el[k])
		end
		for _, k in { "CarMin", "CarMax", "ShaftMin", "ShaftMax", "Call0", "Call1" } do
			er:SetAttribute(k, v3(el[k]))
		end
		CollectionService:AddTag(er, "NC_Elevator")
		er.Parent = out
	end
	-- parachute kiosks (ParachuteService puts the "Buy parachute" prompt on these)
	if typeof(d.Notes.parachuteShop) == "table" then
		for i, p in d.Notes.parachuteShop do
			local sp = invisiblePart("ParachuteShop" .. i, Vector3.new(1.2, 1.2, 1.2), cf * CFrame.new(v3(p)), false)
			CollectionService:AddTag(sp, "NC_ParachuteShop")
			sp.Parent = out
		end
	end
	local markers = Instance.new("Folder")
	markers.Name = "Markers"
	markers.Parent = out
	for k, v in d.Notes do
		if typeof(v) == "table" and #v == 3 and typeof(v[1]) == "number" then
			local a = Instance.new("Attachment")
			a.Name = k
			a.Position = v3(v)
			a.Parent = root
		end
	end
	out.Parent = model.Parent
	model:Destroy()
	return out
end

-- Interactive furniture from HomeProps.glb: splits the inserted model into one Model per prop (CeilingFan, FloorLamp,
-- TV, Closet, KitchenSink, CarPanel), names the moving pieces (Blades, Bulb, Screen, DoorL, DoorR), adds the sink's
-- Spout, tags each for HouseInteractables, and returns { [propName] = template } (put them in ServerStorage).
local PROP_MAT = {
	Body = { M.SmoothPlastic, Color3.fromRGB(232, 226, 214) }, Blades = { M.Wood, Color3.fromRGB(120, 80, 48) },
	Bulb = { M.SmoothPlastic, Color3.fromRGB(240, 236, 226) }, Screen = { M.SmoothPlastic, Color3.fromRGB(12, 12, 16) },
	Frame = { M.SmoothPlastic, Color3.fromRGB(20, 20, 22) }, DoorL = { M.Wood, Color3.fromRGB(160, 116, 78) },
	DoorR = { M.Wood, Color3.fromRGB(160, 116, 78) }, Counter = { M.Marble, Color3.fromRGB(232, 228, 220) },
	Basin = { M.Metal, Color3.fromRGB(178, 182, 186) }, Faucet = { M.Metal, Color3.fromRGB(205, 205, 210) },
	Shade = { M.Fabric, Color3.fromRGB(240, 232, 214) }, Cabinet = { M.Wood, Color3.fromRGB(78, 108, 128) },
	Wood = { M.Wood, Color3.fromRGB(108, 78, 52) }, Metal = { M.Metal, Color3.fromRGB(45, 45, 50) },
}
function Kit.PrepareProps(model, parent)
	local info = Data._HomeProps or {}
	local groups = {}
	for _, p in model:GetDescendants() do
		if p:IsA("MeshPart") then
			local propName, role
			local cur = p
			while cur and not propName do
				propName, role = cur.Name:match("^(%a+)_(%a+)")
				cur = cur.Parent
			end
			if propName and info[propName] then
				groups[propName] = groups[propName] or {}
				table.insert(groups[propName], { part = p, role = role })
			end
		end
	end
	local out = {}
	for propName, list in groups do
		local e = info[propName]
		local m = Instance.new("Model")
		m.Name = propName
		local parts = {}
		for _, it in list do
			table.insert(parts, it.part)
		end
		local mn, mx = worldAABB(parts)
		-- origin: the prop's Blender origin (floor centre; the fan's is at the ceiling)
		local origin = Vector3.new((mn.X + mx.X) / 2, propName == "CeilingFan" and mx.Y or mn.Y, (mn.Z + mx.Z) / 2)
		local root = invisiblePart("Root", Vector3.new(0.5, 0.5, 0.5), CFrame.new(origin), false)
		root.Parent = m
		m.PrimaryPart = root
		for _, it in list do
			local p, role = it.part, it.role
			local mat = PROP_MAT[role]
			if mat then
				p.Material, p.Color = mat[1], mat[2]
			end
			p.Name = role
			p.Anchored = true
			p.CanCollide = role ~= "Bulb" and role ~= "Blades" and role ~= "Screen"
			p.Parent = m
		end
		if e.Spout then
			-- Spout is relative to the prop origin in Blender terms; the faucet tip sits above the basin
			local a = Instance.new("Attachment")
			a.Name = "Spout"
			a.Position = Vector3.new(e.Spout[1], e.Spout[2], e.Spout[3])
			a.Parent = root
		end
		if e.ScreenFace then
			m:SetAttribute("ScreenFace", e.ScreenFace)
		end
		for _, tag in e.Tags do
			CollectionService:AddTag(m, tag)
		end
		m.Parent = parent
		out[propName] = m
	end
	model:Destroy()
	return out
end

-- Half court (the StreetProps "HalfCourt" pieces) -> a working court. Finds the slab and the backboard, so it works
-- however the court was turned; Root sits on the court's top centre with -Z toward the hoop. Puts the RimCenter /
-- BallSpawn / BoardCenter points from the Blender notes, gives the slab a regulation bounce and tags NC_Hoop; the
-- Basketball script then builds the exact steel rim, the glass and the ball. Returns the court Model (not destroying
-- the import model, which may hold the other street props too).
local COURT_MAT = {
	Court = { M.Concrete, Color3.fromRGB(52, 112, 78) },
	Paint = { M.SmoothPlastic, Color3.fromRGB(244, 244, 238) },
	KeyPaint = { M.Concrete, Color3.fromRGB(40, 86, 142) },
	Concrete = { M.Concrete, Color3.fromRGB(160, 160, 155) },
	Metal = { M.Metal, Color3.fromRGB(40, 40, 44) },
	Backboard = { M.Glass, Color3.fromRGB(226, 234, 240), 0.4 },
	Rim = { M.Metal, Color3.fromRGB(222, 80, 34) },
	Net = { M.Fabric, Color3.fromRGB(246, 246, 246) },
}
function Kit.PrepareHalfCourt(model, parent)
	local c = Data._HalfCourt
	assert(c, "BuildingKit: no _HalfCourt data (re-run make_kit_data.py after build_props.py)")
	local list, slab, board = {}, nil, nil
	for _, p in model:GetDescendants() do
		if p:IsA("MeshPart") then
			local role = pieceName(p, "HalfCourt")
			if role then
				role = role:gsub("%d+$", "")
				table.insert(list, { part = p, role = role })
				if role == "Court" then
					slab = p
				elseif role == "Backboard" then
					board = p
				end
			end
		end
	end
	assert(slab and board, "BuildingKit: no HalfCourt_Court / HalfCourt_Backboard pieces in " .. model:GetFullName())
	local mn, mx = worldAABB({ slab })
	local top = Vector3.new((mn.X + mx.X) / 2, mx.Y, (mn.Z + mx.Z) / 2)
	local toBoard = board.Position - top
	local fwd = Vector3.new(toBoard.X, 0, toBoard.Z).Unit
	local m = Instance.new("Model")
	m.Name = "HalfCourt"
	local root = invisiblePart("Root", Vector3.new(1, 1, 1), CFrame.lookAt(top, top + fwd), false)
	root.Parent = m
	m.PrimaryPart = root
	for _, it in list do
		local p, role = it.part, it.role
		local mat = COURT_MAT[role]
		if mat then
			p.Material, p.Color = mat[1], mat[2]
			p.Transparency = mat[3] or 0
		end
		p.Name = role
		p.Anchored = true
		-- slab, footing and pole collide as they are (simple solids); the rim, glass and net are rebuilt exactly
		p.CanCollide = role == "Court" or role == "Concrete" or role == "Metal"
		p.CanQuery = p.CanCollide
		p.CastShadow = role ~= "Paint" and role ~= "KeyPaint"
		p.Parent = m
	end
	-- regulation bounce on the court (a ball dropped from 6 ft comes back ~4.4 ft); the weight makes it win
	slab.CustomPhysicalProperties = PhysicalProperties.new(2.4, 0.7, 0.85, 1, 100)
	local function point(name, t)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = v3(t)
		a.Parent = root
		return a
	end
	point("RimCenter", c.Rim)
	point("BallSpawn", c.BallSpawn)
	point("BoardCenter", c.Board)
	m:SetAttribute("RimRadius", c.RimRadius)
	m:SetAttribute("ThreeRadius", c.ThreeRadius)
	m:SetAttribute("BoardSize", v3(c.BoardSize))
	CollectionService:AddTag(m, "NC_Hoop")
	m.Parent = parent or workspace
	return m
end

-- Pieces of one prop in an imported lineup model (e.g. Pool.glb holds BackyardPool_* and UnicornFloaty_*).
local function propPieces(model, prop)
	local list = {}
	for _, p in model:GetDescendants() do
		if p:IsA("MeshPart") then
			local role = pieceName(p, prop)
			if role then
				table.insert(list, { part = p, role = role:gsub("%d+$", "") })
			end
		end
	end
	return list
end

-- Removes the ground where an in-ground pool goes: terrain is carved to air; a ground Part is cut with
-- SubtractAsync (anchored parts at least 40 studs across that the pit overlaps).
function Kit.CutGround(cf, size)
	workspace.Terrain:FillBlock(cf, size, Enum.Material.Air)
	local params = OverlapParams.new()
	for _, g in workspace:GetPartBoundsInBox(cf, size, params) do
		if g:IsA("BasePart") and g.Anchored and not g:IsA("MeshPart") and math.max(g.Size.X, g.Size.Z) >= 40 then
			local neg = Instance.new("Part")
			neg.Anchored = true
			neg.CFrame = cf
			neg.Size = size
			local ok, res = pcall(function()
				return g:SubtractAsync({ neg })
			end)
			neg:Destroy()
			if ok and res then
				res.CFrame, res.Anchored, res.Name = g.CFrame, true, g.Name
				res.UsePartColor = true
				res.Color, res.Material = g.Color, g.Material
				res.Parent = g.Parent
				g:Destroy()
			end
		end
	end
end

-- Dig the ground out under every pool in a placed model (call it after Kit.Place / PivotTo): the backyard pool's
-- basin and the Florida ranch's caged pool both sit below ground level.
function Kit.CutPools(model)
	for _, w in model:GetDescendants() do
		if w:IsA("BasePart") and CollectionService:HasTag(w, "NC_Water") then
			Kit.CutGround(w.CFrame * CFrame.new(0, 0.15, 0), w.Size + Vector3.new(1.2, 0.3, 1.2))
		end
	end
end

-- Backyard pool (Pool.glb "BackyardPool" pieces) -> a working pool: materials, colliders (the sloped floor as
-- rotated slabs), the swimmable water volume, the springboard as its own model that flexes (tag NC_DivingBoard),
-- underwater lights that come on at night. Returns the pool Model; Root is the Blender origin (middle of the
-- deck's house-side edge, ground level; the pool lies toward Root's -Z). cutGround: also dig the pit here.
local POOL_MAT = {
	Pavers = { M.Pavement, Color3.fromRGB(214, 194, 162) }, PaverBorder = { M.Pavement, Color3.fromRGB(178, 154, 122) },
	Coping = { M.Limestone, Color3.fromRGB(230, 220, 198) }, PoolPlaster = { M.Plaster, Color3.fromRGB(206, 234, 246) },
	PoolTile = { M.CeramicTiles, Color3.fromRGB(32, 108, 158) }, Water = { M.Glass, Color3.fromRGB(70, 175, 225), 0.55 },
	Rail = { M.Metal, Color3.fromRGB(222, 224, 228) }, Stand = { M.SmoothPlastic, Color3.fromRGB(220, 212, 192) },
	Board = { M.SmoothPlastic, Color3.fromRGB(238, 242, 246) }, BoardTread = { M.Sand, Color3.fromRGB(204, 184, 140) },
	Lamp = { M.Neon, Color3.fromRGB(190, 240, 255) }, Grate = { M.Metal, Color3.fromRGB(40, 42, 46) },
	Plaque = { M.CeramicTiles, Color3.fromRGB(246, 246, 244) }, Marker = { M.SmoothPlastic, Color3.fromRGB(26, 52, 116) },
	Metal = { M.Metal, Color3.fromRGB(45, 45, 50) }, Rock = { M.Rock, Color3.fromRGB(150, 140, 126) },
}
function Kit.PreparePool(model, parent, cutGround)
	local d = Data._Pool
	assert(d, "BuildingKit: no _Pool data (run build_pool.py, then make_kit_data.py)")
	local list = propPieces(model, "BackyardPool")
	assert(#list > 0, "BuildingKit: no BackyardPool_* pieces in " .. model:GetFullName())
	local parts = {}
	for _, it in list do
		table.insert(parts, it.part)
	end
	local origin = worldAABB(parts) - v3(d.Extents.Min)
	local out = Instance.new("Model")
	out.Name = "BackyardPool"
	local root = invisiblePart("Root", Vector3.new(1, 1, 1), CFrame.new(origin), false)
	root.Parent = out
	out.PrimaryPart = root
	local cf = root.CFrame
	local meshes = Instance.new("Folder")
	meshes.Name = "Meshes"
	meshes.Parent = out
	local byRole = {}
	for _, it in list do
		local p, role = it.part, it.role
		local m = POOL_MAT[role]
		if m then
			p.Material, p.Color, p.Transparency = m[1], m[2], m[3] or 0
		end
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
		p.CastShadow = role ~= "Water"
		p.Name = role
		p.Parent = meshes
		byRole[role] = p
	end
	local cols = Instance.new("Folder")
	cols.Name = "Colliders"
	cols.Parent = out
	for _, c in d.Colliders do
		local a, b = Vector3.new(c[1], c[2], c[3]), Vector3.new(c[4], c[5], c[6])
		invisiblePart(c[7], b - a, cf * CFrame.new((a + b) / 2), true).Parent = cols
	end
	for _, s in d.Slopes do -- the pool floor: shallow end, the break down to the diving well, the spoon
		invisiblePart("poolfloor", v3(s.Size), cf * CFrame.new(v3(s.Center)) * CFrame.Angles(0, 0, s.AngleZ), true).Parent = cols
	end
	waterVolume(cf, d.Water, out)
	if d.Spa then
		-- the raised spa is its own (higher) water; PoolClient takes the highest surface where volumes overlap
		local spa = waterVolume(cf, d.Spa, out)
		spa.Name = "SpaWater"
		spa:SetAttribute("Spa", true)
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Rate = 40
		pe.Lifetime = NumberRange.new(0.4, 0.9)
		pe.Speed = NumberRange.new(0.5, 1.5)
		pe.SpreadAngle = Vector2.new(25, 25)
		pe.Size = NumberSequence.new(0.18, 0.05)
		pe.Transparency = NumberSequence.new(0.3, 1)
		pe.Color = ColorSequence.new(Color3.fromRGB(235, 250, 255))
		pe.Shape = Enum.ParticleEmitterShape.Box
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		pe.Parent = spa                    -- the box shape covers the spa; jets bubble across the surface
		pe.EmissionDirection = Enum.NormalId.Top
	end
	if d.Waterfall then
		local wf = Instance.new("Attachment")
		wf.Name = "Waterfall"
		local wp = v3(d.Waterfall.Pos)
		wf.Position = Vector3.new(wp.X, d.Waterfall.Top, wp.Z)          -- at the lip stone
		wf.Parent = root
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
		pe.Rate = 60
		pe.Lifetime = NumberRange.new(0.5, 0.7)
		pe.Speed = NumberRange.new(1, 2)
		pe.Acceleration = Vector3.new(0, -30, 0)
		pe.Size = NumberSequence.new(0.6, 1.4)
		pe.Transparency = NumberSequence.new(0.5, 1)
		pe.Color = ColorSequence.new(Color3.fromRGB(240, 250, 255))
		pe.Parent = wf
		local s = Instance.new("Sound")
		s.SoundId = "rbxasset://sounds/action_swim.mp3"
		s.Looped = true
		s.Volume = 0.35
		s.PlaybackSpeed = 0.7
		s.RollOffMaxDistance = 60
		s.Playing = true
		s.Parent = wf
	end
	-- springboard: pivots at its anchor bracket; PoolClient flexes it under divers (everyone sees it bounce)
	local bd = d.Board
	local hinge, tip = v3(bd.Hinge), v3(bd.Tip)
	local bm = Instance.new("Model")
	bm.Name = "DivingBoard"
	local flatTip = Vector3.new(tip.X, hinge.Y, tip.Z)
	local pivot = invisiblePart("Pivot", Vector3.new(0.3, 0.3, 0.3), cf * CFrame.lookAt(hinge, flatTip), false)
	pivot.Parent = bm
	bm.PrimaryPart = pivot
	for _, role in bd.Pieces do
		local mp = byRole[role]
		if mp then
			mp.Parent = bm
		end
	end
	local a, b = Vector3.new(bd.Collider[1], bd.Collider[2], bd.Collider[3]), Vector3.new(bd.Collider[4], bd.Collider[5], bd.Collider[6])
	local bc = invisiblePart("BoardCollider", b - a, cf * CFrame.new((a + b) / 2), true)
	bc.CustomPhysicalProperties = PhysicalProperties.new(1.5, 0.9, 0.3, 2, 1) -- grippy tread
	bc.Parent = bm
	bm:SetAttribute("Length", (flatTip - hinge).Magnitude) -- anchor to tip: how far out a diver stands
	bm:SetAttribute("Width", bd.Width)
	CollectionService:AddTag(bm, "NC_DivingBoard")
	bm.Parent = out
	-- underwater lights (aqua spots into the pool), switched with the porch lights at dusk
	local night = Instance.new("Folder")
	night.Name = "NightLights"
	night.Parent = out
	for _, l in d.Lights do
		local at = Instance.new("Attachment")
		at.Name = "PoolLight"
		at.CFrame = CFrame.lookAt(v3(l.Pos), v3(l.Pos) + v3(l.Dir))
		at.Parent = root
		local s = Instance.new("SpotLight")
		s.Face = Enum.NormalId.Front
		s.Angle = 100
		s.Range = 26
		s.Brightness = 3
		s.Color = Color3.fromRGB(130, 225, 255)
		s.Enabled = false
		s.Parent = at
		local ref = Instance.new("ObjectValue")
		ref.Name = "Light"
		ref.Value = s
		ref.Parent = night
	end
	CollectionService:AddTag(night, "NC_NightLight")
	out.Parent = parent or workspace
	if cutGround then
		local ca, cb = v3(d.Cut.Min), v3(d.Cut.Max)
		Kit.CutGround(cf * CFrame.new((ca + cb) / 2), cb - ca)
	end
	return out
end

-- Unicorn floaty (Pool.glb "UnicornFloaty" pieces) -> one unanchored Model on a Body part at the ring centre.
-- PoolService gives it its colliders (a ring you can drop through), buoyancy, drift and the jump-through fun.
local FLOAT_MAT = {
	Vinyl = Color3.fromRGB(250, 246, 252), FloatPink = Color3.fromRGB(255, 178, 208), Eye = Color3.fromRGB(16, 14, 20),
	Horn = Color3.fromRGB(255, 204, 92), ManePink = Color3.fromRGB(255, 134, 190), ManeOrange = Color3.fromRGB(255, 174, 98),
	ManeYellow = Color3.fromRGB(255, 230, 110), ManeMint = Color3.fromRGB(134, 230, 180), ManeSky = Color3.fromRGB(124, 190, 255),
	ManeLavender = Color3.fromRGB(184, 150, 245),
}
function Kit.PrepareFloaty(model, parent)
	local d = Data._Floaty
	assert(d, "BuildingKit: no _Floaty data (run build_pool.py, then make_kit_data.py)")
	local list = propPieces(model, "UnicornFloaty")
	assert(#list > 0, "BuildingKit: no UnicornFloaty_* pieces in " .. model:GetFullName())
	local parts = {}
	for _, it in list do
		table.insert(parts, it.part)
	end
	local origin = worldAABB(parts) - v3(d.Extents.Min)
	local out = Instance.new("Model")
	out.Name = "UnicornFloaty"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(1, 1, 1)
	body.CFrame = CFrame.new(origin)
	body.Transparency = 1
	body.CanCollide, body.CanTouch, body.CanQuery = false, false, false
	body.CustomPhysicalProperties = PhysicalProperties.new(0.1, 0.3, 0.5)
	body.Parent = out
	out.PrimaryPart = body
	for _, it in list do
		local p = it.part
		p.Material = it.role == "Horn" and M.Metal or M.SmoothPlastic
		p.Color = FLOAT_MAT[it.role] or p.Color
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, false, true
		p.Name = it.role
		p.Parent = out
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = body, p
		w.Parent = p
	end
	out:SetAttribute("RingRadius", d.RingRadius)
	out:SetAttribute("TubeRadius", d.TubeRadius)
	out:SetAttribute("HoleRadius", d.HoleRadius)
	out:SetAttribute("NeckMin", v3(d.NeckMin))
	out:SetAttribute("NeckMax", v3(d.NeckMax))
	CollectionService:AddTag(out, "NC_Floaty")
	out.Parent = parent or workspace
	return out
end

-- Parachute.glb (build_parachute.py): splits the import into the Canopy (PrimaryPart "Harness" = the riser
-- attachment point on the jumper's upper back) and the Pack (PrimaryPart "Body" = the container's centre), both
-- facing -Z like a character, unanchored, massless and non-colliding, and stores them in
-- ReplicatedStorage.ParachuteAssets, where ParachuteClient clones them (it builds its own from parts until then).
local CHUTE_MAT = {
	CanopyA = { M.Fabric, Color3.fromRGB(18, 18, 22) }, CanopyB = { M.Fabric, Color3.fromRGB(255, 56, 158) },
	CanopyC = { M.Fabric, Color3.fromRGB(26, 216, 216) }, Lines = { M.SmoothPlastic, Color3.fromRGB(225, 225, 214) },
	Risers = { M.Fabric, Color3.fromRGB(26, 26, 30) }, Slider = { M.Fabric, Color3.fromRGB(50, 50, 56) },
	PackBody = { M.Fabric, Color3.fromRGB(36, 38, 44) }, PackTrim = { M.Neon, Color3.fromRGB(255, 56, 158) },
	Strap = { M.Fabric, Color3.fromRGB(20, 20, 24) }, Handle = { M.SmoothPlastic, Color3.fromRGB(242, 190, 26) },
}
function Kit.PrepareParachute(model)
	local d = Data._Parachute
	assert(d, "BuildingKit: no _Parachute data (run build_parachute.py, then make_kit_data.py)")
	local yaw = Kit.FixYaw.Parachute or 0
	if yaw ~= 0 then
		model:PivotTo(model:GetPivot() * CFrame.Angles(0, math.rad(yaw), 0))
	end
	local RS = game:GetService("ReplicatedStorage")
	local folder = RS:FindFirstChild("ParachuteAssets") or Instance.new("Folder")
	folder.Name = "ParachuteAssets"
	folder.Parent = RS
	local made = {}
	-- Blender front is -Y, which lands on the import's +Z: the roots turn half round so their -Z is the jumper's front
	for _, spec in { { "Canopy", "Canopy", "Harness", Vector3.zero }, { "ParachutePack", "Pack", "Body", v3(d.ParachutePack.Center) } } do
		local prop, name, rootName, centre = spec[1], spec[2], spec[3], spec[4]
		local info = d[prop]
		local list = propPieces(model, prop)
		assert(#list > 0, "BuildingKit: no " .. prop .. "_* pieces in " .. model:GetFullName())
		local parts = {}
		for _, it in list do
			table.insert(parts, it.part)
		end
		local origin = worldAABB(parts) - v3(info.Extents.Min)
		local out = Instance.new("Model")
		out.Name = name
		local root = Instance.new("Part")
		root.Name = rootName
		root.Size = Vector3.one * 0.2
		root.Transparency = 1
		root.CFrame = CFrame.new(origin + centre) * CFrame.Angles(0, math.pi, 0)
		root.Anchored, root.CanCollide, root.CanTouch, root.CanQuery, root.Massless = false, false, false, false, true
		root.Parent = out
		out.PrimaryPart = root
		for _, it in list do
			local p = it.part
			local m = CHUTE_MAT[it.role]
			if m then
				p.Material, p.Color = m[1], m[2]
			end
			p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, false, true
			p.CastShadow = name == "Canopy"
			p.Name = it.role
			p.Parent = out
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = root, p
			w.Parent = p
		end
		local old = folder:FindFirstChild(name)
		if old then
			old:Destroy()
		end
		out.Parent = folder
		made[name] = out
	end
	model:Destroy()
	return made
end

-- A recoloured copy at cf (cf = where the Blender origin goes: ground level, building front toward cf's -Z after FixYaw)
function Kit.Place(template, cf, schemeIndex, parent)
	local b = template:Clone()
	b:PivotTo(cf)
	local s = schemeIndex and Kit.Schemes[(schemeIndex - 1) % #Kit.Schemes + 1]
	if s then
		for _, p in b:GetDescendants() do
			if p:IsA("MeshPart") then
				local base = p.Name:gsub("%d+$", "")
				if s[base] then
					p.Color = s[base]
				end
			end
		end
	end
	b.Parent = parent or workspace
	return b
end

return Kit
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">BuildingKitData</string><ProtectedString name="Source"><![CDATA[-- BuildingKitData: generated by make_kit_data.py from the Blender exports. Do not hand-edit; re-run it.
-- Roblox-local studs for each building model (origin = the Blender origin, ground at Y = 0; Roblox (X, Y, Z) = Blender (x, z, -y)).
-- Colliders: {x0, y0, z0, x1, y1, z1, tag}. Doors: hinge point, the leaf's box, which way is outside, the mesh pieces that swing.
return {
	DecoHotel = {
		CeilingLights = {
			{5.925, 14.55, -0.0},
			{-27.3, 14.55, 9.275},
			{5.925, 26.55, -0.0},
