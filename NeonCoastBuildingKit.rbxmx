]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX3"><Properties><string name="Name">BuildingDoors</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- BuildingDoors: runs every Blender-built door. NC_Door models swing 95 degrees on their hinge, away from whoever
-- opened them, and close by themselves after a while. NC_GarageDoor models roll up flat under the garage ceiling.
-- Works on doors added at any time (houses streamed in, placed later).
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local SWING = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local ROLL = TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
local AUTO_CLOSE = 12

local function animate(model, closed, from, to, info, make)
	local v = Instance.new("NumberValue")
	v.Value = from
	local conn = v.Changed:Connect(function(x)
		model:PivotTo(closed * make(x))
	end)
	local tw = TweenService:Create(v, info, { Value = to })
	tw:Play()
	tw.Completed:Wait()
	conn:Disconnect()
	v:Destroy()
end

local function hookDoor(dm)
	local hinge = dm.PrimaryPart
	local leaf = dm:FindFirstChild("Leaf")
	local prompt = leaf and leaf:FindFirstChildOfClass("ProximityPrompt")
	if not (hinge and prompt) then
		return
	end
	local closed = dm:GetPivot()
	local angle = 0
	local busy = false
	local token = 0
	local function setAngle(target)
		busy = true
		local rot = function(a)
			return CFrame.Angles(0, math.rad(a), 0)
		end
		animate(dm, closed, angle, target, SWING, rot)
		angle = target
		prompt.ActionText = angle == 0 and "Open" or "Close"
		busy = false
	end
	prompt.Triggered:Connect(function(player)
		if busy then
			return
		end
		if angle ~= 0 then
			setAngle(0)
			return
		end
		-- swing away from the player: try both ways and keep the one that moves the leaf away from them
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local c = closed:PointToObjectSpace(leaf.Position)
		local best, bestScore = 95, -math.huge
		for _, a in { 95, -95 } do
			local moved = closed:PointToWorldSpace(CFrame.Angles(0, math.rad(a), 0) * c) - leaf.Position
			local score = hrp and -moved:Dot((hrp.Position - leaf.Position).Unit) or a
			if score > bestScore then
				best, bestScore = a, score
			end
		end
		setAngle(best)
		token += 1
		local my = token
		task.delay(AUTO_CLOSE, function()
			if token == my and angle ~= 0 and not busy then
				setAngle(0)
			end
		end)
	end)
end

local function hookGarage(gm)
	local top = gm.PrimaryPart
	local leaf = gm:FindFirstChild("Leaf")
	if not (top and leaf) then
		return
	end
	local closed = gm:GetPivot()
	local h = gm:GetAttribute("Height") or leaf.Size.Y
	local isOpen = false
	-- the door's thin axis points out of the opening; open = turn 90 degrees about the top edge so it lies flat inside
	local thin = (leaf.Size.X < leaf.Size.Z) and Vector3.xAxis or Vector3.zAxis
	local axis = thin:Cross(Vector3.yAxis).Unit
	local bottom = closed:PointToObjectSpace(leaf.Position) - Vector3.new(0, h / 2, 0)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Open"
	pp.ObjectText = "Garage Door"
	pp.HoldDuration = 0.3
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.Parent = leaf
	-- which way is inside: the side the building's centre is on
	local building = gm:FindFirstAncestorOfClass("Model")
	local centre = building and building.PrimaryPart and building:GetBoundingBox().Position or closed.Position
	local inward = closed:VectorToObjectSpace(centre - closed.Position)
	local sign = 1
	local test = CFrame.fromAxisAngle(axis, math.rad(90)) * bottom
	if (test - bottom):Dot(inward) < 0 then
		sign = -1
	end
	local busy = false
	pp.Triggered:Connect(function()
		if busy then
			return
		end
		busy = true
		isOpen = not isOpen
		local make = function(t)
			return CFrame.fromAxisAngle(axis, math.rad(90 * sign) * t)
		end
		animate(gm, closed, isOpen and 0 or 1, isOpen and 1 or 0, ROLL, make)
		pp.ActionText = isOpen and "Close" or "Open"
		busy = false
	end)
end

for _, d in CollectionService:GetTagged("NC_Door") do
	task.spawn(hookDoor, d)
end
CollectionService:GetInstanceAddedSignal("NC_Door"):Connect(hookDoor)
for _, g in CollectionService:GetTagged("NC_GarageDoor") do
	task.spawn(hookGarage, g)
end
CollectionService:GetInstanceAddedSignal("NC_GarageDoor"):Connect(hookGarage)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX4"><Properties><string name="Name">HouseInteractables</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HouseInteractables: the little things players poke at in houses. Tag-driven (CollectionService), so any model in
-- the place can use it: Blender furniture is tagged by BuildingKit.PrepareProps, Studio furniture by hand/InteriorKit.
-- State lives in attributes on each model (they replicate), so every player sees the same lights, fans, water, TV.
--   NC_Light     parts named "Bulb" (glow when on) + any Light objects inside. Attribute Group: one switch flips
--                every light with the same Group inside the same building.
--   NC_Fan       a part named "Blades" (every client spins it) and optional "Bulb"s. Off / Low / High.
--   NC_Sink      an Attachment named "Spout": a water stream and running-water sound while on.
--   NC_Window    a part (or model) named "Sash" that slides up to open.
--   NC_TV        a part named "Screen". Power on/off; "Play" starts the TV game on the player's client (TVClient),
--                which streams its picture back here so everyone watching the TV sees the same game.
--   NC_Closet    "Change outfit" opens the Character Studio, "Gear" opens the Arms shop.
--   NC_CarPanel  "Pick a car" opens the garage list (HomeService does the rest).
--   NC_NightLight lights that switch on at dusk and off at dawn by themselves (porch, coach, street lights).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")

local Remotes = RS:WaitForChild("Remotes")
local function remote(name, class)
	local r = Remotes:FindFirstChild(name)
	if not r then
		r = Instance.new(class or "RemoteEvent")
		r.Name = name
		r.Parent = Remotes
	end
	return r
end
local HouseUI = remote("HouseUI")
local TVState = remote("TVState", "UnreliableRemoteEvent")
local TVQuit = remote("TVQuit")

local WARM = Color3.fromRGB(255, 236, 200)

local function promptPart(model)
	local p = model:FindFirstChild("Prompt", true)
	if p and p:IsA("BasePart") then
		return p
	end
	if model:IsA("BasePart") then
		return model
	end
	return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function addPrompt(model, action, object, key, hold)
	local part = promptPart(model)
	if not part then
		return nil
	end
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object or ""
	pp.HoldDuration = hold or 0
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	if key then
		pp.KeyboardKeyCode = key
		pp.UIOffset = Vector2.new(0, -72)
	end
	pp.Parent = part
	return pp
end

local function buildingOf(model)
	local cur = model.Parent
	while cur and cur ~= workspace do
		if cur:IsA("Model") and (cur:GetAttribute("Style") or cur:GetAttribute("Interior") or cur:GetAttribute("OwnerId")) then
			return cur
		end
		cur = cur.Parent
	end
	return model.Parent
end

---------------------------------------------------------------------------- lights
local function applyLight(model, on)
	for _, d in model:GetDescendants() do
		if d:IsA("Light") then
			d.Enabled = on
		elseif d:IsA("BasePart") and d.Name == "Bulb" then
			if d:GetAttribute("OffColor") == nil then
				d:SetAttribute("OffColor", d.Color)
				d:SetAttribute("OffMaterial", d.Material.Name)
			end
			d.Material = on and Enum.Material.Neon or Enum.Material[d:GetAttribute("OffMaterial")]
			d.Color = on and WARM or d:GetAttribute("OffColor")
		end
	end
end

local function ensureLight(model)
	if model:FindFirstChildWhichIsA("Light", true) then
		return
	end
	local bulb = model:FindFirstChild("Bulb", true) or promptPart(model)
	if bulb then
		local l = Instance.new("PointLight")
		l.Color = WARM
		l.Range = model:GetAttribute("Range") or 18
		l.Brightness = model:GetAttribute("Brightness") or 1.4
		l.Shadows = true
		l.Parent = bulb
	end
end

local function hookLight(model)
	ensureLight(model)
	local on = model:GetAttribute("On") == true
	applyLight(model, on)
	model:GetAttributeChangedSignal("On"):Connect(function()
		applyLight(model, model:GetAttribute("On") == true)
	end)
	if model:GetAttribute("NoSwitch") then
		return
	end
	local pp = addPrompt(model, on and "Lights off" or "Lights on", "Light", Enum.KeyCode.E)
	if not pp then
		return
	end
	pp.Triggered:Connect(function()
		local now = not (model:GetAttribute("On") == true)
		local group = model:GetAttribute("Group")
		if group then
			for _, other in CollectionService:GetTagged("NC_Light") do
				if other:GetAttribute("Group") == group and buildingOf(other) == buildingOf(model) then
					other:SetAttribute("On", now)
				end
			end
		else
			model:SetAttribute("On", now)
		end
	end)
	model:GetAttributeChangedSignal("On"):Connect(function()
		pp.ActionText = model:GetAttribute("On") and "Lights off" or "Lights on"
	end)
end

---------------------------------------------------------------------------- ceiling fans (clients spin the blades)
local FAN_TEXT = { [0] = "Fan: low", [1] = "Fan: high", [2] = "Fan: off" }
local function hookFan(model)
	model:SetAttribute("Speed", model:GetAttribute("Speed") or 0)
	local pp = addPrompt(model, FAN_TEXT[model:GetAttribute("Speed")], "Ceiling Fan", Enum.KeyCode.F)
	if not pp then
		return
	end
	pp.Triggered:Connect(function()
		local s = ((model:GetAttribute("Speed") or 0) + 1) % 3
		model:SetAttribute("Speed", s)
		pp.ActionText = FAN_TEXT[s]
	end)
end

---------------------------------------------------------------------------- sinks
local function hookSink(model)
	local spout = model:FindFirstChild("Spout", true)
	if not (spout and spout:IsA("Attachment")) then
		return
	end
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Water"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(190, 225, 255))
	pe.LightEmission = 0.3
	pe.Transparency = NumberSequence.new(0.35, 0.8)
	pe.Size = NumberSequence.new(0.18, 0.08)
	pe.Lifetime = NumberRange.new(0.25, 0.35)
	pe.Rate = 160
	pe.Speed = NumberRange.new(2.5, 3)
	pe.SpreadAngle = Vector2.new(4, 4)
	pe.EmissionDirection = Enum.NormalId.Bottom
	pe.Acceleration = Vector3.new(0, -30, 0)
	pe.Enabled = false
	pe.Parent = spout
	local snd = Instance.new("Sound")
	snd.Name = "Running"
	snd.SoundId = "rbxasset://sounds/action_swim.mp3"
	snd.Looped = true
	snd.Volume = 0.35
	snd.PlaybackSpeed = 1.6
	snd.RollOffMaxDistance = 40
	snd.Parent = spout
	local pp = addPrompt(model, "Turn on water", "Sink", Enum.KeyCode.E)
	if not pp then
		return
	end
	local function apply()
		local on = model:GetAttribute("On") == true
		pe.Enabled = on
		if on then
			snd:Play()
		else
			snd:Stop()
		end
		pp.ActionText = on and "Turn off water" or "Turn on water"
	end
	model:GetAttributeChangedSignal("On"):Connect(apply)
	apply()
	local token = 0
	pp.Triggered:Connect(function()
		model:SetAttribute("On", not model:GetAttribute("On"))
		token += 1
		local my = token
		task.delay(60, function() -- nobody leaves a tap running forever
			if token == my then
				model:SetAttribute("On", false)
			end
		end)
	end)
end

---------------------------------------------------------------------------- windows
local function hookWindow(model)
	local sash = model:FindFirstChild("Sash", true)
	if not sash then
		return
	end
	local isModel = sash:IsA("Model")
	local closed = isModel and sash:GetPivot() or sash.CFrame
	local size = isModel and select(2, sash:GetBoundingBox()) or sash.Size
	local lift = model:GetAttribute("Slide") or math.max(size.Y * 0.45, 1)
	local pp = addPrompt(model, "Open window", "Window", Enum.KeyCode.E)
	if not pp then
		return
	end
	local busy = false
	pp.Triggered:Connect(function()
		if busy then
			return
		end
		busy = true
		local open = not model:GetAttribute("Open")
		model:SetAttribute("Open", open)
		local target = closed * CFrame.new(0, open and lift or 0, 0)
		if isModel then
			local v = Instance.new("CFrameValue")
			v.Value = sash:GetPivot()
			v.Changed:Connect(function(cf)
				sash:PivotTo(cf)
			end)
			local tw = TweenService:Create(v, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Value = target })
			tw:Play()
			tw.Completed:Wait()
			v:Destroy()
		else
			local tw = TweenService:Create(sash, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { CFrame = target })
			tw:Play()
			tw.Completed:Wait()
		end
		pp.ActionText = open and "Close window" or "Open window"
		busy = false
	end)
end

---------------------------------------------------------------------------- TVs
local function hookTV(model)
	model:SetAttribute("Power", model:GetAttribute("Power") == true)
	local power = addPrompt(model, model:GetAttribute("Power") and "Turn off" or "Turn on", "TV", Enum.KeyCode.F)
	local play = addPrompt(model, "Play a game", "TV", Enum.KeyCode.E)
	if not (power and play) then
		return
	end
	power.Triggered:Connect(function()
		local on = not model:GetAttribute("Power")
		model:SetAttribute("Power", on)
		power.ActionText = on and "Turn off" or "Turn on"
		if not on then
			model:SetAttribute("PlayerId", nil)
		end
	end)
	play.Triggered:Connect(function(player)
		local current = model:GetAttribute("PlayerId")
		if current and current ~= player.UserId and Players:GetPlayerByUserId(current) then
			return -- somebody else is playing; they can watch
		end
		model:SetAttribute("Power", true)
		power.ActionText = "Turn off"
		model:SetAttribute("PlayerId", player.UserId)
		HouseUI:FireClient(player, "TV", model)
	end)
end

TVState.OnServerEvent:Connect(function(player, tv, game, state)
	if typeof(tv) ~= "Instance" or not CollectionService:HasTag(tv, "NC_TV") then
		return
	end
	if tv:GetAttribute("PlayerId") ~= player.UserId or typeof(state) ~= "string" or #state > 600 then
		return
	end
	tv:SetAttribute("Game", typeof(game) == "string" and game:sub(1, 16) or nil)
	for _, p in Players:GetPlayers() do
		if p ~= player then
			TVState:FireClient(p, tv, game, state)
		end
	end
end)
TVQuit.OnServerEvent:Connect(function(player, tv)
	if typeof(tv) == "Instance" and tv:GetAttribute("PlayerId") == player.UserId then
		tv:SetAttribute("PlayerId", nil)
		tv:SetAttribute("Game", nil)
	end
end)
Players.PlayerRemoving:Connect(function(player)
	for _, tv in CollectionService:GetTagged("NC_TV") do
		if tv:GetAttribute("PlayerId") == player.UserId then
			tv:SetAttribute("PlayerId", nil)
		end
	end
end)

---------------------------------------------------------------------------- closet, car panel
local function hookCloset(model)
	local outfit = addPrompt(model, "Change outfit", "Closet", Enum.KeyCode.E)
	local gear = addPrompt(model, "Gear", "Closet", Enum.KeyCode.F)
	if outfit then
		outfit.Triggered:Connect(function(player)
			model:SetAttribute("Open", true)
			HouseUI:FireClient(player, "Closet", model)
			task.delay(4, function()
				model:SetAttribute("Open", false)
			end)
		end)
	end
	if gear then
		gear.Triggered:Connect(function(player)
			HouseUI:FireClient(player, "Gear", model)
		end)
	end
	-- the closet doors swing open while someone is changing (any parts named DoorL / DoorR)
	local doors = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and (d.Name == "DoorL" or d.Name == "DoorR") then
			doors[d] = d.CFrame
		end
	end
	model:GetAttributeChangedSignal("Open"):Connect(function()
		local open = model:GetAttribute("Open")
		for d, base in doors do
			local s = d.Name == "DoorL" and -1 or 1
			local hinge = base * CFrame.new(s * d.Size.X / 2, 0, 0)
			-- swings out of the front (+Z for Blender props after import): left door -100 degrees, right door +100
			local target = open and (hinge * CFrame.Angles(0, math.rad(100 * s), 0) * CFrame.new(-s * d.Size.X / 2, 0, 0)) or base
			TweenService:Create(d, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { CFrame = target }):Play()
		end
	end)
end

local function hookCarPanel(model)
	local pp = addPrompt(model, "Pick a car", "Garage", Enum.KeyCode.E)
	if pp then
		pp.Triggered:Connect(function(player)
			HouseUI:FireClient(player, "Cars", model)
		end)
	end
end

---------------------------------------------------------------------------- dusk-to-dawn lights
local function isNight()
	local t = Lighting.ClockTime
	return t < 6.4 or t > 18.1
end
local nightOn = nil
local function applyNight(model)
	for _, d in model:GetDescendants() do
		if d:IsA("Light") then
			d.Enabled = isNight()
		elseif d:IsA("ObjectValue") and d.Value and d.Value:IsA("Light") then
			d.Value.Enabled = isNight() -- BuildingKit keeps the lantern lights on the building root and points here
		end
	end
end
task.spawn(function()
	while true do
		local n = isNight()
		if n ~= nightOn then
			nightOn = n
			for _, m in CollectionService:GetTagged("NC_NightLight") do
				applyNight(m)
			end
		end
		task.wait(5)
	end
end)

---------------------------------------------------------------------------- wiring
local HOOKS = {
	NC_Light = hookLight, NC_Fan = hookFan, NC_Sink = hookSink, NC_Window = hookWindow, NC_TV = hookTV,
	NC_Closet = hookCloset, NC_CarPanel = hookCarPanel, NC_NightLight = applyNight,
}
for tag, fn in HOOKS do
	for _, m in CollectionService:GetTagged(tag) do
		task.spawn(fn, m)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(fn)
end
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX5"><Properties><string name="Name">HouseClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HouseClient: the client half of HouseInteractables. Spins every ceiling fan, opens the closet / gear / car screens,
-- and runs the TV: the picture is drawn on the TV's own screen (SurfaceGui), so when you play, your camera moves in
-- front of the TV and you play on it, and everyone else in the room sees your game live on the same screen.
-- Games: 1 SNAKE, 2 PONG (vs the TV). WASD / arrows to play, Q or Backspace to stand up.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Remotes = RS:WaitForChild("Remotes")
local HouseUI = Remotes:WaitForChild("HouseUI")
local TVState = Remotes:WaitForChild("TVState")
local TVQuit = Remotes:WaitForChild("TVQuit")
local Signals = RS:WaitForChild("LocalSignals")

---------------------------------------------------------------------------- fans
local fanBase = setmetatable({}, { __mode = "k" })
local fanAngle = setmetatable({}, { __mode = "k" })
RunService.RenderStepped:Connect(function(dt)
	for _, fan in CollectionService:GetTagged("NC_Fan") do
		local blades = fan:FindFirstChild("Blades", true)
		if blades and blades:IsA("BasePart") then
			fanBase[blades] = fanBase[blades] or blades.CFrame
			local s = fan:GetAttribute("Speed") or 0
			local target = s == 2 and 11 or (s == 1 and 4.5 or 0)
			local cur = blades:GetAttribute("Spin") or 0
			cur += (target - cur) * math.min(1, dt * 1.5)          -- fans spin up and coast down
			blades:SetAttribute("Spin", cur)
			fanAngle[blades] = ((fanAngle[blades] or 0) + cur * dt) % (math.pi * 2)
			blades.CFrame = fanBase[blades] * CFrame.Angles(0, fanAngle[blades], 0)
		end
	end
end)

---------------------------------------------------------------------------- TV screens (everyone)
local W, H = 24, 14
local screens = setmetatable({}, { __mode = "k" })

local function screenOf(tv)
	local s = screens[tv]
	if s and s.gui.Parent then
		return s
	end
	local part = tv:FindFirstChild("Screen", true)
	if not (part and part:IsA("BasePart")) then
		return nil
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "TVPicture"
	gui.Face = Enum.NormalId[tv:GetAttribute("ScreenFace") or "Front"]
	gui.CanvasSize = Vector2.new(480, 280)
	gui.LightInfluence = 0
	gui.Brightness = 1.6
	gui.Parent = part
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.new(0, 0, 0)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 90, 200)
	label.Parent = bg
	local score = Instance.new("TextLabel")
	score.Size = UDim2.new(1, 0, 0, 26)
	score.BackgroundTransparency = 1
	score.Font = Enum.Font.GothamBold
	score.TextSize = 22
	score.TextColor3 = Color3.new(1, 1, 1)
	score.ZIndex = 3
	score.Parent = bg
	s = { gui = gui, bg = bg, label = label, score = score, pool = {} }
	screens[tv] = s
	return s
end

local function pixel(s, i)
	local f = s.pool[i]
	if not f then
		f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.ZIndex = 2
		f.Parent = s.bg
		s.pool[i] = f
	end
	f.Visible = true
	return f
end

local function clearPixels(s, from)
	for i = from, #s.pool do
		s.pool[i].Visible = false
	end
end

local function drawSnake(s, state)
	-- "score|food|c1,c2,..."
	local sc, food, cells = state:match("^(%d+)|(%d+)|(.*)$")
	if not sc then
		return
	end
	s.label.Text = ""
	s.score.Text = "SNAKE   " .. sc
	local n = 0
	local function cell(idx, color)
		n += 1
		local f = pixel(s, n)
		local x, y = idx % W, idx // W
		f.Position = UDim2.fromScale(x / W, (y + 1) / (H + 1))
		f.Size = UDim2.fromScale(1 / W - 0.004, 1 / (H + 1) - 0.006)
		f.BackgroundColor3 = color
	end
	cell(tonumber(food), Color3.fromRGB(255, 90, 90))
	local first = true
	for c in cells:gmatch("%d+") do
		cell(tonumber(c), first and Color3.fromRGB(150, 255, 190) or Color3.fromRGB(60, 220, 130))
		first = false
	end
	clearPixels(s, n + 1)
end

local function drawPong(s, state)
	-- "ly|ry|bx|by|ls|rs" in 0..1000
	local v = {}
	for x in state:gmatch("%-?%d+") do
		table.insert(v, tonumber(x) / 1000)
	end
	if #v < 6 then
		return
	end
	s.label.Text = ""
	s.score.Text = string.format("PONG   %d  :  %d", v[5] * 1000, v[6] * 1000)
	local function rect(i, x, y, w, h, c)
		local f = pixel(s, i)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		f.BackgroundColor3 = c
	end
	rect(1, 0.04, v[1], 0.02, 0.22, Color3.fromRGB(80, 200, 255))
	rect(2, 0.96, v[2], 0.02, 0.22, Color3.fromRGB(255, 90, 200))
	rect(3, v[3], v[4], 0.025, 0.04, Color3.new(1, 1, 1))
	clearPixels(s, 4)
end

local function idle(tv)
	local s = screenOf(tv)
	if not s then
		return
	end
	clearPixels(s, 1)
	s.score.Text = ""
	if tv:GetAttribute("Power") then
		s.bg.BackgroundColor3 = Color3.fromRGB(20, 10, 40)
		s.label.Text = "NEON COAST TV"
	else
		s.bg.BackgroundColor3 = Color3.new(0, 0, 0)
		s.label.Text = ""
	end
end

local function hookTV(tv)
	idle(tv)
	tv:GetAttributeChangedSignal("Power"):Connect(function()
		idle(tv)
	end)
	tv:GetAttributeChangedSignal("PlayerId"):Connect(function()
		if not tv:GetAttribute("PlayerId") then
			idle(tv)
		end
	end)
end
for _, tv in CollectionService:GetTagged("NC_TV") do
	task.spawn(hookTV, tv)
end
CollectionService:GetInstanceAddedSignal("NC_TV"):Connect(hookTV)

TVState.OnClientEvent:Connect(function(tv, gameName, state)
	local s = tv and screenOf(tv)
	if not s then
		return
	end
	s.bg.BackgroundColor3 = Color3.fromRGB(8, 8, 14)
	if gameName == "Snake" then
		drawSnake(s, state)
	elseif gameName == "Pong" then
		drawPong(s, state)
	end
end)

---------------------------------------------------------------------------- playing (you)
local playing = nil -- { tv, game, ... }
local held = {}
UIS.InputBegan:Connect(function(input, gp)
	held[input.KeyCode] = true
	if not playing then
		return
	end
	local k = input.KeyCode
	if k == Enum.KeyCode.Q or k == Enum.KeyCode.Backspace then
		playing.quit = true
	elseif playing.menu and (k == Enum.KeyCode.One or k == Enum.KeyCode.KeypadOne) then
		playing.choose = "Snake"
	elseif playing.menu and (k == Enum.KeyCode.Two or k == Enum.KeyCode.KeypadTwo) then
		playing.choose = "Pong"
	elseif playing.game == "Snake" then
		local d = (k == Enum.KeyCode.W or k == Enum.KeyCode.Up) and Vector2.new(0, -1)
			or (k == Enum.KeyCode.S or k == Enum.KeyCode.Down) and Vector2.new(0, 1)
			or (k == Enum.KeyCode.A or k == Enum.KeyCode.Left) and Vector2.new(-1, 0)
			or (k == Enum.KeyCode.D or k == Enum.KeyCode.Right) and Vector2.new(1, 0)
		if d and d ~= -playing.dir then
			playing.nextDir = d
		end
	end
end)
UIS.InputEnded:Connect(function(input)
	held[input.KeyCode] = nil
end)

local function send(tv, name, state)
	TVState:FireServer(tv, name, state)
	local s = screenOf(tv)
	if s then
		s.bg.BackgroundColor3 = Color3.fromRGB(8, 8, 14)
		if name == "Snake" then
			drawSnake(s, state)
		else
			drawPong(s, state)
		end
	end
end

local function runSnake(p)
	p.game, p.dir, p.nextDir = "Snake", Vector2.new(1, 0), Vector2.new(1, 0)
	local body = { Vector2.new(6, 7), Vector2.new(5, 7), Vector2.new(4, 7) }
	local function freeCell()
		while true do
			local c = Vector2.new(math.random(0, W - 1), math.random(0, H - 1))
			local hit = false
			for _, b in body do
				if b == c then
					hit = true
				end
			end
			if not hit then
				return c
			end
		end
	end
	local food, score, step = freeCell(), 0, 0.14
	while not p.quit do
		task.wait(step)
		p.dir = p.nextDir
		local head = body[1] + p.dir
		local dead = head.X < 0 or head.Y < 0 or head.X >= W or head.Y >= H
		for i = 1, #body - 1 do
			if body[i] == head then
				dead = true
			end
		end
		if dead then
			body = { Vector2.new(6, 7), Vector2.new(5, 7), Vector2.new(4, 7) }
			p.dir, p.nextDir, score, step = Vector2.new(1, 0), Vector2.new(1, 0), 0, 0.14
		else
			table.insert(body, 1, head)
			if head == food then
				score += 1
				step = math.max(0.06, step - 0.004)
				food = freeCell()
			else
				table.remove(body)
			end
		end
		local cells = {}
		for _, b in body do
			table.insert(cells, tostring(b.Y * W + b.X))
		end
		send(p.tv, "Snake", string.format("%d|%d|%s", score, food.Y * W + food.X, table.concat(cells, ",")))
	end
end

local function runPong(p)
	p.game = "Pong"
	local ly, ry, bx, by = 0.5, 0.5, 0.5, 0.5
	local vx, vy = 0.55, 0.3
	local ls, rs = 0, 0
	local last = os.clock()
	local acc = 0
	while not p.quit do
		local dt = RunService.Heartbeat:Wait()
		local up = held[Enum.KeyCode.W] or held[Enum.KeyCode.Up]
		local down = held[Enum.KeyCode.S] or held[Enum.KeyCode.Down]
		ly = math.clamp(ly + ((down and 1 or 0) - (up and 1 or 0)) * dt * 0.9, 0.11, 0.89)
		ry = math.clamp(ry + math.clamp(by - ry, -1, 1) * dt * 2.2, 0.11, 0.89)   -- the TV is beatable
		bx += vx * dt
		by += vy * dt
		if by < 0.02 or by > 0.98 then
			vy = -vy
			by = math.clamp(by, 0.02, 0.98)
		end
		if bx < 0.06 and math.abs(by - ly) < 0.12 and vx < 0 then
			vx = -vx * 1.06
			vy += (by - ly) * 2
		elseif bx > 0.94 and math.abs(by - ry) < 0.12 and vx > 0 then
			vx = -vx * 1.04
			vy += (by - ry) * 2
		end
		if bx < 0 or bx > 1 then
			if bx < 0 then
				rs += 1
			else
				ls += 1
			end
			bx, by, vx, vy = 0.5, 0.5, (bx < 0 and 0.55 or -0.55), (math.random() - 0.5) * 0.6
		end
		acc += dt
		if acc > 1 / 15 then                          -- 15 pictures a second to everyone else
			acc = 0
			local r = function(x)
				return math.floor(x * 1000 + 0.5)
			end
			send(p.tv, "Pong", string.format("%d|%d|%d|%d|%d|%d", r(ly), r(ry), r(bx), r(by), ls * 1000, rs * 1000))
		end
	end
end

local function play(tv)
	if playing then
		return
	end
	local screen = tv:FindFirstChild("Screen", true)
	local s = screenOf(tv)
	if not (screen and s) then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local cam = workspace.CurrentCamera
	local oldType, oldSubject = cam.CameraType, cam.CameraSubject
	local p = { tv = tv, menu = true }
	playing = p
	local saved
	if hum then
		if hum:GetAttribute("NC_Movement") then
			hum:SetAttribute("SpeedFactor_TV", 0) -- frozen through the movement system (0 also stops jumps)
		else
			saved = { hum.WalkSpeed, hum.JumpPower, hum.JumpHeight }
			hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
		end
	end
	local face = Vector3.FromNormalId(Enum.NormalId[tv:GetAttribute("ScreenFace") or "Front"])
	local normal = screen.CFrame:VectorToWorldSpace(face)
	local dist = math.max(screen.Size.X, screen.Size.Y) * 1.15
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(screen.Position + normal * dist + Vector3.new(0, 0.6, 0), screen.Position)
	s.bg.BackgroundColor3 = Color3.fromRGB(20, 10, 40)
	clearPixels(s, 1)
	s.label.Text = "1  SNAKE      2  PONG"
	s.score.Text = "Q to stand up"
	while not (p.choose or p.quit) do
		task.wait()
	end
	p.menu = false
	if p.choose == "Snake" then
		runSnake(p)
	elseif p.choose == "Pong" then
		runPong(p)
	end
	TVQuit:FireServer(tv)
	cam.CameraType = oldType ~= Enum.CameraType.Scriptable and oldType or Enum.CameraType.Custom
	cam.CameraSubject = oldSubject or hum
	if hum then
		if hum:GetAttribute("NC_Movement") then
			hum:SetAttribute("SpeedFactor_TV", nil)
		elseif saved then
			hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = saved[1], saved[2], saved[3] -- whatever they were before
		end
	end
	idle(tv)
	playing = nil
end

---------------------------------------------------------------------------- the server's "open this" messages
HouseUI.OnClientEvent:Connect(function(kind, model)
	if kind == "Closet" then
		local sig = Signals:FindFirstChild("OpenCharacterStudio")
		if sig then
			sig:Fire()
		end
	elseif kind == "Gear" then
		local sig = Signals:FindFirstChild("OpenArmory")
		if sig then
			sig:Fire()
		end
	elseif kind == "Cars" then
		local sig = Signals:FindFirstChild("OpenGarageList")
		if sig then
			sig:Fire()
		end
	elseif kind == "TV" and model then
		task.spawn(play, model)
	end
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX6"><Properties><string name="Name">Basketball</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Basketball (server): working half courts with a ball that behaves like a real one.
-- A court is any Model tagged NC_Hoop (BuildingKit.PrepareHalfCourt makes them from the Blender half court) with
-- Attachments RimCenter, BallSpawn and BoardCenter, and attributes RimRadius, ThreeRadius, BoardSize.
--
-- Real numbers (about 1.15 studs per foot): 9.4 in ball (0.9 studs), 18 in rim (inner radius 0.8625) at 10 ft,
-- 72 x 42 in glass board. The ball falls at real gravity (32.2 ft/s^2 = 37 studs/s^2; Roblox's default pulls about
-- 5x harder, so a VectorForce takes the difference off), bounces back about 85% on the court like a regulation
-- ball, softer off the steel rim (~0.65) and livelier off the glass (~0.8). The rim is a ring of real steel tubes,
-- so balls roll around, rattle in, spin out and bank off the board. The server simulates the ball in flight, so
-- every player sees the same bounce and the scoring can't be faked.
--
-- Pick up: E on the ball, or run into a loose ball (catching rebounds and passes). Hold left click (or Shoot on
-- touch) to load the shot, release at the top of the meter, G to pass. Through the rim from above = 2 points,
-- 3 if you shot from beyond the arc. Players carry Buckets / Makes / Shots attributes for the HUD.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local RS = game:GetService("ReplicatedStorage")

local G_REAL = 37.0
local BALL_D = 0.9
local HOLD_C0 = CFrame.new(1.1, -1.4, -1.1) -- right hip, before the client's dribble takes over
-- Built-in sounds so it works anywhere; swap for store sounds (ball bounce, rim clank) when convenient.
local SOUNDS = {
	Bounce = { "rbxasset://sounds/action_jump_land.mp3", 1.75 },
	Rim = { "rbxasset://sounds/action_jump_land.mp3", 2.7 },
	Board = { "rbxasset://sounds/action_jump_land.mp3", 1.25 },
}

local Remotes = RS:FindFirstChild("Remotes")
if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "Remotes"
	Remotes.Parent = RS
end
local function remote(name)
	local r = Remotes:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = Remotes
	end
	return r
end
local ShootRE = remote("BallShoot") -- (ball, origin, velocity, spin)
local PassRE = remote("BallPass") -- (ball, origin, velocity)
local PoseRE = remote("BallPose") -- ("charge" | nil): everyone sees the shot coming
local BucketRE = remote("BallBucket") -- server -> all: (court, points, shooterName, swish, bank)

local hoops = {} -- court model -> state

local function playSound(parent, key, volume)
	local def = SOUNDS[key]
	local s = Instance.new("Sound")
	s.SoundId = def[1]
	s.PlaybackSpeed = def[2] * (0.95 + math.random() * 0.1)
	s.Volume = volume
	s.RollOffMinDistance = 6
	s.RollOffMaxDistance = 110
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 2)
end

local function flatDist(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function setGravity(ball, on)
	local vf = ball:FindFirstChild("RealGravity")
	if not vf then
		local att = Instance.new("Attachment")
		att.Name = "Centre"
		att.Parent = ball
		vf = Instance.new("VectorForce")
		vf.Name = "RealGravity"
		vf.Attachment0 = att
		vf.RelativeTo = Enum.ActuatorRelativeTo.World
		vf.ApplyAtCenterOfMass = true
		vf.Parent = ball
	end
	vf.Force = Vector3.new(0, ball:GetMass() * (workspace.Gravity - G_REAL), 0)
	vf.Enabled = on
end

local function charOf(userId)
	local p = userId and Players:GetPlayerByUserId(userId)
	return p and p.Character, p
end

local release -- forward

local function grab(b, player)
	if b:GetAttribute("Holder") or not b.Parent then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum) or hum.Health <= 0 or char:GetAttribute("HasBall") then
		return
	end
	if (hrp.Position - b.Position).Magnitude > 10 then
		return
	end
	hum:UnequipTools()
	b.CanCollide = false
	b.Massless = true
	setGravity(b, false)
	local w = Instance.new("Weld")
	w.Name = "BallHold"
	w.Part0 = hrp
	w.Part1 = b
	w.C0 = HOLD_C0
	w.Parent = b
	b:SetAttribute("Holder", player.UserId)
	char:SetAttribute("HasBall", true)
	char:SetAttribute("BallPose", nil)
	local pp = b:FindFirstChildOfClass("ProximityPrompt")
	if pp then
		pp.Enabled = false
	end
end

-- origin: where the ball leaves the hands (nil = where it is). shooter: the Player when it's a shot (for scoring).
function release(b, holderChar, origin, vel, spin, shooter)
	local w = b:FindFirstChild("BallHold")
	if w then
		w:Destroy()
	end
	local thrower = b:GetAttribute("Holder")
	if holderChar then
		holderChar:SetAttribute("HasBall", nil)
		holderChar:SetAttribute("BallPose", shooter and "follow" or nil)
		if shooter then
			task.delay(0.6, function()
				if holderChar:GetAttribute("BallPose") == "follow" then
					holderChar:SetAttribute("BallPose", nil)
				end
			end)
		end
	end
	b:SetAttribute("Holder", nil)
	b.Massless = false
	if origin then
		b.CFrame = CFrame.new(origin) * b.CFrame.Rotation
	end
	b.CanCollide = false -- clear of the thrower's own arms for a moment
	setGravity(b, true)
	pcall(function()
		b:SetNetworkOwner(nil) -- the server flies it: same bounce for everyone, honest scoring
	end)
	b.AssemblyLinearVelocity = vel
	b.AssemblyAngularVelocity = spin or Vector3.zero
	local token = (b:GetAttribute("ReleaseId") or 0) + 1
	b:SetAttribute("ReleaseId", token)
	task.delay(0.15, function()
		if b.Parent and b:GetAttribute("ReleaseId") == token and not b:GetAttribute("Holder") then
			b.CanCollide = true
		end
	end)
	b:SetAttribute("LastThrower", thrower)
	b:SetAttribute("ThrowTime", workspace:GetServerTimeNow())
	if shooter then
		local hrp = holderChar and holderChar:FindFirstChild("HumanoidRootPart")
		b:SetAttribute("ShotBy", shooter.UserId)
		b:SetAttribute("ShotFrom", hrp and hrp.Position or origin)
		b:SetAttribute("ShotTime", workspace:GetServerTimeNow())
		b:SetAttribute("TouchedRim", false)
		b:SetAttribute("TouchedBoard", false)
		shooter:SetAttribute("Shots", (shooter:GetAttribute("Shots") or 0) + 1)
	else
		b:SetAttribute("ShotBy", nil)
	end
	local pp = b:FindFirstChildOfClass("ProximityPrompt")
	if pp then
		pp.Enabled = true
	end
end

local function makeBall(court, h)
	local b = Instance.new("Part")
	b.Name = "Basketball"
	b.Shape = Enum.PartType.Ball
	b.Size = Vector3.one * BALL_D
	b.Material = Enum.Material.Leather
	b.Color = Color3.fromRGB(206, 92, 34)
	-- density, friction, elasticity, frictionWeight, elasticityWeight. The court sets its own bounce (0.85, heavy
	-- weight) so a court bounce is regulation; grass, the rim and the board all come out softer than the court.
	b.CustomPhysicalProperties = PhysicalProperties.new(0.12, 0.7, 0.85, 3, 3)
	b.CFrame = h.spawn.WorldCFrame
	for k = 0, 1 do -- the black seams
		local seam = Instance.new("Part")
		seam.Name = "Seam"
		seam.Shape = Enum.PartType.Cylinder
		seam.Size = Vector3.new(0.02, BALL_D + 0.01, BALL_D + 0.01)
		seam.Color = Color3.fromRGB(28, 22, 20)
		seam.Material = Enum.Material.SmoothPlastic
		seam.CanCollide, seam.CanQuery, seam.CanTouch, seam.Massless = false, false, false, true
		seam.CFrame = b.CFrame * CFrame.Angles(0, k * math.pi / 2, 0)
		local wc = Instance.new("WeldConstraint")
		wc.Part0, wc.Part1 = b, seam
		wc.Parent = seam
		seam.Parent = b
	end
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Pick up"
	pp.ObjectText = "Basketball"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 8
	pp.RequiresLineOfSight = false
	pp.Parent = b
	CollectionService:AddTag(b, "NC_Basketball")
	b.Parent = court
	setGravity(b, true)
	pcall(function()
		b:SetNetworkOwner(nil)
	end)
	pp.Triggered:Connect(function(player)
		grab(b, player)
	end)
	-- run into a loose ball to catch it (rebounds, passes); not with a gun out, not your own throw right away
	b.Touched:Connect(function(hit)
		if b:GetAttribute("Holder") then
			return
		end
		local char = hit:FindFirstAncestorOfClass("Model")
		local player = char and Players:GetPlayerFromCharacter(char)
		if not player or char:FindFirstChildOfClass("Tool") or b.AssemblyLinearVelocity.Magnitude > 45 then
			return
		end
		if b:GetAttribute("LastThrower") == player.UserId and workspace:GetServerTimeNow() - (b:GetAttribute("ThrowTime") or 0) < 0.8 then
			return
		end
		grab(b, player)
	end)
	h.ball = b
	h.prev, h.prevVy, h.away = nil, nil, 0
	return b
end

local function validBall(player, b)
	return typeof(b) == "Instance" and CollectionService:HasTag(b, "NC_Basketball") and b:GetAttribute("Holder") == player.UserId
end

local function validOrigin(player, origin)
	local head = player.Character and player.Character:FindFirstChild("Head")
	return head and typeof(origin) == "Vector3" and origin == origin and (origin - head.Position).Magnitude < 6
end

ShootRE.OnServerEvent:Connect(function(player, b, origin, vel, spin)
	if not validBall(player, b) or not validOrigin(player, origin) then
		return
	end
	if typeof(vel) ~= "Vector3" or vel ~= vel or vel.Magnitude > 90 then
		return
	end
	if typeof(spin) ~= "Vector3" or spin ~= spin or spin.Magnitude > 60 then
		spin = Vector3.zero
	end
	release(b, player.Character, origin, vel, spin, player)
end)

PassRE.OnServerEvent:Connect(function(player, b, origin, vel)
	if not validBall(player, b) or not validOrigin(player, origin) then
		return
	end
	if typeof(vel) ~= "Vector3" or vel ~= vel or vel.Magnitude > 55 then
		return
	end
	release(b, player.Character, origin, vel, Vector3.zero, nil)
end)

PoseRE.OnServerEvent:Connect(function(player, state)
	local char = player.Character
	if char and char:GetAttribute("HasBall") then
		char:SetAttribute("BallPose", state == "charge" and "charge" or nil)
	end
end)

local function score(court, h, b)
	local rimC = h.rimA.WorldPosition
	local shooterId = b:GetAttribute("ShotBy")
	local shooter = shooterId and Players:GetPlayerByUserId(shooterId)
	local fresh = shooter ~= nil and (workspace:GetServerTimeNow() - (b:GetAttribute("ShotTime") or 0)) < 8
	local pts, swish, bank = 0, false, false
	if fresh then
		local from = b:GetAttribute("ShotFrom")
		pts = (typeof(from) == "Vector3" and flatDist(from, rimC) > h.three) and 3 or 2
		swish = not b:GetAttribute("TouchedRim") and not b:GetAttribute("TouchedBoard")
		bank = b:GetAttribute("TouchedBoard") == true
		shooter:SetAttribute("Buckets", (shooter:GetAttribute("Buckets") or 0) + pts)
		shooter:SetAttribute("Makes", (shooter:GetAttribute("Makes") or 0) + 1)
	end
	b:SetAttribute("ShotBy", nil)
	BucketRE:FireAllClients(court, pts, fresh and shooter.DisplayName or nil, swish, bank)
end

local function teardown(court)
	local h = hoops[court]
	if not h then
		return
	end
	if h.ball then
		h.ball:Destroy()
	end
	if h.folder then
		h.folder:Destroy()
	end
	hoops[court] = nil
end

local function setupHoop(court)
	if hoops[court] or not court:IsDescendantOf(workspace) then
		return
	end
	local rimA = court:FindFirstChild("RimCenter", true)
	local spawnA = court:FindFirstChild("BallSpawn", true)
	if not (rimA and spawnA) then
		return
	end
	local r = court:GetAttribute("RimRadius") or 0.8625
	local h = { rimA = rimA, r = r, three = court:GetAttribute("ThreeRadius") or 22.71, spawn = spawnA, ring = {}, away = 0 }
	hoops[court] = h
	local folder = Instance.new("Folder")
	folder.Name = "PhysicsHoop"
	h.folder = folder
	-- the steel rim: 20 tubes round the circle, inner edge exactly at the 18 in rim
	local c = rimA.WorldPosition
	local tube = 0.07
	local n = 20
	local steel = PhysicalProperties.new(7.8, 0.4, 0.45, 1, 3)
	for k = 0, n - 1 do
		local a0, a1 = 2 * math.pi * k / n, 2 * math.pi * (k + 1) / n
		local p0 = c + Vector3.new(math.cos(a0), 0, math.sin(a0)) * (r + tube)
		local p1 = c + Vector3.new(math.cos(a1), 0, math.sin(a1)) * (r + tube)
		local seg = Instance.new("Part")
		seg.Name = "Rim"
		seg.Shape = Enum.PartType.Cylinder
		seg.Size = Vector3.new((p1 - p0).Magnitude + 0.04, tube * 2, tube * 2)
		seg.CFrame = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis (X) along the chord
		seg.Anchored = true
		seg.Transparency = 1
		seg.CastShadow = false
		seg.CustomPhysicalProperties = steel
		seg.Parent = folder
		h.ring[seg] = true
		seg.Touched:Connect(function(hit)
			if hit == h.ball then
				hit:SetAttribute("TouchedRim", true)
				if os.clock() - (h.rimSound or 0) > 0.12 then
					h.rimSound = os.clock()
					playSound(hit, "Rim", math.clamp(hit.AssemblyLinearVelocity.Magnitude / 22, 0.2, 1))
				end
			end
		end)
	end
	local boardA = court:FindFirstChild("BoardCenter", true)
	if boardA then
		local board = Instance.new("Part")
		board.Name = "Board"
		board.Size = court:GetAttribute("BoardSize") or Vector3.new(6.9, 4.025, 0.15)
		board.CFrame = boardA.WorldCFrame
		board.Anchored = true
		board.Transparency = 1
		board.CastShadow = false
		board.CustomPhysicalProperties = PhysicalProperties.new(2.6, 0.3, 0.75, 1, 3)
		board.Parent = folder
		board.Touched:Connect(function(hit)
			if hit == h.ball then
				hit:SetAttribute("TouchedBoard", true)
				if os.clock() - (h.boardSound or 0) > 0.15 then
					h.boardSound = os.clock()
					playSound(hit, "Board", math.clamp(hit.AssemblyLinearVelocity.Magnitude / 22, 0.25, 1))
				end
			end
		end)
	end
	folder.Parent = court
	makeBall(court, h)
end

-- courts come and go (Kit.Place clones, streaming, a template moved in from ServerStorage)
task.spawn(function()
	while true do
		for _, court in CollectionService:GetTagged("NC_Hoop") do
			if not hoops[court] and court:IsDescendantOf(workspace) then
				task.spawn(setupHoop, court)
			end
		end
		for court in hoops do
			if not court:IsDescendantOf(workspace) then
				teardown(court)
			end
		end
		task.wait(1)
	end
end)

local floorParams = RaycastParams.new()
floorParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.Heartbeat:Connect(function(dt)
	for court, h in hoops do
		local b = h.ball
		if not (b and b.Parent) then
			makeBall(court, h)
			continue
		end
		local holderId = b:GetAttribute("Holder")
		if holderId then
			-- the holder died, left, pulled a gun or the hold broke: the ball drops where it is
			local char = charOf(holderId)
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local w = b:FindFirstChild("BallHold")
			if not (hum and hum.Health > 0 and w and w.Part0 and w.Part0:IsDescendantOf(char)) or char:FindFirstChildOfClass("Tool") then
				release(b, char, nil, Vector3.new(0, 4, 0))
			end
			h.prev, h.prevVy = nil, nil
			continue
		end
		local pos, vel = b.Position, b.AssemblyLinearVelocity
		local prev = h.prev
		if prev then
			local rimC = h.rimA.WorldPosition
			local function crossedInside()
				local t = (prev.Y - rimC.Y) / (prev.Y - pos.Y)
				local cross = prev:Lerp(pos, t)
				return flatDist(cross, rimC) < h.r - 0.15
			end
			if prev.Y > rimC.Y and pos.Y <= rimC.Y and crossedInside() then
				if os.clock() - (h.upThrough or -99) > 2.5 then -- not a ball pushed up through the net and back
					score(court, h, b)
				end
			elseif prev.Y < rimC.Y and pos.Y >= rimC.Y and crossedInside() then
				h.upThrough = os.clock()
			end
		end
		-- bounce sound off the ground: the fall turned into a rise with the floor right under the ball
		if h.prevVy and h.prevVy < -5 and vel.Y > 1 then
			floorParams.FilterDescendantsInstances = { b, h.folder }
			if workspace:Raycast(pos, Vector3.new(0, -BALL_D, 0), floorParams) then
				playSound(b, "Bounce", math.clamp(-h.prevVy / 28, 0.15, 0.9))
			end
		end
		-- rolled away or fell out of the world: back to the free-throw line after a while
		local spawnP = h.spawn.WorldPosition
		if pos.Y < spawnP.Y - 50 then
			h.away = 99
		elseif (pos - spawnP).Magnitude > 75 then
			h.away += dt
		else
			h.away = 0
		end
		if h.away > 8 then
			b.AssemblyLinearVelocity, b.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			b.CFrame = h.spawn.WorldCFrame
			b:SetAttribute("ShotBy", nil)
			h.away = 0
			pos = b.Position
		end
		h.prev, h.prevVy = pos, vel.Y
	end
end)

Players.PlayerRemoving:Connect(function(player)
	for _, h in hoops do
		if h.ball and h.ball:GetAttribute("Holder") == player.UserId then
			release(h.ball, player.Character, nil, Vector3.zero)
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX7"><Properties><string name="Name">BasketballClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- BasketballClient: the shooter's side of the Basketball script, plus what everyone sees.
--   * Hold left click (Shoot on touch, R2 on a pad) to load the shot, let go at the top of the meter. The arc is
--     real ballistics at 37 studs/s^2 (real gravity) toward the nearest rim you're facing: about 52-58 degrees of
--     launch, backspin, and the human part comes from you: letting go early or late falls short or long, and
--     shooting on the move sprays it. G passes (lobs to a player you're looking at, or a chest pass).
--   * Every held ball is dribbled for every player (bounce speed follows the runner), the shooting pose and the
--     follow-through show on everyone, and a bucket snaps the net, swishes and pops "+2" / "+3" over the rim.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Remotes = RS:WaitForChild("Remotes")
local ShootRE = Remotes:WaitForChild("BallShoot")
local PassRE = Remotes:WaitForChild("BallPass")
local PoseRE = Remotes:WaitForChild("BallPose")
local BucketRE = Remotes:WaitForChild("BallBucket")

local G = 37.0 -- real gravity in studs (the server flies the ball with the same number)
local BALL_R = 0.45
local CHARGE_T = 0.7 -- seconds from empty to the top of the meter (then it falls back: holding too long is late)
local SND_DRIBBLE = { "rbxasset://sounds/action_jump_land.mp3", 1.75 }
local SND_SWISH = { "rbxasset://sounds/action_swim.mp3", 1.9 }

local function sound(parent, def, volume, maxDist)
	local s = Instance.new("Sound")
	s.SoundId = def[1]
	s.PlaybackSpeed = def[2] * (0.95 + math.random() * 0.1)
	s.Volume = volume
	s.RollOffMinDistance = 5
	s.RollOffMaxDistance = maxDist or 90
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 2)
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function myBall()
	for _, b in CollectionService:GetTagged("NC_Basketball") do
		if b:GetAttribute("Holder") == player.UserId then
			return b
		end
	end
	return nil
end

local function body()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and head and hum then
		return char, hrp, head, hum
	end
	return nil
end

-- the rim you mean: close, and roughly where the camera looks
local function pickRim(hrp)
	local look = flat(workspace.CurrentCamera.CFrame.LookVector)
	look = look.Magnitude > 0.01 and look.Unit or hrp.CFrame.LookVector
	local best, bestScore
	for _, court in CollectionService:GetTagged("NC_Hoop") do
		local rim = court:FindFirstChild("RimCenter", true)
		if rim then
			local d = flat(rim.WorldPosition - hrp.Position)
			local dist = d.Magnitude
			if dist < 55 then
				local facing = dist > 0.1 and d.Unit:Dot(look) or 1
				if facing > -0.25 then
					local s = dist * (2.2 - facing)
					if not bestScore or s < bestScore then
						best, bestScore = rim, s
					end
				end
			end
		end
	end
	return best
end

-- Launch angle and speed that drop the ball through the rim centre coming down at ENTRY degrees (no air drag,
-- gravity G). Good shooters come in at about 45-47 degrees: steep enough that the 9.4 in ball has room in the
-- 18 in rim (about +-2.5 in along the shot at 47), which works out to a 55-62 degree launch from Roblox height
-- and a 70+ degree lay-in up close. tan(launch) = tan(entry) + 2H/D for a parabola through the target.
local ENTRY = math.rad(47)
local function solveShot(origin, target)
	local d = target - origin
	local D = math.max(flat(d).Magnitude, 0.6)
	local H = d.Y
	local theta = math.min(math.atan(math.tan(ENTRY) + 2 * H / D), math.rad(84))
	local denom = 2 * math.cos(theta) ^ 2 * (D * math.tan(theta) - H)
	if denom <= 0.01 then
		return theta, nil
	end
	return theta, math.sqrt(G * D * D / denom)
end

---------------------------------------------------------------------------------------------- HUD
local gui = Instance.new("ScreenGui")
gui.Name = "BasketballHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local meter = Instance.new("Frame")
meter.AnchorPoint = Vector2.new(0, 0.5)
meter.Position = UDim2.new(0.5, 70, 0.5, -20)
meter.Size = UDim2.fromOffset(12, 130)
meter.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
meter.BackgroundTransparency = 0.25
meter.BorderSizePixel = 0
meter.Visible = false
meter.Parent = gui
Instance.new("UICorner", meter).CornerRadius = UDim.new(0, 6)
local sweet = Instance.new("Frame") -- the release window at the top
sweet.Size = UDim2.new(1, 0, 0.07, 0)
sweet.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
sweet.BorderSizePixel = 0
sweet.Parent = meter
local fill = Instance.new("Frame")
fill.AnchorPoint = Vector2.new(0, 1)
fill.Position = UDim2.fromScale(0, 1)
fill.Size = UDim2.fromScale(1, 0)
fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
fill.BorderSizePixel = 0
fill.Parent = meter
Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)
local verdict = Instance.new("TextLabel")
verdict.AnchorPoint = Vector2.new(0, 0.5)
verdict.Position = UDim2.new(0.5, 92, 0.5, -70)
verdict.Size = UDim2.fromOffset(160, 28)
verdict.BackgroundTransparency = 1
verdict.Font = Enum.Font.GothamBlack
verdict.TextSize = 20
verdict.TextXAlignment = Enum.TextXAlignment.Left
verdict.TextStrokeTransparency = 0.5
verdict.TextTransparency = 1
verdict.Parent = gui

local stats = Instance.new("TextLabel")
stats.AnchorPoint = Vector2.new(0.5, 1)
stats.Position = UDim2.new(0.5, 0, 1, -128)
stats.Size = UDim2.fromOffset(360, 44)
stats.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
stats.BackgroundTransparency = 0.35
stats.Font = Enum.Font.GothamBold
stats.TextSize = 15
stats.TextColor3 = Color3.fromRGB(240, 240, 240)
stats.RichText = true
stats.Visible = false
stats.Parent = gui
Instance.new("UICorner", stats).CornerRadius = UDim.new(0, 8)

local function showVerdict(text, color)
	verdict.Text = text
	verdict.TextColor3 = color
	verdict.TextTransparency = 0
	verdict.TextStrokeTransparency = 0.5
	TweenService:Create(verdict, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
end

---------------------------------------------------------------------------------------------- shooting
local charging, chargeStart, followUntil = false, 0, 0
local wasCharging, autoRotateWas = false, true
local aimRim = nil

local function chargeValue()
	local t = (os.clock() - chargeStart) / CHARGE_T
	return 1 - math.abs((t % 2) - 1), t > 1
end

local function shoot()
	local b = myBall()
	local char, hrp, head, hum = body()
	if not (b and char) then
		return
	end
	local c, late = chargeValue()
	local up = Vector3.yAxis
	local rim = pickRim(hrp)
	local origin, vel, spin
	if rim then
		local target = rim.WorldPosition
		local d = flat(target - hrp.Position)
		local fwd = d.Magnitude > 0.05 and d.Unit or hrp.CFrame.LookVector
		origin = head.Position + fwd * 1.1 + up * 1.0 -- arms up, ball off the fingertips above the forehead
		local theta, v = solveShot(origin, target)
		v = v or 18
		-- the human part: early is short and late is long (1% of speed is ~0.5 studs at 17 ft, so the green window
		-- swishes, "good" rattles, the rest is rim or air), a little hand jitter, and a lot more when moving
		local moving = math.clamp(flat(hrp.AssemblyLinearVelocity).Magnitude / 16, 0, 1.5)
		local m = 1 + (late and 1 or -1) * (1 - c) * 0.05 + (math.random() * 2 - 1) * (0.0015 + 0.012 * moving)
		local yaw = math.rad((math.random() * 2 - 1) * (0.35 + 1.5 * moving))
		local dir = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(fwd)
		vel = (dir * math.cos(theta) + up * math.sin(theta)) * v * m
		spin = dir:Cross(up) * 12 -- about two turns a second of backspin: soft off the rim, true off the glass
		hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + fwd)
	else
		local look = flat(workspace.CurrentCamera.CFrame.LookVector)
		look = look.Magnitude > 0.01 and look.Unit or hrp.CFrame.LookVector
		origin = head.Position + look * 1.1 + up * 1.0
		vel = (look * math.cos(math.rad(50)) + up * math.sin(math.rad(50))) * (12 + 16 * c)
		spin = look:Cross(up) * 10
	end
	ShootRE:FireServer(b, origin, vel, spin)
	followUntil = os.clock() + 0.6
	if c >= 0.93 then
		showVerdict("Perfect", Color3.fromRGB(90, 230, 130))
	elseif c >= 0.8 then
		showVerdict("Good", Color3.fromRGB(240, 220, 90))
	else
		showVerdict(late and "Late" or "Early", Color3.fromRGB(240, 110, 90))
	end
end

local function pass()
	local b = myBall()
	local char, hrp, head = body()
	if not (b and char) then
		return
	end
	local cam = workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local fl = flat(look).Magnitude > 0.01 and flat(look).Unit or hrp.CFrame.LookVector
	local origin = head.Position + fl * 1.2 - Vector3.new(0, 0.7, 0) -- from the chest
	-- a player you're looking at gets it on the chest (exact ballistic lob), otherwise a chest pass that way
	local best, bestDot
	for _, other in Players:GetPlayers() do
		local oc = other ~= player and other.Character
		local ot = oc and oc:FindFirstChild("UpperTorso") or (oc and oc:FindFirstChild("HumanoidRootPart"))
		if ot then
			local d = ot.Position - origin
			if d.Magnitude < 60 then
				local dot = d.Unit:Dot(look)
				if dot > 0.93 and (not bestDot or dot > bestDot) then
					best, bestDot = ot, dot
				end
			end
		end
	end
	local vel
	if best then
		local target = best.Position + best.AssemblyLinearVelocity * 0.25
		local dist = (target - origin).Magnitude
		local t = math.clamp(dist / 30, 0.25, 1.6)
		vel = (target - origin) / t + Vector3.new(0, 0.5 * G * t, 0)
	else
		vel = (look + Vector3.new(0, 0.12, 0)).Unit * 30
	end
	if vel.Magnitude > 54 then
		vel = vel.Unit * 54
	end
	PassRE:FireServer(b, origin, vel)
end

local function onShoot(_, state)
	if state == Enum.UserInputState.Begin then
		if not myBall() then
			return Enum.ContextActionResult.Pass
		end
		charging, chargeStart = true, os.clock()
		PoseRE:FireServer("charge")
	elseif state == Enum.UserInputState.End then
		if charging then
			charging = false
			shoot()
		end
	elseif state == Enum.UserInputState.Cancel then -- (a touch button sends Change while the finger slides: ignore)
		if charging then
			charging = false
			PoseRE:FireServer(nil)
		end
	end
	return Enum.ContextActionResult.Sink
end

local function onPass(_, state)
	if state == Enum.UserInputState.Begin and myBall() then
		charging = false
		pass()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local bound = false
local function setBound(on)
	if on == bound then
		return
	end
	bound = on
	if on then
		CAS:BindActionAtPriority("NC_Shoot", onShoot, true, 3000, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
		CAS:SetTitle("NC_Shoot", "Shoot")
		CAS:BindActionAtPriority("NC_Pass", onPass, true, 3000, Enum.KeyCode.G, Enum.KeyCode.ButtonX)
		CAS:SetTitle("NC_Pass", "Pass")
	else
		CAS:UnbindAction("NC_Shoot")
		CAS:UnbindAction("NC_Pass")
		if charging then
			charging = false
			PoseRE:FireServer(nil)
		end
	end
end

---------------------------------------------------------------------------------------------- poses (all players)
-- Rotation-only joint override that works for Motor6D rigs and AnimationConstraint (starter body) rigs alike:
-- q is where Part1 should point relative to Part0; T = C0^-1 * q * C1 keeps the joint where it is.
local jointCache = setmetatable({}, { __mode = "k" })
local JOINTS = { RightShoulder = true, RightElbow = true, LeftShoulder = true, LeftElbow = true }
local function jointsOf(char)
	local e = jointCache[char]
	if e and (e.n == 4 or os.clock() - e.t < 2) then
		return e
	end
	e = { n = 0, t = os.clock() }
	for _, d in char:GetDescendants() do
		if JOINTS[d.Name] and (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) and not e[d.Name] then
			e[d.Name] = d
			e.n += 1
		end
	end
	jointCache[char] = e
	return e
end

local function frames(j)
	if j:IsA("Motor6D") then
		return j.C0.Rotation, j.C1.Rotation
	end
	local a0, a1 = j.Attachment0, j.Attachment1
	local p0 = a0 and a0:FindFirstAncestorWhichIsA("BasePart")
	local p1 = a1 and a1:FindFirstAncestorWhichIsA("BasePart")
	if not (p0 and p1) then
		return nil
	end
	return p0.CFrame:ToObjectSpace(a0.WorldCFrame).Rotation, p1.CFrame:ToObjectSpace(a1.WorldCFrame).Rotation
end

local function setJoint(j, q, alpha)
	if not j then
		return
	end
	local c0, c1 = frames(j)
	if not c0 then
		return
	end
	local target = c0:Inverse() * q * c1
	j.Transform = alpha < 1 and j.Transform:Lerp(target, alpha) or target
end

local rad = math.rad
local POSE = {
	-- set point: shooting upper arm out front, forearm straight up under the ball, guide hand on its side
	charge = {
		RightShoulder = CFrame.Angles(rad(100), 0, 0), RightElbow = CFrame.Angles(rad(90), 0, 0),
		LeftShoulder = CFrame.Angles(rad(95), 0, rad(25)), LeftElbow = CFrame.Angles(rad(80), 0, 0),
	},
	-- follow-through: arm up and out at the rim, wrist down
	follow = {
		RightShoulder = CFrame.Angles(rad(150), 0, 0), RightElbow = CFrame.Angles(rad(8), 0, 0),
		LeftShoulder = CFrame.Angles(rad(120), 0, rad(20)), LeftElbow = CFrame.Angles(rad(30), 0, 0),
	},
}

local dribble = setmetatable({}, { __mode = "k" }) -- ball -> { phase, blend }
local follow = setmetatable({}, { __mode = "k" }) -- char -> blend

local function thump(b)
	if (workspace.CurrentCamera.CFrame.Position - b.Position).Magnitude < 90 then
		sound(b, SND_DRIBBLE, 0.32, 70)
	end
end

local function animateHolder(b, char, dt, isLocal)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local head = char:FindFirstChild("Head")
	local hum = char:FindFirstChildOfClass("Humanoid")
	local w = b:FindFirstChild("BallHold")
	if not (hrp and head and hum and w and w.Part0 == hrp) then
		return
	end
	local st = dribble[b]
	if not st or st.char ~= char then
		st = { phase = 0.5, blend = 0, char = char }
		dribble[b] = st
	end
	st.blend = math.min(1, st.blend + dt * 6)
	local J = jointsOf(char)
	local pose = char:GetAttribute("BallPose")
	if isLocal then
		pose = charging and "charge" or nil -- the shooter sees it right away
	end
	if pose == "charge" then
		local c = isLocal and (chargeValue()) or 0.5
		local headL = hrp.CFrame:PointToObjectSpace(head.Position)
		w.C0 = w.C0:Lerp(CFrame.new(0.3, headL.Y + 0.5 + 0.1 * c, -0.9), math.min(1, dt * 18))
		for name, q in POSE.charge do
			setJoint(J[name], q, st.blend)
		end
		st.phase = 0.5
		return
	end
	-- dribble: ball between the hand and the floor, fastest at the floor (a real bounce), quicker on the run
	local speed = flat(hrp.AssemblyLinearVelocity).Magnitude
	local before = st.phase
	st.phase += dt * (1.3 + math.min(speed, 24) * 0.045)
	if math.floor(before + 0.5) ~= math.floor(st.phase + 0.5) then
		thump(b)
	end
	local hgt = math.abs(math.cos(math.pi * st.phase))
	local floorY = -(hrp.Size.Y / 2 + hum.HipHeight) + BALL_R
	local top = Vector3.new(1.0, -0.8, -0.9)
	local low = Vector3.new(1.15, floorY, -1.25 - math.min(speed, 24) * 0.03)
	w.C0 = CFrame.new(low:Lerp(top, hgt))
	setJoint(J.RightShoulder, CFrame.Angles(rad(25 + 25 * hgt), 0, rad(12)), st.blend)
	setJoint(J.RightElbow, CFrame.Angles(rad(20 + 45 * hgt), 0, 0), st.blend)
end

RunService.Stepped:Connect(function(_, dt)
	local holding = {}
	for _, b in CollectionService:GetTagged("NC_Basketball") do
		local id = b:GetAttribute("Holder")
		local p = id and Players:GetPlayerByUserId(id)
		local char = p and p.Character
		if char then
			holding[char] = true
			animateHolder(b, char, dt, p == player)
		end
	end
	-- follow-through after the shot, for everyone (the shooter's own from the local clock)
	for _, p in Players:GetPlayers() do
		local char = p.Character
		if char and not holding[char] then
			local on = (p == player and os.clock() < followUntil) or (p ~= player and char:GetAttribute("BallPose") == "follow")
			if on then
				follow[char] = math.min(1, (follow[char] or 0) + dt * 10)
				local J = jointsOf(char)
				for name, q in POSE.follow do
					setJoint(J[name], q, follow[char])
				end
			else
				follow[char] = nil
			end
		end
	end
end)

---------------------------------------------------------------------------------------------- per frame: HUD, aim
RunService.RenderStepped:Connect(function()
	local b = myBall()
	setBound(b ~= nil)
	local char, hrp, _, hum = body()
	if hum and charging ~= wasCharging then
		-- only while loading a shot, and put back whatever it was (other systems use AutoRotate too)
		if charging then
			autoRotateWas = hum.AutoRotate
			hum.AutoRotate = false
		else
			hum.AutoRotate = autoRotateWas ~= false
		end
		wasCharging = charging
	end
	if charging and hrp then
		-- square up to the rim while loading the shot (you can still drift)
		aimRim = pickRim(hrp)
		if aimRim then
			local d = flat(aimRim.WorldPosition - hrp.Position)
			if d.Magnitude > 0.1 then
				local want = CFrame.lookAt(hrp.Position, hrp.Position + d)
				hrp.CFrame = hrp.CFrame:Lerp(want, 0.35)
			end
		end
	end
	meter.Visible = charging
	if charging then
		local c = chargeValue()
		fill.Size = UDim2.fromScale(1, c)
		fill.BackgroundColor3 = c >= 0.93 and Color3.fromRGB(90, 230, 130) or Color3.fromRGB(255, 255, 255)
	end
	-- stats when you have the ball or stand near a hoop
	local near = b ~= nil
	if not near and hrp then
		for _, court in CollectionService:GetTagged("NC_Hoop") do
			local rim = court:FindFirstChild("RimCenter", true)
			if rim and flat(rim.WorldPosition - hrp.Position).Magnitude < 45 then
				near = true
				break
			end
		end
	end
	stats.Visible = near
	if near then
		local hint = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and "Shoot / Pass buttons"
			or "Hold click: shoot · G: pass"
		if not b then
			hint = "Grab the ball (E) or run into it"
		end
		stats.Text = string.format("<b>PTS %d</b>   FG %d/%d\n<font size=\"12\" color=\"#BBBBBB\">%s</font>",
			player:GetAttribute("Buckets") or 0, player:GetAttribute("Makes") or 0, player:GetAttribute("Shots") or 0, hint)
	end
end)

---------------------------------------------------------------------------------------------- buckets
BucketRE.OnClientEvent:Connect(function(court, pts, who, swish, bank)
	if typeof(court) ~= "Instance" or not court:IsDescendantOf(workspace) then
		return
	end
	local rim = court:FindFirstChild("RimCenter", true)
	if not rim then
		return
	end
	-- the net snaps down and swings back
	local net = court:FindFirstChild("Net", true)
	if net and net:IsA("BasePart") then
		local base = net:GetAttribute("BaseCFrame")
		if not base then
			base = net.CFrame
			net:SetAttribute("BaseCFrame", base)
		end
		net.CFrame = base * CFrame.new(0, -0.35, 0)
		TweenService:Create(net, TweenInfo.new(0.7, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { CFrame = base }):Play()
	end
	sound(rim, SND_SWISH, swish and 0.8 or 0.5, 100)
	-- "+2" / "SWISH +3" over the rim
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 70)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 1.2, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 150
	bb.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.RichText = true
	t.TextColor3 = pts == 3 and Color3.fromRGB(255, 200, 70) or Color3.fromRGB(255, 255, 255)
	t.TextStrokeTransparency = 0.3
	local head = pts > 0 and ((swish and "SWISH  " or bank and "BANK  " or "") .. "+" .. pts) or "Bucket!"
	t.Text = who and (head .. "\n<font size=\"16\">" .. who .. "</font>") or head
	t.Parent = bb
	bb.Parent = rim
	TweenService:Create(bb, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.0), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(bb, 1.8)
	if who == player.DisplayName and pts > 0 then
		showVerdict((swish and "Swish! " or "") .. "+" .. pts, pts == 3 and Color3.fromRGB(255, 200, 70) or Color3.fromRGB(90, 230, 130))
	end
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX8"><Properties><string name="Name">PoolService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PoolService (server): unicorn floaties that ride the water like real inflatables, the jump-through fun, and the
-- swim / dive pose relay so every player sees how each swimmer is moving (PoolClient does the swimming itself).
--
-- Floaty physics: a very light vinyl ring (about 3 mass) floating high (a third of the tube under), bobbing on
-- small waves, drifting slowly, pushed around by swimmers and kept off the pool walls. Stand on it and it sinks
-- most of the way (it can carry about one person fully pushed under); land on the edge and it tips, then rights
-- itself. The ring's hole (3.4 studs) is open: drop through it from the board or the deck for a "unicorn hoop".
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local Remotes = RS:FindFirstChild("Remotes")
if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "Remotes"
	Remotes.Parent = RS
end
local function remote(name)
	local r = Remotes:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = Remotes
	end
	return r
end
local PoseRE = remote("SwimPose") -- client -> server: "swim" | "dive" | "cannon" | "climb" | nil
local HoopRE = remote("FloatyHoop") -- server -> all: (floaty, player, count)

local POSES = { swim = true, dive = true, cannon = true, climb = true }
PoseRE.OnServerEvent:Connect(function(player, pose)
	local char = player.Character
	if char then
		char:SetAttribute("SwimPose", POSES[pose] and pose or nil)
	end
end)

local CARRY = 16 -- extra mass the floaty holds up when pushed all the way under (about one person)
local floaties = {}

local function waterFor(pos)
	for _, w in CollectionService:GetTagged("NC_Water") do
		if w:IsA("BasePart") and w:IsDescendantOf(workspace) then
			local lp = w.CFrame:PointToObjectSpace(pos)
			local h = w.Size / 2
			if math.abs(lp.X) <= h.X + 1 and math.abs(lp.Z) <= h.Z + 1 and lp.Y <= h.Y + 10 and lp.Y >= -h.Y - 2 then
				return w
			end
		end
	end
	return nil
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = a, b
	w.Parent = b
end

local function setup(model)
	if floaties[model] or not model:IsDescendantOf(workspace) then
		return
	end
	local body = model.PrimaryPart or model:FindFirstChild("Body")
	if not (body and body:IsA("BasePart")) then
		return
	end
	local R = model:GetAttribute("RingRadius") or 2.7
	local r = model:GetAttribute("TubeRadius") or 1.0
	local folder = Instance.new("Folder")
	folder.Name = "Physics"
	-- the ring: 16 overlapping vinyl balls round the tube (the hole stays open), springy like a pumped-up float
	local vinyl = PhysicalProperties.new(0.04, 0.35, 0.9, 1, 8)
	for k = 0, 15 do
		local a = 2 * math.pi * k / 16
		local ball = Instance.new("Part")
		ball.Name = "Tube"
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.one * (2 * r)
		ball.CFrame = body.CFrame * CFrame.new(math.cos(a) * R, 0, math.sin(a) * R)
		ball.Transparency = 1
		ball.CastShadow = false
		ball.CustomPhysicalProperties = vinyl
		ball.Parent = folder
		weld(body, ball)
	end
	local nmin, nmax = model:GetAttribute("NeckMin"), model:GetAttribute("NeckMax")
	if typeof(nmin) == "Vector3" and typeof(nmax) == "Vector3" then
		local neck = Instance.new("Part")
		neck.Name = "Neck"
		neck.Size = (nmax - nmin) * Vector3.new(0.8, 1, 0.8)
		neck.CFrame = body.CFrame * CFrame.new((nmin + nmax) / 2)
		neck.Transparency = 1
		neck.CastShadow = false
		neck.CustomPhysicalProperties = vinyl
		neck.Parent = folder
		weld(body, neck)
	end
	folder.Parent = model
	local att = Instance.new("Attachment")
	att.Name = "Float"
	att.Parent = body
	local vf = Instance.new("VectorForce")
	vf.Name = "Buoyancy"
	vf.Attachment0 = att
	vf.RelativeTo = Enum.ActuatorRelativeTo.World
	vf.ApplyAtCenterOfMass = true
	vf.Force = Vector3.zero
	vf.Parent = body
	local tq = Instance.new("Torque")
	tq.Name = "Righting"
	tq.Attachment0 = att
	tq.RelativeTo = Enum.ActuatorRelativeTo.World
	tq.Torque = Vector3.zero
	tq.Parent = body
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
		end
	end
	pcall(function()
		body:SetNetworkOwner(nil)
	end)
	local w = waterFor(body.Position)
	floaties[model] = {
		body = body, vf = vf, tq = tq, R = R, r = r, hole = model:GetAttribute("HoleRadius") or (R - r),
		home = body.CFrame, water = w, seed = math.random() * 100, last = {}, cool = {}, lost = 0, flipped = 0,
	}
end

task.spawn(function()
	while true do
		for _, m in CollectionService:GetTagged("NC_Floaty") do
			if not floaties[m] and m:IsDescendantOf(workspace) then
				task.spawn(setup, m)
			end
		end
		for m in floaties do
			if not m:IsDescendantOf(workspace) then
				floaties[m] = nil
			end
		end
		task.wait(1)
	end
end)

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for model, f in floaties do
		local body = f.body
		if not body.Parent then
			floaties[model] = nil
			continue
		end
		local g = workspace.Gravity
		local M = body.AssemblyMass
		local pos, vel = body.Position, body.AssemblyLinearVelocity
		local up = body.CFrame.UpVector
		local w = f.water
		if not (w and w.Parent) or not waterFor(pos) then
			w = waterFor(pos)
			f.water = w
		end
		local force = Vector3.zero
		if w then
			local surf = w.Position.Y + w.Size.Y / 2 + 0.05 * math.sin(now * 1.4 + f.seed) -- small waves
			local bottom = pos.Y - f.r * math.max(0.35, math.abs(up.Y))
			local sub = math.clamp((surf - bottom) / (2 * f.r), 0, 1)
			local k = (M + CARRY) * g
			local damp = 2 * 0.35 * math.sqrt(k / (2 * f.r) * M) -- lightly damped bob
			local fy = k * sub - (sub > 0 and damp * vel.Y or 0)
			-- water drag on drifting + a slow wander, kept off the walls
			local hv = Vector3.new(vel.X, 0, vel.Z)
			local wander = Vector3.new(math.noise(now * 0.05, f.seed), 0, math.noise(f.seed, now * 0.05)) * M * 1.5
			local lp = w.CFrame:PointToObjectSpace(pos)
			local h = w.Size / 2
			local margin = f.R + f.r + 0.2
			local push = Vector3.new(
				math.max(0, lp.X - (h.X - margin)) * -1 + math.max(0, -lp.X - (h.X - margin)),
				0,
				math.max(0, lp.Z - (h.Z - margin)) * -1 + math.max(0, -lp.Z - (h.Z - margin))
			)
			force = Vector3.new(0, fy, 0) - hv * (M + 4) * 1.4 * sub + wander * sub + w.CFrame:VectorToWorldSpace(push) * M * 40
			f.lost = 0
		else
			f.lost += dt
		end
		f.vf.Force = force
		-- keep it upright (it tips when someone lands on the edge, then comes back); damp spinning
		local av = body.AssemblyAngularVelocity
		local kr = up.Y < 0.2 and 2600 or 900
		if up.Y < 0.2 then
			f.flipped += dt
		else
			f.flipped = 0
		end
		if f.flipped > 4 then
			kr = 6000 -- an upside-down float gets turned back over after a while
		end
		f.tq.Torque = up:Cross(Vector3.yAxis) * kr - Vector3.new(av.X, 0, av.Z) * 70 - Vector3.new(0, av.Y, 0) * 25
		-- lost (thrown out of the pool, fell through the world): back home after a while
		if f.lost > 15 or pos.Y < f.home.Y - 60 then
			body.AssemblyLinearVelocity, body.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			model:PivotTo(f.home)
			f.lost = 0
		end
		-- the jump-through: a player's middle passing down through the ring plane inside the hole
		for _, p in Players:GetPlayers() do
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then
				f.last[p] = nil
				continue
			end
			local lp = body.CFrame:PointToObjectSpace(hrp.Position)
			local near = Vector2.new(lp.X, lp.Z).Magnitude < f.R + f.r + 3 and math.abs(lp.Y) < 9
			local prev = f.last[p]
			if near and prev and prev.Y > 0.3 and lp.Y <= 0.3 then
				local t = (prev.Y - 0.3) / math.max(1e-3, prev.Y - lp.Y)
				local c = prev:Lerp(lp, t)
				if Vector2.new(c.X, c.Z).Magnitude < f.hole + 0.25 and now - (f.cool[p] or 0) > 1.2 then
					f.cool[p] = now
					local n = (p:GetAttribute("UnicornHoops") or 0) + 1
					p:SetAttribute("UnicornHoops", n)
					HoopRE:FireAllClients(model, p, n)
				end
			end
			f.last[p] = near and lp or nil
		end
	end
end)

Players.PlayerRemoving:Connect(function(p)
	for _, f in floaties do
		f.last[p], f.cool[p] = nil, nil
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX9"><Properties><string name="Name">PoolClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- PoolClient: swimming, the springboard, dives and splashes. Works in any part tagged NC_Water (an invisible box
-- whose top face is the water surface: every Blender pool gets one from BuildingKit).
--
-- Swimming (your own character, physics run on your machine like normal walking):
--   * Get in deeper than your chest (or jump/dive in) and you swim. WASD swims where the camera looks: look down
--     and you dive under, look up and you come back up; Space rises, C (or Ctrl, B on a pad) sinks.
--   * Real water: you keep your momentum and the water bleeds it off (quadratic drag), so a dive carries you a few
--     studs deep and then you float back up; you float with your head out when you stop. ~9 studs/s freestyle at
--     the surface (a fit swimmer's 2 m/s at this scale), slower underwater.
--   * Space at the wall pulls you out onto the deck. Walk out up the steps. Chest-deep water slows walking.
-- Swim motions (everyone sees them, on every client): freestyle with alternating arm windmill, high-elbow recovery,
-- body roll, a six-beat flutter kick and a breath to the side; treading water with sculling arms and an eggbeater
-- kick when you stop; arms-overhead streamline on a dive, a tuck for a cannonball, a pull-up at the wall.
-- Springboard: walk out to the end and jump. Land back on the end and jump again right as you touch down to ride
-- the board's recoil higher (up to 4 bounces). Off the end you dive head-first (the body follows the arc), or press
-- C in the air for a cannonball. Flight uses real gravity (37 studs/s^2), so the air time is a real diver's ~1.3 s.
-- Splashes, ripples, stroke splashes and sounds for everyone; underwater the view turns blue and muffled.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Remotes = RS:WaitForChild("Remotes")
local PoseRE = Remotes:WaitForChild("SwimPose")
local HoopRE = Remotes:WaitForChild("FloatyHoop")

local G_REAL = 37.0
local SWIM_SPEED, UNDER_SPEED = 9.0, 7.5
local SND_SPLASH = "rbxasset://sounds/impact_water.mp3"
local SND_STROKE = "rbxasset://sounds/action_swim.mp3"
local SND_BOARD = "rbxasset://sounds/action_jump_land.mp3"
local TEX_DROP = "rbxasset://textures/particles/smoke_main.dds"
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local BOUNCE_VY = { 13, 17, 21, 24 } -- springboard launch speeds: about 2, 4, 6 and 8 studs over the board
local rad = math.rad
local TAU = 2 * math.pi

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

-- the water a point is in (or up to 12 studs above): part, surface height
local function waterAt(pos, slack)
	-- where volumes overlap (a raised spa set into a pool) the highest surface wins
	slack = slack or 0
	local best, bestTop = nil, -math.huge
	for _, w in CollectionService:GetTagged("NC_Water") do
		if w:IsA("BasePart") and w:IsDescendantOf(workspace) then
			local lp = w.CFrame:PointToObjectSpace(pos)
			local h = w.Size * 0.5
			if math.abs(lp.X) <= h.X + slack and math.abs(lp.Z) <= h.Z + slack and lp.Y <= h.Y + 12 and lp.Y >= -h.Y - 1 then
				local top = w.Position.Y + h.Y
				if top > bestTop then
					best, bestTop = w, top
				end
			end
		end
	end
	if best then
		return best, bestTop
	end
	return nil
end

local function bodyOf(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local head = char and char:FindFirstChild("Head")
	if hrp and hum and head then
		return hrp, hum, head
	end
	return nil
end

local function sound(parent, id, volume, speed, maxDist)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.PlaybackSpeed = speed * (0.94 + math.random() * 0.12)
	s.RollOffMinDistance = 6
	s.RollOffMaxDistance = maxDist or 90
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 3)
end

local function fxAnchor(pos)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one * 0.2
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	Debris:AddItem(p, 3)
	return p
end

---------------------------------------------------------------------------------------------- splashes
local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = props.Texture or TEX_DROP
	e.Rate = 0
	e.EmissionDirection = Enum.NormalId.Top
	for k, v in props do
		if k ~= "Texture" and k ~= "Count" then
			e[k] = v
		end
	end
	e.Parent = parent
	e:Emit(props.Count)
	return e
end

local function ripple(pos, size, time)
	local r = Instance.new("Part")
	r.Shape = Enum.PartType.Cylinder
	r.Anchored, r.CanCollide, r.CanQuery, r.CanTouch = true, false, false, false
	r.Material = Enum.Material.SmoothPlastic
	r.Color = Color3.fromRGB(235, 248, 255)
	r.Transparency = 0.45
	r.Size = Vector3.new(0.04, 1.2, 1.2)
	r.CFrame = CFrame.new(pos + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	r.Parent = workspace
	TweenService:Create(r, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.04, size, size), Transparency = 1 }):Play()
	Debris:AddItem(r, time + 0.1)
end

local function splash(pos, speed, big)
	local s = math.clamp(speed / 30, 0.25, 1.4) * (big and 1.8 or 1)
	local a = fxAnchor(pos)
	local white = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 235, 255))
	emitter(a, { -- the column and droplets
		Count = math.floor(45 * s), Color = white, Speed = NumberRange.new(9 * s, 24 * s), SpreadAngle = Vector2.new(22, 22),
		Acceleration = Vector3.new(0, -55, 0), Lifetime = NumberRange.new(0.5, 1.1), Drag = 0.6,
		Size = NumberSequence.new(0.42, 0.12), Transparency = NumberSequence.new(0.05, 1),
	})
	emitter(a, { -- the crown and mist
		Count = math.floor(20 * s), Color = white, Speed = NumberRange.new(3 * s, 8 * s), SpreadAngle = Vector2.new(85, 85),
		Acceleration = Vector3.new(0, -10, 0), Lifetime = NumberRange.new(0.6, 1.3), Drag = 1.5,
		Size = NumberSequence.new(1.0 * s, 2.6 * s), Transparency = NumberSequence.new(0.35, 1),
	})
	ripple(pos, 7 + 9 * s, 1.4)
	ripple(pos, 4 + 5 * s, 0.9)
	sound(a, SND_SPLASH, math.clamp(0.35 + 0.45 * s, 0.3, 1.2), big and 0.8 or 1.0, 120)
end

local function strokeSplash(pos)
	local a = fxAnchor(pos)
	emitter(a, {
		Count = 6, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)), Speed = NumberRange.new(4, 9), SpreadAngle = Vector2.new(35, 35),
		Acceleration = Vector3.new(0, -50, 0), Lifetime = NumberRange.new(0.3, 0.6), Size = NumberSequence.new(0.25, 0.08),
		Transparency = NumberSequence.new(0.1, 1),
	})
	sound(a, SND_STROKE, 0.18, 1.0, 60)
end

---------------------------------------------------------------------------------------------- joints (all rigs)
local JOINTS = { "RightShoulder", "RightElbow", "LeftShoulder", "LeftElbow", "RightHip", "RightKnee", "LeftHip", "LeftKnee",
	"RightAnkle", "LeftAnkle", "Neck", "Waist" }
local JSET = {}
for _, n in JOINTS do
	JSET[n] = true
end
local jointCache = setmetatable({}, { __mode = "k" })
local function jointsOf(char)
	local e = jointCache[char]
	if e and (e.n >= 10 or os.clock() - e.t < 2) then
		return e
	end
	e = { n = 0, t = os.clock() }
	for _, d in char:GetDescendants() do
		if JSET[d.Name] and (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) and not e[d.Name] then
			e[d.Name] = d
			e.n += 1
		end
	end
	jointCache[char] = e
	return e
end

-- rotation-only override: q = where Part1 points relative to Part0 (identity = the rig's rest pose)
local function setJoint(j, q, alpha)
	if not j then
		return
	end
	local c0, c1
	if j:IsA("Motor6D") then
		c0, c1 = j.C0.Rotation, j.C1.Rotation
	else
		local a0, a1 = j.Attachment0, j.Attachment1
		local p0 = a0 and a0:FindFirstAncestorWhichIsA("BasePart")
		local p1 = a1 and a1:FindFirstAncestorWhichIsA("BasePart")
		if not (p0 and p1) then
			return
		end
		c0, c1 = p0.CFrame:ToObjectSpace(a0.WorldCFrame).Rotation, p1.CFrame:ToObjectSpace(a1.WorldCFrame).Rotation
	end
	local target = c0:Inverse() * q * c1
	j.Transform = alpha < 1 and j.Transform:Lerp(target, alpha) or target
end

local A = CFrame.Angles
local function poseFreestyle(J, ph, w)
	local th = math.pi - TAU * ph -- overhead -> pull under the body -> hips -> recover over the back
	setJoint(J.RightShoulder, A(th, 0, rad(8)), w)
	setJoint(J.LeftShoulder, A(th + math.pi, 0, rad(-8)), w)
	setJoint(J.RightElbow, A(rad(15 + 80 * math.max(0, -math.sin(th))), 0, 0), w)
	setJoint(J.LeftElbow, A(rad(15 + 80 * math.max(0, -math.sin(th + math.pi))), 0, 0), w)
	local kick = math.sin(ph * TAU * 3) -- six-beat kick
	setJoint(J.RightHip, A(rad(14 * kick), 0, 0), w)
	setJoint(J.LeftHip, A(rad(-14 * kick), 0, 0), w)
	setJoint(J.RightKnee, A(rad(-8 - 16 * math.max(0, kick)), 0, 0), w)
	setJoint(J.LeftKnee, A(rad(-8 - 16 * math.max(0, -kick)), 0, 0), w)
	setJoint(J.RightAnkle, A(rad(-40), 0, 0), w)
	setJoint(J.LeftAnkle, A(rad(-40), 0, 0), w)
	setJoint(J.Neck, A(0, rad(70 * math.max(0, math.sin(ph * math.pi)) ^ 6), 0), w) -- breathe every other stroke
end

local function poseTread(J, ph, w)
	local sc = math.sin(ph * TAU)
	setJoint(J.RightShoulder, A(rad(20), rad(25 * sc), rad(70)), w)
	setJoint(J.LeftShoulder, A(rad(20), rad(-25 * sc), rad(-70)), w)
	setJoint(J.RightElbow, A(rad(35), 0, 0), w)
	setJoint(J.LeftElbow, A(rad(35), 0, 0), w)
	setJoint(J.RightHip, A(rad(40 + 25 * sc), 0, rad(10)), w)
	setJoint(J.LeftHip, A(rad(40 - 25 * sc), 0, rad(-10)), w)
	setJoint(J.RightKnee, A(rad(-60 - 25 * sc), 0, 0), w)
	setJoint(J.LeftKnee, A(rad(-60 + 25 * sc), 0, 0), w)
end

local function poseDive(J, w)
	setJoint(J.RightShoulder, A(rad(178), 0, rad(-6)), w)
	setJoint(J.LeftShoulder, A(rad(178), 0, rad(6)), w)
	for _, n in { "RightElbow", "LeftElbow", "RightHip", "LeftHip", "RightKnee", "LeftKnee", "Waist" } do
		setJoint(J[n], CFrame.identity, w)
	end
	setJoint(J.RightAnkle, A(rad(-45), 0, 0), w)
	setJoint(J.LeftAnkle, A(rad(-45), 0, 0), w)
end

local function poseCannon(J, w)
	setJoint(J.RightHip, A(rad(115), 0, 0), w)
	setJoint(J.LeftHip, A(rad(115), 0, 0), w)
	setJoint(J.RightKnee, A(rad(-135), 0, 0), w)
	setJoint(J.LeftKnee, A(rad(-135), 0, 0), w)
	setJoint(J.RightShoulder, A(rad(75), 0, rad(-20)), w)
	setJoint(J.LeftShoulder, A(rad(75), 0, rad(20)), w)
	setJoint(J.RightElbow, A(rad(95), 0, 0), w)
	setJoint(J.LeftElbow, A(rad(95), 0, 0), w)
	setJoint(J.Waist, A(rad(-25), 0, 0), w)
	setJoint(J.Neck, A(rad(-20), 0, 0), w)
end

local function poseClimb(J, k, w)
	setJoint(J.RightShoulder, A(rad(150 - 135 * k), 0, rad(10)), w) -- reach onto the deck, then press down
	setJoint(J.LeftShoulder, A(rad(150 - 135 * k), 0, rad(-10)), w)
	setJoint(J.RightElbow, A(rad(40 * (1 - k)), 0, 0), w)
	setJoint(J.LeftElbow, A(rad(40 * (1 - k)), 0, 0), w)
	setJoint(J.RightHip, A(rad(85 * k * k), 0, 0), w) -- knee up onto the coping at the end
	setJoint(J.RightKnee, A(rad(-90 * k * k), 0, 0), w)
end

---------------------------------------------------------------------------------------------- local swimmer state
local S = { on = false, v = Vector3.zero, phase = 0, moving = false, climb = nil, pose = nil, height = 5.2 }
local B = { air = false, diving = false, cannon = false, level = 0, lastLand = -9, pending = nil, right = nil, board = nil }
local movers = {}

local function setPose(p)
	if S.pose ~= p then
		S.pose = p
		PoseRE:FireServer(p)
	end
end

local function clearMovers()
	for _, m in movers do
		if typeof(m) == "Instance" then
			m:Destroy()
		end
	end
	movers = {}
end

local function makeMovers(hrp, withVelocity)
	clearMovers()
	local att = Instance.new("Attachment")
	att.Name = "NC_SwimAtt"
	att.Parent = hrp
	local ao = Instance.new("AlignOrientation")
	ao.Name = "NC_SwimAlign"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.Responsiveness = 12
	ao.MaxTorque = math.huge
	ao.CFrame = hrp.CFrame.Rotation
	ao.Parent = hrp
	movers.att, movers.ao = att, ao
	if withVelocity then
		local lv = Instance.new("LinearVelocity")
		lv.Name = "NC_SwimVel"
		lv.Attachment0 = att
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.MaxForce = hrp.AssemblyMass * 4000
		lv.VectorVelocity = hrp.AssemblyLinearVelocity
		lv.Parent = hrp
		movers.lv = lv
	end
end

local function gravityForce(on)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local vf = hrp:FindFirstChild("NC_RealG")
	if on then
		if not vf then
			local a = Instance.new("Attachment")
			a.Name = "NC_RealGAtt"
			a.Parent = hrp
			vf = Instance.new("VectorForce")
			vf.Name = "NC_RealG"
			vf.Attachment0 = a
			vf.RelativeTo = Enum.ActuatorRelativeTo.World
			vf.ApplyAtCenterOfMass = true
			vf.Parent = hrp
		end
		vf.Force = Vector3.new(0, hrp.AssemblyMass * (workspace.Gravity - G_REAL), 0) -- what's left falls at 37
		vf.Enabled = true
	elseif vf then
		vf.Enabled = false
	end
end

local function endAir()
	B.air, B.diving, B.cannon = false, false, false
	gravityForce(false)
end

local function startSwim(hrp, hum)
	if S.on then
		return
	end
	S.on, S.climb = true, nil
	S.v = hrp.AssemblyLinearVelocity
	endAir()
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, t in animator:GetPlayingAnimationTracks() do
			t:Stop(0.25)
		end
	end
	makeMovers(hrp, true)
	setPose("swim")
end

local function stopSwim(hum, nextState)
	S.on, S.climb = false, nil
	clearMovers()
	setPose(nil)
	if hum then
		hum:ChangeState(nextState or Enum.HumanoidStateType.Freefall)
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function refreshFilter()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	for _, f in CollectionService:GetTagged("NC_Floaty") do
		table.insert(list, f)
	end
	rayParams.FilterDescendantsInstances = list
end

local function floorBelow(pos)
	local hit = workspace:Raycast(pos, Vector3.new(0, -40, 0), rayParams)
	return hit and hit.Position.Y or (pos.Y - 40)
end

-- Space at the surface facing the wall: is there a deck to climb onto? (the floaty counts: you can climb on it)
local climbParams = RaycastParams.new()
climbParams.FilterType = Enum.RaycastFilterType.Exclude
local function tryClimb(hrp, surf, fl)
	climbParams.FilterDescendantsInstances = { player.Character }
	local o = Vector3.new(hrp.Position.X, surf + 0.3, hrp.Position.Z)
	local hit = workspace:Raycast(o, fl * 2.8, climbParams)
	if not hit then
		return false
	end
	local top = workspace:Raycast(hit.Position + fl * 1.0 + Vector3.new(0, 4, 0), Vector3.new(0, -6, 0), climbParams)
	if not top or top.Position.Y < surf or top.Position.Y - surf > 2.0 then
		return false
	end
	S.climb = { t = 0, from = hrp.Position, wall = hit.Position, top = top.Position, fl = fl }
	return true
end

local function climbStep(dt, hrp, hum)
	local c = S.climb
	c.t += dt
	local standY = c.top.Y + hrp.Size.Y / 2 + hum.HipHeight
	local T1, T2 = 0.5, 0.35
	local wallXZ = Vector3.new(c.wall.X, 0, c.wall.Z)
	local target
	if c.t < T1 then -- pull up at the wall
		local a = c.t / T1
		local at = wallXZ - c.fl * 0.9
		target = Vector3.new(at.X, c.from.Y + (standY + 0.4 - c.from.Y) * a, at.Z)
	elseif c.t < T1 + T2 then -- swing onto the deck
		local a = (c.t - T1) / T2
		local at = wallXZ + c.fl * (-0.9 + 2.6 * a)
		target = Vector3.new(at.X, standY + 0.4, at.Z)
	else
		stopSwim(hum, Enum.HumanoidStateType.GettingUp)
		return
	end
	local v = (target - hrp.Position) * 14
	if v.Magnitude > 30 then
		v = v.Unit * 30
	end
	movers.lv.VectorVelocity = v
	movers.ao.CFrame = CFrame.lookAt(Vector3.zero, c.fl)
	S.climbK = math.clamp(c.t / (T1 + T2), 0, 1)
	setPose("climb")
end

local function swimStep(dt, hrp, hum)
	local w, surf = waterAt(hrp.Position)
	if not w or hrp.Position.Y > surf + 1.2 then
		stopSwim(hum)
		return
	end
	local cam = workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local fl = flat(look)
	fl = fl.Magnitude > 0.01 and fl.Unit or flat(hrp.CFrame.LookVector).Unit
	local md = hum.MoveDirection
	local fwdAmt = md:Dot(fl)
	local dir = look * fwdAmt + (md - fl * fwdAmt)
	local upKey = hum.Jump or UserInputService:IsKeyDown(Enum.KeyCode.Space)
	local downKey = UserInputService:IsKeyDown(Enum.KeyCode.C) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonB)
	local moving = dir.Magnitude > 0.1
	local floatY = surf - (moving and 0.45 or 0.95) -- prone: back at the surface; upright: head out
	local atSurface = hrp.Position.Y > floatY - 0.7
	if atSurface and dir.Y > 0 then
		dir = flat(dir)
	end
	if upKey and atSurface and tryClimb(hrp, surf, fl) then
		return
	end
	-- stand up in shallow water when you stop (or on the steps)
	local depth = surf - floorBelow(hrp.Position)
	if (depth < 0.6 * S.height) or (not moving and not downKey and depth < 0.82 * S.height and S.v.Y > -1) then
		stopSwim(hum)
		return
	end
	local speed = atSurface and SWIM_SPEED or UNDER_SPEED
	local desired = moving and dir.Unit * math.min(dir.Magnitude, 1) * speed or Vector3.zero
	if downKey then
		desired += Vector3.new(0, -6, 0)
	elseif upKey and not atSurface then
		desired += Vector3.new(0, 6, 0)
	end
	if not downKey and not (moving and dir.Y < -0.25) then -- buoyancy: back to floating level
		desired += Vector3.new(0, math.clamp((floatY - hrp.Position.Y) * 1.8, -3, 3.5), 0)
	end
	local diff = desired - S.v
	local k = 2.4 + 0.11 * diff.Magnitude -- quadratic water drag: bleeds a dive fast, gentle at swimming speed
	S.v += diff * (1 - math.exp(-k * dt))
	movers.lv.VectorVelocity = S.v
	local spd = S.v.Magnitude
	S.moving = moving and spd > 1.5
	S.atSurface = atSurface
	if S.moving then
		local d = atSurface and flat(S.v) or S.v
		d = d.Magnitude > 0.5 and d.Unit or fl
		local back = Vector3.yAxis - d * d.Y
		if back.Magnitude < 0.2 then
			back = -fl
		end
		back = back.Unit
		local roll = atSurface and math.sin(S.phase * TAU) * rad(28) or 0 -- freestyle body roll
		movers.ao.CFrame = CFrame.fromMatrix(Vector3.zero, d:Cross(back), d, back) * A(0, roll, 0)
	else
		movers.ao.CFrame = CFrame.lookAt(Vector3.zero, fl)
	end
end

---------------------------------------------------------------------------------------------- springboards
local boards = {}
local W0, ZETA = TAU * 2.0, 0.12 -- a loaded 1 m board rings at about 2 Hz
local function boardState(m)
	local st = boards[m]
	if st then
		return st
	end
	local pivot = m.PrimaryPart or m:FindFirstChild("Pivot")
	if not pivot then
		return nil
	end
	st = { pivot = pivot, rest = {}, theta = 0, omega = 0, L = m:GetAttribute("Length") or 9.2, W = m:GetAttribute("Width") or 2.0, on = {}, vy = {} }
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") and p ~= pivot then
			st.rest[p] = pivot.CFrame:ToObjectSpace(p.CFrame)
		end
	end
	boards[m] = st
	return st
end

-- where a character stands on a board: along (0 at the anchor .. L at the tip), or nil
local function onBoard(st, hrp, hum)
	local lp = st.pivot.CFrame:PointToObjectSpace(hrp.Position)
	local s = -lp.Z
	local feet = lp.Y - (hrp.Size.Y / 2 + hum.HipHeight)
	if s > -0.3 and s < st.L + 0.4 and math.abs(lp.X) < st.W / 2 + 0.5 and math.abs(feet - 0.25) < 0.8 then
		return s
	end
	return nil
end

local function overBoard(st, hrp)
	local lp = st.pivot.CFrame:PointToObjectSpace(hrp.Position)
	return -lp.Z < st.L + 0.6 and math.abs(lp.X) < st.W / 2 + 1.2
end

local function updateBoards(dt)
	for _, m in CollectionService:GetTagged("NC_DivingBoard") do
		if m:IsDescendantOf(workspace) then
			boardState(m)
		end
	end
	for m, st in boards do
		if not m:IsDescendantOf(workspace) then
			boards[m] = nil
			continue
		end
		local static = 0
		for _, p in Players:GetPlayers() do
			local hrp, hum = bodyOf(p.Character)
			if hrp then
				local s = onBoard(st, hrp, hum)
				if s then
					static += rad(3.2) * (s / st.L)
					local lastVy = st.vy[p] or 0
					if not st.on[p] and lastVy < -8 then -- landed: the board takes the hit
						st.omega += 0.026 * -lastVy * (s / st.L)
						sound(st.pivot, SND_BOARD, math.clamp(-lastVy / 30, 0.2, 0.8), 0.85, 80)
						if p == player then
							B.lastLand = os.clock()
						end
					end
				end
				st.on[p] = s
				st.vy[p] = hrp.AssemblyLinearVelocity.Y
			end
		end
		local acc = -W0 * W0 * (st.theta - static) - 2 * ZETA * W0 * st.omega
		st.omega += acc * dt
		st.theta = math.clamp(st.theta + st.omega * dt, -rad(4), rad(9))
		local base = st.pivot.CFrame * A(-st.theta, 0, 0) -- tip down for positive theta
		for p, off in st.rest do
			p.CFrame = base * off
		end
	end
end

local function boardJump(hrp, hum)
	for _, st in boards do
		local s = st.on[player]
		if s and s > st.L * 0.45 then
			local since = os.clock() - B.lastLand
			if since < 0.22 then
				B.level = math.min(#BOUNCE_VY, B.level + 1) -- rode the recoil
			elseif since > 1.0 then
				B.level = 1
			else
				B.level = math.max(1, B.level)
			end
			local fwd = flat(st.pivot.CFrame.LookVector).Unit
			local md = hum.MoveDirection
			local along = md:Dot(fwd)
			local horiz = fwd * (along > 0.3 and 6 or 0.6) + (md - fwd * along) * 2
			local vy = BOUNCE_VY[B.level] * (0.85 + 0.15 * s / st.L)
			B.pending = horiz + Vector3.new(0, vy, 0)
			B.air, B.diving, B.cannon, B.board = true, false, false, st
			B.right = fwd:Cross(Vector3.yAxis).Unit
			st.omega -= 0.03 * vy -- the board snaps up as it lets go
			gravityForce(true)
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------------------------- character hookup
local function onCharacter(char)
	S.on, S.climb, S.pose = false, nil, nil
	B.air, B.diving, B.cannon, B.level = false, false, false, 0
	movers = {}
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end
	hum.StateChanged:Connect(function(_, new)
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		if new == Enum.HumanoidStateType.Jumping then
			if not boardJump(hrp, hum) and waterAt(hrp.Position) then
				-- an ordinary jump from the deck: normal jump physics, but C still tucks a cannonball
				B.air, B.diving, B.cannon, B.board = true, false, false, nil
				B.right = flat(workspace.CurrentCamera.CFrame.LookVector):Cross(Vector3.yAxis)
				B.right = B.right.Magnitude > 0.01 and B.right.Unit or Vector3.xAxis
			end
		elseif B.air and not B.diving and (new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running) then
			endAir()
			setPose(nil)
		end
	end)
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then
		return
	end
	if (input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.ButtonB) and B.air and not S.on then
		B.cannon = true
		setPose("cannon")
	end
end)

---------------------------------------------------------------------------------------------- the step
local poseState = setmetatable({}, { __mode = "k" }) -- char -> { phase, blend, last }
local track = setmetatable({}, { __mode = "k" }) -- char -> last HRP height (splash detection)
local frame = 0
local wade = { base = nil, set = nil }

RunService.Stepped:Connect(function(_, dt)
	frame += 1
	if frame % 30 == 1 then
		refreshFilter()
	end
	updateBoards(dt)
	local char = player.Character
	local hrp, hum, head = bodyOf(char)
	if hrp and hum.Health > 0 then
		if B.pending then
			hrp.AssemblyLinearVelocity = B.pending
			B.pending = nil
		end
		if not S.on and hrp.CFrame.UpVector.Y > 0.95 then
			S.height = (hrp.Size.Y / 2 + hum.HipHeight) + (head.Position.Y + head.Size.Y / 2 - hrp.Position.Y)
		end
		local w, surf = waterAt(hrp.Position)
		if S.on then
			if S.climb then
				climbStep(dt, hrp, hum)
			else
				swimStep(dt, hrp, hum)
			end
		else
			-- airborne over the pool: dive / cannonball attitude, then into the water
			if B.air then
				local vel = hrp.AssemblyLinearVelocity
				if w and not B.diving and vel.Y < -1 and B.board and not overBoard(B.board, hrp) then
					B.diving, B.diveStart = true, os.clock()
					hum:ChangeState(Enum.HumanoidStateType.Physics)
					makeMovers(hrp, false)
					setPose(B.cannon and "cannon" or "dive")
				end
				if B.diving and movers.ao then
					local right = B.right or Vector3.xAxis
					if B.cannon then
						local f = Vector3.yAxis:Cross(right) -- forward, off the end of the board
						movers.ao.CFrame = CFrame.lookAt(Vector3.zero, f) * A(rad(10), 0, 0)
					else
						-- head leads along the arc: upright on the way up, flat at the top, head-first at entry
						local u = vel.Magnitude > 1 and vel.Unit or Vector3.yAxis
						u = u - right * u:Dot(right)
						u = u.Magnitude > 0.05 and u.Unit or Vector3.yAxis
						movers.ao.CFrame = CFrame.fromMatrix(Vector3.zero, right, u, right:Cross(u))
					end
				end
				-- came down on the deck instead of the water: get back on your feet
				if B.diving and (not w or os.clock() - (B.diveStart or 0) > 3 or (vel.Magnitude < 2 and floorBelow(hrp.Position) > hrp.Position.Y - 3.5)) then
					clearMovers()
					endAir()
					setPose(nil)
					hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				elseif os.clock() - B.lastLand > 6 and not w and not B.diving then
					endAir()
				end
			end
			-- into the water: swim when deeper than your chest (or arriving from the air)
			if w and hrp.Position.Y < surf then
				local feet = hrp.Position.Y - hrp.Size.Y / 2 - hum.HipHeight
				local sub = surf - feet
				local st = hum:GetState()
				local airborne = B.diving or st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Jumping
				if B.diving then
					sub = surf - (hrp.Position.Y - 2) -- head-first: count from the hands
				end
				if (airborne and sub > 0.55 * S.height) or (sub > 0.62 * S.height and surf - floorBelow(hrp.Position) > 0.85 * S.height) then
					startSwim(hrp, hum)
				end
			end
			-- wading: chest-deep water drags at your legs
			local feet = hrp.Position.Y - hrp.Size.Y / 2 - hum.HipHeight
			local d = (w and not S.on) and (surf - feet) or 0
			if d > 0.4 and hum:GetAttribute("NC_Movement") then
				-- the movement system owns WalkSpeed: slow it through a speed factor instead
				hum:SetAttribute("SpeedFactor_Wade", 1 - 0.5 * math.clamp(d / 4, 0, 1))
				wade.attr = true
			elseif d > 0.4 then
				local mult = 1 - 0.5 * math.clamp(d / 4, 0, 1)
				if wade.set == nil or math.abs(hum.WalkSpeed - wade.set) > 0.01 then
					wade.base = hum.WalkSpeed
				end
				wade.set = wade.base * mult
				hum.WalkSpeed = wade.set
			elseif wade.attr then
				hum:SetAttribute("SpeedFactor_Wade", nil)
				wade.attr = nil
			elseif wade.set then
				if math.abs(hum.WalkSpeed - wade.set) < 0.01 then
					hum.WalkSpeed = wade.base
				end
				wade.set, wade.base = nil, nil
			end
		end
	end

	-- poses + splashes for every character (yours from the controller, others from their SwimPose)
	local camPos = workspace.CurrentCamera.CFrame.Position
	for _, p in Players:GetPlayers() do
		local c = p.Character
		local phrp, phum = bodyOf(c)
		if not phrp then
			continue
		end
		local isMe = p == player
		local pose = c:GetAttribute("SwimPose")
		local moving = flat(phrp.AssemblyLinearVelocity).Magnitude > 1.5
		local ph
		if isMe then
			pose = S.on and (S.climb and "climb" or "swim") or ((B.diving or (B.air and B.cannon)) and (B.cannon and "cannon" or "dive")) or nil
			moving = S.moving
		end
		local ps = poseState[c]
		if not ps then
			ps = { phase = 0, blend = 0 }
			poseState[c] = ps
		end
		if pose then
			ps.blend = math.min(1, ps.blend + dt * 6)
			local spd = phrp.AssemblyLinearVelocity.Magnitude
			local before = ps.phase
			ps.phase += dt * ((pose == "swim" and moving) and (0.55 + spd * 0.035) or 0.9)
			if isMe then
				S.phase = ps.phase
			end
			local J = jointsOf(c)
			if pose == "swim" then
				if moving then
					poseFreestyle(J, ps.phase, ps.blend)
					-- a hand enters the water twice per stroke cycle
					if math.floor(before * 2) ~= math.floor(ps.phase * 2) and (phrp.Position - camPos).Magnitude < 70 then
						local hand = c:FindFirstChild(math.floor(ps.phase * 2) % 2 == 0 and "RightHand" or "LeftHand")
						local _, surf = waterAt(phrp.Position)
						if hand and surf and math.abs(hand.Position.Y - surf) < 1.5 then
							strokeSplash(Vector3.new(hand.Position.X, surf, hand.Position.Z))
						end
					end
				else
					poseTread(J, ps.phase, ps.blend)
				end
			elseif pose == "dive" then
				poseDive(J, ps.blend)
			elseif pose == "cannon" then
				poseCannon(J, ps.blend)
			elseif pose == "climb" then
				poseClimb(J, isMe and (S.climbK or 0) or math.clamp(ps.phase % 1, 0, 1), ps.blend)
			end
		else
			ps.blend = 0
		end
		-- splash when anyone hits the water from above
		local w, surf = waterAt(phrp.Position, 1)
		local y = phrp.Position.Y
		local last = track[c]
		if w and last and last > surf + 1.5 and y <= surf + 1.5 then
			local vy = phrp.AssemblyLinearVelocity.Y
			if vy < -7 then -- a clean head-first entry throws far less water than feet or a cannonball
				splash(Vector3.new(phrp.Position.X, surf, phrp.Position.Z), pose == "dive" and -vy * 0.45 or -vy, pose == "cannon")
			end
		end
		track[c] = w and y or nil
	end
end)

---------------------------------------------------------------------------------------------- underwater view
local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "NC_Underwater"
tint.TintColor = Color3.fromRGB(150, 214, 255)
tint.Saturation = 0.1
tint.Contrast = 0.05
tint.Brightness = -0.04
tint.Enabled = false
tint.Parent = Lighting
local blur = Instance.new("BlurEffect")
blur.Name = "NC_UnderwaterBlur"
blur.Size = 6
blur.Enabled = false
blur.Parent = Lighting
local reverbWas = nil
RunService.RenderStepped:Connect(function()
	local cp = workspace.CurrentCamera.CFrame.Position
	local w, surf = waterAt(cp)
	local under = w ~= nil and cp.Y < surf - 0.05
	tint.Enabled, blur.Enabled = under, under
	if under and reverbWas == nil then
		reverbWas = SoundService.AmbientReverb
		SoundService.AmbientReverb = Enum.ReverbType.UnderWater
	elseif not under and reverbWas ~= nil then
		SoundService.AmbientReverb = reverbWas
		reverbWas = nil
	end
end)

---------------------------------------------------------------------------------------------- unicorn hoops
HoopRE.OnClientEvent:Connect(function(floaty, who, count)
	local body = typeof(floaty) == "Instance" and floaty.PrimaryPart
	if not body then
		return
	end
	local a = fxAnchor(body.Position + Vector3.new(0, 1.2, 0))
	emitter(a, {
		Texture = TEX_SPARK, Count = 40, Speed = NumberRange.new(6, 14), SpreadAngle = Vector2.new(60, 60),
		Acceleration = Vector3.new(0, -12, 0), Lifetime = NumberRange.new(0.8, 1.4), Size = NumberSequence.new(0.7, 0.1),
		LightEmission = 0.6, Transparency = NumberSequence.new(0, 1), Rotation = NumberRange.new(0, 360),
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 134, 190)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 110)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(134, 230, 180)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(124, 190, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(184, 150, 245)),
		}),
	})
	sound(a, SND_BOARD, 0.7, 2.2, 90) -- a squeaky boing
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 60)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 120
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.RichText = true
	t.TextColor3 = Color3.fromRGB(255, 190, 230)
	t.TextStrokeTransparency = 0.3
	t.Text = string.format("Unicorn hoop! x%d\n<font size=\"14\">%s</font>", count or 1, typeof(who) == "Instance" and who.DisplayName or "")
	t.Parent = bb
	bb.Parent = a
	TweenService:Create(bb, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = Vector3.new(0, 6, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.0), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">NCWallet</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NCWallet (ModuleScript in ServerScriptService): spend the player's earned money. Uses the game's own NC module
-- (ServerScriptService.NC: NC.GetCash -> leaderstats.Cash, NC.AddCash, NC.Notify), so every purchase lands in
-- the same Cash the jobs, robberies and pickups pay into (and the same DataStore saves it). Falls back to
-- leaderstats.Cash directly if NC isn't there.
local SSS = game:GetService("ServerScriptService")
local RS = game:GetService("ReplicatedStorage")

local NC
do
	local mod = SSS:FindFirstChild("NC") or SSS:WaitForChild("NC", 5)
	if mod then
		local ok, res = pcall(require, mod)
		if ok then
			NC = res
		end
	end
end

local W = {}

function W.Cash(player)
	if NC and NC.GetCash then
		return NC.GetCash(player)
	end
	local ls = player:FindFirstChild("leaderstats")
	return ls and ls:FindFirstChild("Cash")
end

function W.Balance(player)
	local c = W.Cash(player)
	return c and c.Value or 0
end

-- true if the player had the money and it was taken
function W.Spend(player, amount)
	local c = W.Cash(player)
	if not c or c.Value < amount then
		return false
	end
	if NC and NC.AddCash then
		NC.AddCash(player, -amount)
	else
		c.Value -= amount
	end
	return true
end

function W.Refund(player, amount)
	if NC and NC.AddCash then
		NC.AddCash(player, amount)
	else
		local c = W.Cash(player)
		if c then
			c.Value += amount
		end
	end
end

function W.Notify(player, text, color)
	if NC and NC.Notify then
		if pcall(NC.Notify, player, text, color) then
			return
		end
	end
	local remotes = RS:FindFirstChild("Remotes")
	local n = remotes and remotes:FindFirstChild("Notify")
	if n and n:IsA("RemoteEvent") then
		n:FireClient(player, text, color)
	end
end

return W
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX11"><Properties><string name="Name">Elevator</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Elevator (server): the office tower's express elevator, lobby <-> roof. The stairs next to it are free; the
-- elevator costs earned Cash going up (PRICE, through NCWallet -> the game's NC module), coming down is free.
-- BuildingKit puts an ElevatorRoot part (tag NC_Elevator) in the tower with the shaft, car, stops, door and call
-- points as attributes in the tower's own frame; this script builds a real car in the shaft that rides a
-- PrismaticConstraint (so players standing in it are carried by physics, smoothly, with the car), sliding shaft
-- doors at both stops, call panels, a floor display and a chime.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SSS = game:GetService("ServerScriptService")

local PRICE = 50
local SPEED = 26 -- studs/s: lobby to roof (~260 studs) in about 10 s, like a real express car
local Wallet = require(SSS:WaitForChild("NCWallet"))

local function part(name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color or Color3.fromRGB(200, 200, 205)
	p.Material = material or Enum.Material.Metal
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	return p
end

local function chime(where)
	local s = Instance.new("Sound")
	s.SoundId = "rbxasset://sounds/volume_slider.ogg"
	s.PlaybackSpeed = 1.6
	s.Volume = 0.8
	s.RollOffMaxDistance = 60
	s.Parent = where
	s:Play()
	game:GetService("Debris"):AddItem(s, 2)
end

local done = setmetatable({}, { __mode = "k" })
local function setup(root)
	if done[root] then
		return
	end
	done[root] = true
	-- a copy of a tower cloned after its car was built carries a dead car: clear it and build a live one
	local stale = root.Parent and root.Parent:FindFirstChild("ElevatorCar")
	if stale then
		stale:Destroy()
	end
	local cf = root.CFrame
	local A = function(k)
		return root:GetAttribute(k)
	end
	local s0, s1 = A("Stop0"), A("Stop1")
	local price = A("Price") or PRICE
	local cmin, cmax = A("CarMin"), A("CarMax")
	local cw, cd = cmax.X - cmin.X, cmax.Z - cmin.Z
	local ccx, ccz = (cmin.X + cmax.X) / 2, (cmin.Z + cmax.Z) / 2
	local CH = 10.0
	local model = Instance.new("Model")
	model.Name = "ElevatorCar"
	model.Parent = root.Parent
	-- the car: floor, back and side walls, roof, handrail, light, display; open toward the shaft doors (+X)
	local heavy = PhysicalProperties.new(20, 0.8, 0, 1, 1)
	local floor = part("CarFloor", Vector3.new(cw, 0.35, cd), cf * CFrame.new(ccx, s0 + 0.18, ccz), Color3.fromRGB(60, 62, 66), Enum.Material.DiamondPlate)  -- sits just above the stop
	floor.CustomPhysicalProperties = heavy
	local car = { floor }
	local function carPart(name, size, offset, color, material)
		local p = part(name, size, floor.CFrame * CFrame.new(offset), color, material)
		p.CustomPhysicalProperties = heavy
		table.insert(car, p)
		return p
	end
	local wallC = Color3.fromRGB(176, 180, 186)
	local back = carPart("CarBack", Vector3.new(0.3, CH, cd), Vector3.new(-cw / 2 + 0.15, CH / 2 + 0.25, 0), wallC, Enum.Material.Metal)
	carPart("CarSideL", Vector3.new(cw, CH, 0.3), Vector3.new(0, CH / 2 + 0.25, -cd / 2 + 0.15), wallC, Enum.Material.Metal)
	carPart("CarSideR", Vector3.new(cw, CH, 0.3), Vector3.new(0, CH / 2 + 0.25, cd / 2 - 0.15), wallC, Enum.Material.Metal)
	local roof = carPart("CarRoof", Vector3.new(cw, 0.4, cd), Vector3.new(0, CH + 0.45, 0), Color3.fromRGB(230, 230, 228), Enum.Material.SmoothPlastic)
	carPart("Handrail", Vector3.new(0.2, 0.2, cd - 1.0), Vector3.new(-cw / 2 + 0.45, 3.6, 0), Color3.fromRGB(210, 190, 140), Enum.Material.Metal)
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 1.6
	light.Color = Color3.fromRGB(255, 246, 226)
	light.Parent = roof
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right -- the back wall's inside face looks toward +X
	gui.CanvasSize = Vector2.new(400, 300)
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(12, 14, 20)
	label.TextColor3 = Color3.fromRGB(255, 120, 60)
	label.Font = Enum.Font.Code
	label.TextScaled = true
	label.Text = "LOBBY"
	label.Parent = gui
	local display = carPart("Display", Vector3.new(0.1, 1.4, 2.4), Vector3.new(-cw / 2 + 0.36, 8.2, 0), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
	gui.Parent = display
	-- the car's door lip reaches out to the shaft wall, where the building's fixed sill (in the tower model, with its
	-- own collider) takes over, so there's no gap to drop through stepping in or out. It stays inside the shaft.
	local dx0, dzA, dzB = A("DoorX"), A("DoorZ0"), A("DoorZ1")
	local shaftX = (A("ShaftMax") and A("ShaftMax").X) or (dx0 - 1.0)
	local lipEnd = shaftX - 0.1
	if lipEnd > cmax.X + 0.05 then
		local lw = lipEnd - cmax.X
		carPart("Lip", Vector3.new(lw, 0.35, dzB - dzA), Vector3.new(cw / 2 + lw / 2, 0, (dzA + dzB) / 2 - ccz), Color3.fromRGB(150, 152, 156), Enum.Material.DiamondPlate)
	end
	for _, p in car do
		p.Anchored = false
		p.Parent = model
		if p ~= floor then
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = floor, p
			w.Parent = p
		end
	end
	-- the guide: a prismatic joint straight up the shaft, servo-driven between the two stops
	local rail = part("Guide", Vector3.new(0.4, 0.4, 0.4), cf * CFrame.new(ccx, s0 + 0.18, ccz))
	rail.Anchored, rail.Transparency, rail.CanCollide, rail.CanQuery = true, 1, false, false
	rail.Parent = model
	local up = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, -Vector3.xAxis) -- attachment primary axis = up
	local a0 = Instance.new("Attachment")
	a0.CFrame = up
	a0.Parent = rail
	local a1 = Instance.new("Attachment")
	a1.CFrame = up
	a1.Parent = floor
	local pc = Instance.new("PrismaticConstraint")
	pc.Attachment0, pc.Attachment1 = a0, a1
	pc.ActuatorType = Enum.ActuatorType.Servo
	pc.ServoMaxForce = 1e10
	pc.Speed = SPEED
	pc.LimitsEnabled = true
	pc.LowerLimit, pc.UpperLimit = -0.05, (s1 - s0) + 0.05
	pc.TargetPosition = 0
	pc.Parent = floor
	pcall(function()
		floor:SetNetworkOwner(nil)
	end)
	-- sliding shaft doors at both stops (two leaves meeting in the middle)
	local dx, dz0, dz1, dh = A("DoorX"), A("DoorZ0"), A("DoorZ1"), A("DoorH")
	local doors = {}
	for i, z in ipairs({ s0, s1 }) do
		local half = (dz1 - dz0) / 2
		local leaves = {}
		for k, zc in ipairs({ dz0 + half / 2, dz1 - half / 2 }) do
			local leaf = part("ShaftDoor", Vector3.new(0.25, dh, half), cf * CFrame.new(dx - 0.6, z + dh / 2, zc), Color3.fromRGB(190, 192, 196), Enum.Material.Metal)
			leaf.Anchored = true
			leaf.Parent = model
			leaves[k] = { part = leaf, closed = leaf.CFrame, open = leaf.CFrame * CFrame.new(0, 0, (k == 1 and -1 or 1) * (half - 0.2)) }
		end
		doors[i] = leaves
	end
	local function setDoors(i, open)
		for _, l in doors[i] do
			TweenService:Create(l.part, TweenInfo.new(1.0, Enum.EasingStyle.Quad), { CFrame = open and l.open or l.closed }):Play()
		end
		if open then
			chime(doors[i][1].part)
		end
		task.wait(1.0)
	end
	local at, busy = 1, false
	local function travel(i)
		label.Text = i == 2 and "▲ ROOF" or "▼ LOBBY"
		pc.TargetPosition = i == 1 and 0 or (s1 - s0)
		local t0 = os.clock()
		repeat
			task.wait(0.1)
		until math.abs(pc.CurrentPosition - pc.TargetPosition) < 0.2 or os.clock() - t0 > 40
		at = i
		label.Text = i == 2 and "ROOF" or "LOBBY"
	end
	local function trip(from, to)
		busy = true
		if at ~= from then
			travel(from)
		end
		setDoors(from, true)
		task.wait(6)
		setDoors(from, false)
		travel(to)
		setDoors(to, true)
		task.wait(7)
		setDoors(to, false)
		busy = false
	end
	-- call panels
	local function panel(pos, action, object)
		-- (the panel itself is modelled on the core wall; this is just the prompt's anchor in front of it)
		local p = part("CallPanel", Vector3.new(0.3, 1.6, 1.0), cf * CFrame.new(pos), Color3.fromRGB(40, 40, 46), Enum.Material.Metal)
		p.Anchored, p.Transparency, p.CanCollide, p.CanQuery, p.CanTouch = true, 1, false, false, false
		p.Parent = model
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = action
		pp.ObjectText = object
		pp.HoldDuration = 0.3
		pp.MaxActivationDistance = 9
		pp.RequiresLineOfSight = false
		pp.Parent = p
		return pp
	end
	local up_ = panel(A("Call0"), "Ride to the roof", ("Elevator · $%d (stairs are free)"):format(price))
	local down = panel(A("Call1"), "Ride down", "Elevator · free")
	up_.Triggered:Connect(function(player)
		if busy then
			Wallet.Notify(player, "The elevator is busy, one moment.")
			return
		end
		if not Wallet.Spend(player, price) then
			Wallet.Notify(player, ("The elevator costs $%d. The stairs are free!"):format(price), Color3.fromRGB(255, 120, 90))
			return
		end
		Wallet.Notify(player, ("Paid $%d. Step in, going up!"):format(price), Color3.fromRGB(120, 230, 140))
		task.spawn(trip, 1, 2)
	end)
	down.Triggered:Connect(function(player)
		if busy then
			Wallet.Notify(player, "The elevator is busy, one moment.")
			return
		end
		task.spawn(trip, 2, 1)
	end)
end

-- (only roots that are really in the world: a tower template sitting in ServerStorage gets no car)
task.spawn(function()
	while true do
		for _, r in CollectionService:GetTagged("NC_Elevator") do
			if r:IsDescendantOf(workspace) and not done[r] then
				task.spawn(setup, r)
			end
		end
		task.wait(2)
	end
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX12"><Properties><string name="Name">ParachuteService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ParachuteService (server): buy a parachute with earned Cash (once; it's yours for good, saved), and the state
-- relay so every player sees everyone's skydive, canopy and backpack. ParachuteClient does the flying.
-- Shops: any part tagged NC_ParachuteShop (BuildingKit makes them at the office tower's lobby kiosk and in the
-- roof's mechanical room). Ownership is saved in the DataStore NeonCoast_Gear_v1 and shows as the player
-- attribute HasParachute (the client puts the pack on your back and lets you open a canopy).
local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local PRICE = 500
local Wallet = require(SSS:WaitForChild("NCWallet"))

local Remotes = RS:FindFirstChild("Remotes")
if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "Remotes"
	Remotes.Parent = RS
end
local StateRE = Remotes:FindFirstChild("ParachuteState") or Instance.new("RemoteEvent")
StateRE.Name = "ParachuteState"
StateRE.Parent = Remotes

local store
pcall(function()
	store = DataStoreService:GetDataStore("NeonCoast_Gear_v1")
end)

local function key(p)
	return "u" .. p.UserId
end

local function load(p)
	if not store then
		return
	end
	local ok, data = pcall(function()
		return store:GetAsync(key(p))
	end)
	if ok and type(data) == "table" and data.parachute then
		p:SetAttribute("HasParachute", true)
	end
end

local function save(p)
	if not store then
		return
	end
	local owned = p:GetAttribute("HasParachute") == true
	for _ = 1, 3 do
		local ok = pcall(function()
			store:UpdateAsync(key(p), function(old)
				old = type(old) == "table" and old or {}
				old.parachute = owned or old.parachute
				return old
			end)
		end)
		if ok then
			return
		end
		task.wait(2)
	end
end

Players.PlayerAdded:Connect(load)
for _, p in Players:GetPlayers() do
	task.spawn(load, p)
end

-- shops
local done = setmetatable({}, { __mode = "k" })
local function setupShop(part)
	if done[part] or not part:IsDescendantOf(workspace) then
		return
	end
	done[part] = true
	local old = part:FindFirstChild("BuyParachute") -- left on a cloned copy, with nothing listening
	if old then
		old:Destroy()
	end
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "BuyParachute"
	pp.ActionText = "Buy parachute"
	pp.ObjectText = ("Skydive gear · $%d"):format(PRICE)
	pp.HoldDuration = 0.4
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	pp.Parent = part
	pp.Triggered:Connect(function(player)
		if player:GetAttribute("HasParachute") then
			Wallet.Notify(player, "You already own a parachute. Jump off something tall: SPACE opens it, C cuts away.")
			return
		end
		if not Wallet.Spend(player, PRICE) then
			Wallet.Notify(player, ("A parachute costs $%d. Earn some more cash first."):format(PRICE), Color3.fromRGB(255, 120, 90))
			return
		end
		player:SetAttribute("HasParachute", true)
		Wallet.Notify(player, "Parachute bought! Jump from a rooftop. Look down to dive, SPACE to open, C to cut away.", Color3.fromRGB(120, 230, 140))
		task.spawn(save, player)
	end)
end
task.spawn(function()
	while true do
		for _, p in CollectionService:GetTagged("NC_ParachuteShop") do
			setupShop(p)
		end
		task.wait(2)
	end
end)

-- what each player's chute is doing, for everyone else's screen
local VALID = { freefall = true, canopy = true }
StateRE.OnServerEvent:Connect(function(player, st)
	local char = player.Character
	if not char then
		return
	end
	if st == "canopy" and not player:GetAttribute("HasParachute") then
		return
	end
	char:SetAttribute("ChuteState", VALID[st] and st or nil)
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX13"><Properties><string name="Name">ParachuteClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- ParachuteClient: skydiving and the parachute, the way the big battle-royale shooters do it.
--   * Own a parachute (buy one at a parachute kiosk) and step off anything tall: once you're falling with
--     40+ studs of air under you, you go into a skydive automatically.
--   * Freefall: the camera steers. Hold W looking at the horizon to track forward fast; look straight down and
--     hold W to dive head-first (much faster fall, the wind screams, the view stretches); let go to fall belly-
--     down; S slows you and A/D slide sideways. Altitude and speed on screen.
--   * SPACE opens the canopy (at least 10 studs up): a hard opening jolt, the canopy cracks open over you. Under
--     canopy the chute follows where you look; W pushes it forward faster and steeper, S brakes and floats, A/D
--     bank into tighter turns. C (or the Cut button) cuts it away and you're back in freefall, and you can open
--     again: cut and redeploy as often as you like. Leave it too long and it opens on its own near the ground.
--   * Land soft under canopy (it folds away), or splash into a pool (the swim script takes over).
--   * Everyone sees everyone: the pack on your back, the skydive poses, the canopy and the cutaway.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local StateRE = RS:WaitForChild("Remotes"):WaitForChild("ParachuteState")

-- tuning, studs/s (about 3.8 studs to a metre)
local FF = { bellyFall = 58, bellyDrift = 7, trackFall = 46, trackFwd = 50, diveFall = 128, diveFwd = 26, backFall = 55, backFwd = -8, strafe = 18, respH = 1.5, respV = 2.0 }
local CN = { fall = 13, fwd = 32, diveFall = 23, diveFwd = 47, brakeFall = 8.5, brakeFwd = 15, turn = math.rad(85), bank = math.rad(75), respH = 2.0, respV = 2.4, openTime = 0.8 }
local START_AGL, MIN_DEPLOY = 40, 10
local SND_WIND = "rbxasset://sounds/action_falling.ogg"
local SND_POP = "rbxasset://sounds/action_jump_land.mp3"
local rad = math.rad

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function bodyOf(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and hum then
		return hrp, hum
	end
	return nil
end

---------------------------------------------------------------------------------------------- the world below
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function refreshFilter()
	local list = { workspace.CurrentCamera }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local f = workspace:FindFirstChild("NC_LocalChutes")
	if f then
		table.insert(list, f)
	end
	rayParams.FilterDescendantsInstances = list
end

local function feetAGL(hrp, hum)
	local feet = hrp.Position.Y - hrp.Size.Y / 2 - hum.HipHeight
	local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -3000, 0), rayParams)
	if not hit then
		return 3000
	end
	return feet - hit.Position.Y
end

local function inWater(pos)
	for _, w in CollectionService:GetTagged("NC_Water") do
		if w:IsA("BasePart") and w:IsDescendantOf(workspace) then
			local lp = w.CFrame:PointToObjectSpace(pos)
			local h = w.Size / 2
			if math.abs(lp.X) <= h.X and math.abs(lp.Z) <= h.Z and lp.Y <= h.Y and lp.Y >= -h.Y then
				return true
			end
		end
	end
	return false
end

---------------------------------------------------------------------------------------------- joints and poses
local JOINTS = { "RightShoulder", "RightElbow", "LeftShoulder", "LeftElbow", "RightHip", "RightKnee", "LeftHip", "LeftKnee", "Neck", "Waist" }
local JSET = {}
for _, n in JOINTS do
	JSET[n] = true
end
local jointCache = setmetatable({}, { __mode = "k" })
local function jointsOf(char)
	local e = jointCache[char]
	if e and (e.n >= 8 or os.clock() - e.t < 2) then
		return e
	end
	e = { n = 0, t = os.clock() }
	for _, d in char:GetDescendants() do
		if JSET[d.Name] and (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) and not e[d.Name] then
			e[d.Name] = d
			e.n += 1
		end
	end
	jointCache[char] = e
	return e
end

local function setJoint(j, q, alpha)
	if not j then
		return
	end
	local c0, c1
	if j:IsA("Motor6D") then
		c0, c1 = j.C0.Rotation, j.C1.Rotation
	else
		local a0, a1 = j.Attachment0, j.Attachment1
		local p0 = a0 and a0:FindFirstAncestorWhichIsA("BasePart")
		local p1 = a1 and a1:FindFirstAncestorWhichIsA("BasePart")
		if not (p0 and p1) then
			return
		end
		c0, c1 = p0.CFrame:ToObjectSpace(a0.WorldCFrame).Rotation, p1.CFrame:ToObjectSpace(a1.WorldCFrame).Rotation
	end
	local target = c0:Inverse() * q * c1
	j.Transform = alpha < 1 and j.Transform:Lerp(target, alpha) or target
end

local A = CFrame.Angles
local function lerpA(a, b, t)
	return a + (b - a) * t
end

-- belly-to-earth arch blending into a head-down dive (arms swept back, legs together)
local function poseFreefall(J, dive, w)
	local sh = lerpA(20, -20, dive)
	setJoint(J.RightShoulder, A(rad(sh), 0, rad(lerpA(82, 16, dive))), w)
	setJoint(J.LeftShoulder, A(rad(sh), 0, rad(-lerpA(82, 16, dive))), w)
	setJoint(J.RightElbow, A(rad(lerpA(70, 6, dive)), 0, 0), w)
	setJoint(J.LeftElbow, A(rad(lerpA(70, 6, dive)), 0, 0), w)
	setJoint(J.RightHip, A(rad(lerpA(-22, -4, dive)), 0, rad(lerpA(16, 3, dive))), w)
	setJoint(J.LeftHip, A(rad(lerpA(-22, -4, dive)), 0, rad(-lerpA(16, 3, dive))), w)
	setJoint(J.RightKnee, A(rad(lerpA(-62, -6, dive)), 0, 0), w)
	setJoint(J.LeftKnee, A(rad(lerpA(-62, -6, dive)), 0, 0), w)
	setJoint(J.Neck, A(rad(lerpA(30, 10, dive)), 0, 0), w) -- head up, looking where you're going
end

-- hanging in the harness, hands up on the toggles; braking pulls them down, a turn pulls one side
local function poseCanopy(J, brake, turn, w)
	local r = lerpA(158, 115, math.clamp(brake + math.max(0, turn), 0, 1))
	local l = lerpA(158, 115, math.clamp(brake + math.max(0, -turn), 0, 1))
	setJoint(J.RightShoulder, A(rad(r), 0, rad(-14)), w)
	setJoint(J.LeftShoulder, A(rad(l), 0, rad(14)), w)
	setJoint(J.RightElbow, A(rad(40), 0, 0), w)
	setJoint(J.LeftElbow, A(rad(40), 0, 0), w)
	setJoint(J.RightHip, A(rad(18), 0, rad(4)), w)
	setJoint(J.LeftHip, A(rad(14), 0, rad(-4)), w)
	setJoint(J.RightKnee, A(rad(-22), 0, 0), w)
	setJoint(J.LeftKnee, A(rad(-26), 0, 0), w)
end

---------------------------------------------------------------------------------------------- visuals (canopy, pack)
local localFolder = workspace:FindFirstChild("NC_LocalChutes") or Instance.new("Folder")
localFolder.Name = "NC_LocalChutes"
localFolder.Parent = workspace

local function ghost(p)
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, false, true
	return p
end

local PINK, BLACK, TEAL = Color3.fromRGB(255, 56, 158), Color3.fromRGB(18, 18, 22), Color3.fromRGB(26, 216, 216)

local function newCanopy()
	local assets = RS:FindFirstChild("ParachuteAssets")
	if assets and assets:FindFirstChild("Canopy") then
		return assets.Canopy:Clone()
	end
	-- built from parts until the Blender canopy is uploaded: 9 arched ram-air cells with rounded noses,
	-- stabilisers, two rows of lines per rib down to four risers
	local m = Instance.new("Model")
	m.Name = "Canopy"
	local root = ghost(Instance.new("Part"))
	root.Name = "Harness"
	root.Size = Vector3.one * 0.2
	root.Transparency = 1
	root.Parent = m
	m.PrimaryPart = root
	local SPAN, CHORD, H0, DROP, N = 20, 7.6, 15, 2.6, 9
	local function arc(x)
		return H0 - DROP * (x / (SPAN / 2)) ^ 2
	end
	local function add(p)
		ghost(p)
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = m
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = root, p
		w.Parent = p
		return p
	end
	for i = 0, N - 1 do
		local x = -SPAN / 2 + SPAN * (i + 0.5) / N
		local roll = math.atan(-2 * DROP * x / (SPAN / 2) ^ 2)
		local cf = root.CFrame * CFrame.new(x, arc(x), 0) * CFrame.Angles(0, 0, roll)
		local col = i == 4 and TEAL or (i % 2 == 0 and PINK or BLACK)
		local cell = Instance.new("Part")
		cell.Size = Vector3.new(SPAN / N + 0.04, 1.0, CHORD - 0.6)
		cell.CFrame = cf * CFrame.new(0, 0, 0.3)
		cell.Color = col
		cell.Material = Enum.Material.Fabric
		add(cell)
		local nose = Instance.new("Part")
		nose.Shape = Enum.PartType.Cylinder
		nose.Size = Vector3.new(SPAN / N + 0.04, 1.2, 1.2)
		nose.CFrame = cf * CFrame.new(0, 0.05, -CHORD / 2 + 0.6)
		nose.Color = col
		nose.Material = Enum.Material.Fabric
		add(nose)
	end
	for s = -1, 1, 2 do
		local x = s * SPAN / 2
		local stab = Instance.new("WedgePart")
		stab.Size = Vector3.new(0.12, 3.0, CHORD * 0.7)
		stab.CFrame = root.CFrame * CFrame.new(x, arc(x) - 1.9, 0.2) * CFrame.Angles(math.pi, 0, 0)
		stab.Color = BLACK
		stab.Material = Enum.Material.Fabric
		add(stab)
	end
	local risers = { [-1] = Vector3.new(-0.9, 3.2, 0), [1] = Vector3.new(0.9, 3.2, 0) }
	for r = 0, N do
		local x = -SPAN / 2 + SPAN * r / N
		local side = x < 0 and -1 or 1
		for _, zf in { -CHORD * 0.3, CHORD * 0.25 } do
			local a = Vector3.new(x, arc(x) - 0.55, zf)
			local b = risers[side] + Vector3.new(0, 0, zf * 0.05)
			local line = Instance.new("Part")
			line.Size = Vector3.new(0.06, 0.06, (a - b).Magnitude)
			line.CFrame = root.CFrame * CFrame.lookAt((a + b) / 2, b)
			line.Color = Color3.fromRGB(225, 225, 218)
			line.Material = Enum.Material.SmoothPlastic
			add(line)
		end
	end
	for s = -1, 1, 2 do
		local riser = Instance.new("Part")
		riser.Size = Vector3.new(0.28, 3.2, 0.08)
		riser.CFrame = root.CFrame * CFrame.new(s * 0.82, 1.65, 0)
		riser.Color = BLACK
		add(riser)
	end
	return m
end

local function newPack()
	local assets = RS:FindFirstChild("ParachuteAssets")
	if assets and assets:FindFirstChild("Pack") then
		return assets.Pack:Clone()
	end
	local m = Instance.new("Model")
	m.Name = "Pack"
	local body = ghost(Instance.new("Part"))
	body.Name = "Body"
	body.Size = Vector3.new(1.6, 2.0, 0.7)
	body.Color = Color3.fromRGB(36, 38, 44)
	body.Material = Enum.Material.Fabric
	body.Parent = m
	m.PrimaryPart = body
	local seam = ghost(Instance.new("Part"))
	seam.Size = Vector3.new(1.62, 0.1, 0.3)
	seam.CFrame = body.CFrame * CFrame.new(0, 1.0, 0)
	seam.Color = PINK
	seam.Material = Enum.Material.Neon
	seam.Parent = m
	local handle = ghost(Instance.new("Part"))
	handle.Size = Vector3.new(0.3, 0.3, 0.2)
	handle.CFrame = body.CFrame * CFrame.new(0.45, -0.85, 0.42)
	handle.Color = Color3.fromRGB(240, 190, 30)
	handle.Parent = m
	for _, p in { seam, handle } do
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = body, p
		w.Parent = p
	end
	return m
end

local vis = {} -- character -> { pack = model, canopy = model, weld = Weld, t0 = open time, state = last state }

local function playPop(char)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = SND_POP
	s.PlaybackSpeed = 0.45
	s.Volume = 1.2
	s.RollOffMaxDistance = 160
	s.Parent = hrp
	s:Play()
	Debris:AddItem(s, 2)
end

local function releaseCanopy(v, how)
	local m = v.canopy
	if not m then
		return
	end
	v.canopy, v.weld = nil, nil
	if how == "cut" then
		-- cut away: it flies off up and back, tumbling, then it's gone
		for _, d in m:GetDescendants() do
			if d:IsA("Weld") and d.Name == "ChuteWeld" then
				d:Destroy()
			end
		end
		local root = m.PrimaryPart
		if root then
			for _, p in m:GetDescendants() do
				if p:IsA("BasePart") then
					p.Massless = false
				end
			end
			root.AssemblyLinearVelocity = Vector3.new(0, 25, 0) + root.CFrame.LookVector * -20
			root.AssemblyAngularVelocity = Vector3.new(1.5, 0.6, 0.8)
		end
		Debris:AddItem(m, 4)
	else
		-- landed: the canopy folds down and fades
		local t0 = os.clock()
		local base = m:GetScale()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local t = (os.clock() - t0) / 0.7
			if t >= 1 or not m.Parent then
				conn:Disconnect()
				m:Destroy()
				return
			end
			pcall(function()
				m:ScaleTo(math.max(0.05, base * (1 - t)))
			end)
		end)
	end
end

local function attach(char, model, partName, offset)
	local p = char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
	if not (p and model.PrimaryPart) then
		model:Destroy()
		return nil
	end
	model:PivotTo(p.CFrame * offset)
	local w = Instance.new("Weld")
	w.Name = "ChuteWeld"
	w.Part0, w.Part1 = p, model.PrimaryPart
	w.C0 = offset
	w.Parent = model.PrimaryPart
	model.Parent = localFolder
	return w
end

---------------------------------------------------------------------------------------------- local controller
local S = { mode = nil, v = Vector3.zero, fwd = Vector3.new(0, 0, -1), deployT = 0, cutT = -9, dive = 0, brake = 0, turn = 0, fov = nil, shake = 0 }
local movers = {}

local function setState(st)
	S.mode = st
	StateRE:FireServer(st)
end

local function clearMovers()
	for _, m in movers do
		if typeof(m) == "Instance" then
			m:Destroy()
		end
	end
	movers = {}
end

local function makeMovers(hrp)
	clearMovers()
	local att = Instance.new("Attachment")
	att.Name = "NC_ChuteAtt"
	att.Parent = hrp
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = hrp.AssemblyMass * 4000
	lv.VectorVelocity = hrp.AssemblyLinearVelocity
	lv.Parent = hrp
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.Responsiveness = 10
	ao.MaxTorque = math.huge
	ao.CFrame = hrp.CFrame.Rotation
	ao.Parent = hrp
	movers = { att = att, lv = lv, ao = ao }
end

-- HUD: altitude, speed, the keys
local gui = Instance.new("ScreenGui")
gui.Name = "SkydiveHUD"
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")
local readout = Instance.new("TextLabel")
readout.AnchorPoint = Vector2.new(0.5, 1)
readout.Position = UDim2.new(0.5, 0, 1, -150)
readout.Size = UDim2.fromOffset(420, 60)
readout.BackgroundTransparency = 1
readout.Font = Enum.Font.GothamBlack
readout.TextColor3 = Color3.fromRGB(255, 255, 255)
readout.TextStrokeTransparency = 0.4
readout.TextSize = 30
readout.RichText = true
readout.Parent = gui
local hint = Instance.new("TextLabel")
hint.AnchorPoint = Vector2.new(0.5, 1)
hint.Position = UDim2.new(0.5, 0, 1, -118)
hint.Size = UDim2.fromOffset(520, 26)
hint.BackgroundTransparency = 1
hint.Font = Enum.Font.GothamBold
hint.TextColor3 = Color3.fromRGB(230, 230, 230)
hint.TextStrokeTransparency = 0.5
hint.TextSize = 16
hint.Parent = gui

local wind = Instance.new("Sound")
wind.Name = "SkydiveWind"
wind.SoundId = SND_WIND
wind.Looped = true
wind.Volume = 0
wind.Parent = workspace.CurrentCamera

local function deploy()
	local char = player.Character
	local hrp, hum = bodyOf(char)
	if S.mode ~= "freefall" or not hrp then
		return
	end
	if feetAGL(hrp, hum) < MIN_DEPLOY or os.clock() - S.cutT < 0.6 then
		return
	end
	S.deployT = os.clock()
	S.shake = 1.0
	setState("canopy")
end

local function cut()
	if S.mode ~= "canopy" then
		return
	end
	S.cutT = os.clock()
	setState("freefall")
	local v = vis[player.Character]
	if v then
		releaseCanopy(v, "cut")
		v.state = "freefall"
	end
end

local function onDeployAction(_, st)
	if st == Enum.UserInputState.Begin then
		deploy()
	end
	return Enum.ContextActionResult.Sink
end
local function onCutAction(_, st)
	if st == Enum.UserInputState.Begin then
		cut()
	end
	return Enum.ContextActionResult.Sink
end

local function bindKeys(on)
	if on then
		CAS:BindActionAtPriority("NC_ChuteDeploy", onDeployAction, true, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
		CAS:SetTitle("NC_ChuteDeploy", "Open")
		CAS:BindActionAtPriority("NC_ChuteCut", onCutAction, true, 3000, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
		CAS:SetTitle("NC_ChuteCut", "Cut")
	else
		CAS:UnbindAction("NC_ChuteDeploy")
		CAS:UnbindAction("NC_ChuteCut")
	end
end

local function startFreefall(hrp, hum)
	S.v = hrp.AssemblyLinearVelocity
	local fl = flat(workspace.CurrentCamera.CFrame.LookVector)
	S.fwd = fl.Magnitude > 0.01 and fl.Unit or flat(hrp.CFrame.LookVector).Unit
	S.dive, S.brake, S.turn = 0, 0, 0
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, t in animator:GetPlayingAnimationTracks() do
			t:Stop(0.3)
		end
	end
	makeMovers(hrp)
	-- (minus the sprint view-widening the movement script adds, which it takes back off as the skydive starts)
	S.fov = S.fov or (workspace.CurrentCamera.FieldOfView - (workspace.CurrentCamera:GetAttribute("NC_FovOffset") or 0))
	wind:Play()
	gui.Enabled = true
	bindKeys(true)
	setState("freefall")
end

local function finish(hum, hrp, intoWater)
	clearMovers()
	bindKeys(false)
	gui.Enabled = false
	wind:Stop()
	local v = vis[player.Character]
	if v and v.canopy then
		releaseCanopy(v, "land")
		v.state = nil
	end
	setState(nil)
	if hrp then
		hrp.AssemblyLinearVelocity = flat(S.v) * 0.4 + Vector3.new(0, intoWater and S.v.Y or 0, 0)
	end
	if hum then
		hum:ChangeState(intoWater and Enum.HumanoidStateType.Freefall or Enum.HumanoidStateType.Landed)
		hum.CameraOffset = Vector3.zero
	end
	if S.fov then
		TweenService:Create(workspace.CurrentCamera, TweenInfo.new(0.6), { FieldOfView = S.fov }):Play()
		S.fov = nil
	end
end

local function approach(cur, target, kH, kV, dt)
	local h = flat(cur):Lerp(flat(target), 1 - math.exp(-kH * dt))
	local y = cur.Y + (target.Y - cur.Y) * (1 - math.exp(-kV * dt))
	return Vector3.new(h.X, y, h.Z)
end

local function turnToward(cur, want, maxAngle)
	local c, w = Vector3.new(cur.X, 0, cur.Z).Unit, Vector3.new(want.X, 0, want.Z)
	if w.Magnitude < 0.01 then
		return c, 0
	end
	w = w.Unit
	local ang = math.atan2(c:Cross(w).Y, c:Dot(w))
	local step = math.clamp(ang, -maxAngle, maxAngle)
	local r = CFrame.Angles(0, step, 0):VectorToWorldSpace(c) -- positive step turns c toward w when (c x w).Y > 0
	return r, step
end

local frame = 0
RunService.Stepped:Connect(function(_, dt)
	frame += 1
	if frame % 30 == 1 then
		refreshFilter()
	end
	local char = player.Character
	local hrp, hum = bodyOf(char)
	if not hrp then
		return
	end
	local cam = workspace.CurrentCamera
	if S.mode == nil then
		if player:GetAttribute("HasParachute") and hum.Health > 0 and hum:GetState() == Enum.HumanoidStateType.Freefall
			and hrp.AssemblyLinearVelocity.Y < -14 and not inWater(hrp.Position) and feetAGL(hrp, hum) > START_AGL then
			startFreefall(hrp, hum)
		end
		return
	end
	if hum.Health <= 0 then
		finish(hum, nil, false)
		return
	end
	if inWater(hrp.Position) then
		finish(hum, hrp, true)
		return
	end
	local agl = feetAGL(hrp, hum)
	local look = cam.CFrame.LookVector
	local fl = flat(look).Magnitude > 0.01 and flat(look).Unit or S.fwd
	local md = hum.MoveDirection
	local w = md:Dot(S.fwd)
	local right = S.fwd:Cross(Vector3.yAxis).Unit
	local side = md:Dot(right)
	local now = os.clock()
	if S.mode == "freefall" then
		-- the camera steers; W tracks forward or, looking down, dives head-first
		S.fwd = select(1, turnToward(S.fwd, fl, rad(150) * dt))
		local pitchDown = -look.Y
		local target
		if w > 0.2 then
			S.dive = S.dive + (math.clamp((pitchDown - 0.15) / 0.6, 0, 1) - S.dive) * math.min(1, dt * 3)
			local fall = lerpA(FF.trackFall, FF.diveFall, S.dive)
			local fwd = lerpA(FF.trackFwd, FF.diveFwd, S.dive) * w
			target = S.fwd * fwd + right * side * FF.strafe + Vector3.new(0, -fall, 0)
		elseif w < -0.2 then
			S.dive = S.dive * (1 - math.min(1, dt * 3))
			target = S.fwd * FF.backFwd + right * side * FF.strafe + Vector3.new(0, -FF.backFall, 0)
		else
			S.dive = S.dive * (1 - math.min(1, dt * 3))
			target = S.fwd * FF.bellyDrift + right * side * FF.strafe + Vector3.new(0, -FF.bellyFall, 0)
		end
		S.v = approach(S.v, target, FF.respH, FF.respV, dt)
		movers.lv.VectorVelocity = S.v
		-- body: belly to earth, tipping head-down as you dive, banking into a slide
		local a = rad(65) * S.dive
		local up = S.fwd * math.cos(a) - Vector3.yAxis * math.sin(a)
		local back = Vector3.yAxis * math.cos(a) + S.fwd * math.sin(a)
		movers.ao.CFrame = CFrame.fromMatrix(Vector3.zero, up:Cross(back), up, back) * CFrame.Angles(0, rad(-25) * side, 0)
		-- it opens on its own if you leave it too late
		if agl < math.max(30, -S.v.Y * 0.7) then
			deploy()
		end
		if agl < 2.5 then
			finish(hum, hrp, false)
			return
		end
	elseif S.mode == "canopy" then
		local open = math.clamp((now - S.deployT) / CN.openTime, 0, 1)
		-- steering: the chute swings round toward where you look; A/D bank it into a harder turn
		local _, step = turnToward(S.fwd, fl, CN.turn * dt)
		local bankStep = side * CN.bank * dt
		S.fwd = CFrame.Angles(0, step - bankStep, 0):VectorToWorldSpace(S.fwd)
		-- S.turn: +1 = hard right, -1 = hard left (a right turn is a negative yaw step)
		S.turn = S.turn + (-(step - bankStep) / math.max(dt, 1e-3) / CN.turn - S.turn) * math.min(1, dt * 4)
		S.brake = S.brake + ((w < -0.2 and 1 or 0) - S.brake) * math.min(1, dt * 4)
		local fwd, fall
		if w > 0.2 then
			fwd, fall = CN.diveFwd, CN.diveFall
		elseif w < -0.2 then
			fwd, fall = CN.brakeFwd, CN.brakeFall
		else
			fwd, fall = CN.fwd, CN.fall
		end
		local target = S.fwd * fwd + Vector3.new(0, -fall, 0)
		local k = open < 1 and 3.6 or 1 -- the opening jolt bleeds the freefall speed off hard
		S.v = approach(S.v, target, CN.respH * k, CN.respV * k, dt)
		movers.lv.VectorVelocity = S.v
		local lean = rad(10 + (w > 0.2 and 12 or 0) - (w < -0.2 and 10 or 0))
		-- swing out under the wing into the turn (right turn: right side drops)
		movers.ao.CFrame = CFrame.lookAt(Vector3.zero, S.fwd) * CFrame.Angles(-lean, 0, rad(-28) * math.clamp(S.turn, -1, 1))
		if agl < 2.4 then
			finish(hum, hrp, false)
			return
		end
	end
	-- camera: the view stretches with speed, a jolt on opening
	local spd = S.v.Magnitude
	local wantFov = S.mode == "freefall" and (S.fov or 70) + math.clamp((spd - 50) / 80, 0, 1) * 22 or (S.fov or 70) + 4
	cam.FieldOfView += (wantFov - cam.FieldOfView) * math.min(1, dt * 3)
	S.shake = math.max(0, S.shake - dt * 2.5)
	local jitter = S.mode == "freefall" and math.clamp((spd - 90) / 60, 0, 1) * 0.08 or 0
	local amp = S.shake * 0.45 + jitter
	hum.CameraOffset = amp > 0 and Vector3.new(math.noise(now * 18, 1) * amp, math.noise(now * 18, 2) * amp, 0) or Vector3.zero
	wind.Volume = math.clamp(spd / 110, 0.08, 1) * (S.mode == "canopy" and 0.35 or 1)
	wind.PlaybackSpeed = 0.75 + math.clamp(spd / 260, 0, 0.6)
	-- readout
	local metres = math.floor(math.max(0, agl) / 3.8)
	readout.Text = string.format("ALT <font color=\"#7CF5FF\">%d m</font>    SPD <font color=\"#FF6EC7\">%d km/h</font>", metres, math.floor(spd / 3.8 * 3.6))
	hint.Text = S.mode == "freefall" and "SPACE  open   ·   W + look down  dive   ·   S  slow" or "C  cut away   ·   W  speed   ·   S  brake   ·   A / D  turn"
end)

---------------------------------------------------------------------------------------------- everyone's visuals and poses
RunService.Stepped:Connect(function(_, dt)
	local now = os.clock()
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			continue
		end
		local v = vis[char]
		if not v then
			v = {}
			vis[char] = v
			char.AncestryChanged:Connect(function(_, parent)
				if not parent then
					if v.pack then
						v.pack:Destroy()
					end
					if v.canopy then
						v.canopy:Destroy()
					end
					vis[char] = nil
				end
			end)
		end
		-- the pack on the back of anyone who owns a parachute
		if p:GetAttribute("HasParachute") and not v.pack then
			local pk = newPack()
			if attach(char, pk, "UpperTorso", CFrame.new(0, 0, 0.85)) then
				v.pack = pk
			end
		end
		local st = p == player and S.mode or char:GetAttribute("ChuteState")
		if st == "canopy" and not v.canopy then
			local m = newCanopy()
			v.weld = attach(char, m, "HumanoidRootPart", CFrame.new(0, 1.3, 0.35))
			if v.weld then
				v.canopy = m
				v.t0 = now
				pcall(function()
					m:ScaleTo(0.08)
				end)
				playPop(char)
			end
		elseif st ~= "canopy" and v.canopy then
			releaseCanopy(v, st == "freefall" and "cut" or "land")
		end
		v.state = st
		-- the canopy cracking open (scale with a little overshoot) and swaying over the jumper
		if v.canopy and v.weld then
			local t = (now - (v.t0 or now)) / CN.openTime
			if t < 1.25 then
				local s = t < 1 and (0.08 + 0.98 * (1 - (1 - t) ^ 3)) or (1.06 - 0.06 * (t - 1) / 0.25)
				pcall(function()
					v.canopy:ScaleTo(math.clamp(s, 0.08, 1.06))
				end)
			end
			v.weld.C0 = CFrame.new(0, 1.3, 0.35) * CFrame.Angles(math.sin(now * 1.3) * 0.035, 0, math.sin(now * 0.9) * 0.05)
		end
		-- poses
		if st then
			local J = jointsOf(char)
			local vel = hrp.AssemblyLinearVelocity
			if st == "freefall" then
				local dive = p == player and S.dive or math.clamp((-vel.Y - 70) / 50, 0, 1)
				poseFreefall(J, dive, 1)
			else
				local brake = p == player and S.brake or 0
				local turn = p == player and S.turn or 0
				poseCanopy(J, brake, turn, 1)
			end
		end
	end
end)

player.CharacterAdded:Connect(function()
	clearMovers()
	bindKeys(false)
	gui.Enabled = false
	wind:Stop()
	S.mode = nil
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX14"><Properties><string name="Name">MovementService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- MovementService (server): the shared half of the real-life movement system (MovementClient does the moving).
--   * Ragdoll rig on every character: a ball-socket joint with human joint limits beside every body Motor6D (knees and
--     elbows only bend the right way, necks and waists only so far), no-collide between neighbouring body parts, and
--     BreakJointsOnDeath off. To ragdoll, the server switches the motors off (that replicates, so every player
--     sees the body go limp and tumble under real physics); to get up it switches them back on.
--   * Ragdolls: hard falls, being hit by a car, and death (bodies crumple instead of falling apart).
--   * Fall damage from the impact speed the client measured (FALL_DAMAGE).
--   * Relays what each player's body is doing to everyone else: vaults, climbs, rolls, hard landings, wall bumps
--     (character attribute MoveAct = "name|duration|serverTime") and where they're looking and how out of breath
--     they are (character attribute Look = Vector3(yaw, pitch, stamina)).
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local FALL_DAMAGE = true
local ACTS = { vault = 1.2, mantle = 1.6, climb = 2.4, roll = 1.0, land = 1.0, bump = 1.0, getup = 1.2, stumble = 1.0,
	soft = 0.6, skid = 1.0, pivot = 0.8 }

local Remotes = RS:FindFirstChild("Remotes")
if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "Remotes"
	Remotes.Parent = RS
end
local function remote(name, class)
	local r = Remotes:FindFirstChild(name)
	if not r then
		local ok, inst = pcall(Instance.new, class)
		r = ok and inst or Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = Remotes
	end
	return r
end
local ActRE = remote("MoveAct", "RemoteEvent")
local LookRE = remote("MoveLook", "UnreliableRemoteEvent")

-- { cone, twistLow, twistHigh } in degrees. The cone limits swing of the joint's X axis (sideways / turning);
-- twist is rotation about X, which is the bend: + bends elbows, lifts arms and thighs forward; - bends knees and
-- tips the head and torso forward.
local LIMITS = {
	Neck = { 50, -45, 40 }, Waist = { 20, -45, 20 },
	LeftShoulder = { 80, -60, 170 }, RightShoulder = { 80, -60, 170 },
	LeftElbow = { 6, 0, 140 }, RightElbow = { 6, 0, 140 },
	LeftWrist = { 30, -45, 45 }, RightWrist = { 30, -45, 45 },
	LeftHip = { 45, -30, 115 }, RightHip = { 45, -30, 115 },
	LeftKnee = { 6, -140, 0 }, RightKnee = { 6, -140, 0 },
	LeftAnkle = { 25, -40, 40 }, RightAnkle = { 25, -40, 40 },
	-- classic R6 bodies: plain cones
	["Right Shoulder"] = { 70, -70, 70 }, ["Left Shoulder"] = { 70, -70, 70 },
	["Right Hip"] = { 50, -50, 50 }, ["Left Hip"] = { 50, -50, 50 },
}
local R6_NECK = { 40, -40, 40 }

local function limitsFor(m)
	if m.Name == "Neck" and m.Part0 and m.Part0.Name == "Torso" then
		return R6_NECK
	end
	return LIMITS[m.Name]
end

local function unrig(char)
	local old = char:FindFirstChild("NC_Ragdoll")
	if old then
		old:Destroy()
	end
	for _, d in char:GetDescendants() do
		if d:IsA("Attachment") and (string.sub(d.Name, 1, 5) == "RagA_" or string.sub(d.Name, 1, 5) == "RagB_") then
			d:Destroy()
		end
	end
end

local rig
local function watchRebuilds(char)
	-- an outfit change that swaps body parts or rescales them leaves the ragdoll joints in the wrong places:
	-- rebuild once things settle
	local pending = false
	char.DescendantAdded:Connect(function(d)
		if d:IsA("Motor6D") and not pending then
			pending = true
			task.delay(0.5, function()
				pending = false
				if char.Parent then
					unrig(char)
					rig(char, true)
				end
			end)
		end
	end)
end

function rig(char, rebuilt)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum or char:FindFirstChild("NC_Ragdoll") then
		return
	end
	if not rebuilt then
		watchRebuilds(char)
	end
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	char:WaitForChild("HumanoidRootPart", 10)
	task.wait() -- let the body finish loading its joints
	local folder = Instance.new("Folder")
	folder.Name = "NC_Ragdoll"
	for _, m in char:GetDescendants() do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 then
			local lim = limitsFor(m)
			if lim then
				local a0 = Instance.new("Attachment")
				a0.Name = "RagA_" .. m.Name
				a0.CFrame = m.C0
				a0.Parent = m.Part0
				local a1 = Instance.new("Attachment")
				a1.Name = "RagB_" .. m.Name
				a1.CFrame = m.C1
				a1.Parent = m.Part1
				local bs = Instance.new("BallSocketConstraint")
				bs.Name = m.Name
				bs.Attachment0, bs.Attachment1 = a0, a1
				bs.LimitsEnabled = true
				bs.UpperAngle = lim[1]
				bs.TwistLimitsEnabled = true
				bs.TwistLowerAngle, bs.TwistUpperAngle = lim[2], lim[3]
				bs.Restitution = 0
				bs.MaxFrictionTorque = 4 -- a little muscle tone, so limbs don't flop like cloth
				bs.Parent = folder
				local nc = Instance.new("NoCollisionConstraint")
				nc.Part0, nc.Part1 = m.Part0, m.Part1
				nc.Parent = folder
			end
		end
	end
	folder.Parent = char
	if rebuilt then
		return
	end
	hum.Died:Connect(function()
		for _, m in char:GetDescendants() do
			if m:IsA("Motor6D") and limitsFor(m) then
				m.Enabled = false
			end
		end
		char:SetAttribute("Ragdoll", true)
	end)
end

local function setRagdoll(char, on)
	for _, m in char:GetDescendants() do
		if m:IsA("Motor6D") and limitsFor(m) then
			m.Enabled = not on
		end
	end
	char:SetAttribute("Ragdoll", on or nil)
end

local function fallDamage(v)
	if v < 75 then
		return 0
	elseif v < 90 then
		return (v - 75) * 1.4 -- a hard roll: up to ~20
	elseif v < 120 then
		return 21 + (v - 90) * 2.3 -- a bad fall: up to ~90
	end
	return 1000 -- from that high, nobody walks away
end

local budget = {}
local function allow(p, cost)
	local b = budget[p]
	local now = os.clock()
	if not b then
		b = { tokens = 10, t = now }
		budget[p] = b
	end
	b.tokens = math.min(10, b.tokens + (now - b.t) * 6)
	b.t = now
	if b.tokens < cost then
		return false
	end
	b.tokens -= cost
	return true
end

ActRE.OnServerEvent:Connect(function(player, kind, a, b)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or typeof(kind) ~= "string" or not allow(player, 1) then
		return
	end
	if kind == "ragdoll" then
		if hum.Health > 0 then
			setRagdoll(char, true)
		end
	elseif kind == "getup" then
		if hum.Health > 0 then
			setRagdoll(char, false)
			char:SetAttribute("MoveAct", ("getup|0.9|%.3f"):format(workspace:GetServerTimeNow()))
		end
	elseif kind == "fall" then
		if FALL_DAMAGE and typeof(a) == "number" and a == a and hum.Health > 0 then
			local dmg = fallDamage(math.clamp(a, 0, 400))
			if dmg > 0 then
				hum:TakeDamage(dmg)
			end
		end
	elseif ACTS[kind] then
		local dur = (typeof(a) == "number" and a == a) and math.clamp(a, 0.1, ACTS[kind] * 2) or ACTS[kind]
		local now = workspace:GetServerTimeNow()
		local t0 = (typeof(b) == "number" and math.abs(b - now) < 2) and b or now
		char:SetAttribute("MoveAct", ("%s|%.3f|%.3f"):format(kind, dur, t0))
	end
end)

-- look direction: keep the newest sample per player and publish at most ~15 times a second (so a burst of
-- packets never leaves an old direction showing)
local pendingLook = {}
LookRE.OnServerEvent:Connect(function(player, v)
	if typeof(v) ~= "Vector3" or v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
		return
	end
	pendingLook[player] = v
end)
task.spawn(function()
	while true do
		task.wait(0.066)
		for player, v in pendingLook do
			pendingLook[player] = nil
			local char = player.Parent and player.Character
			if char then
				char:SetAttribute("Look", Vector3.new(math.clamp(math.round(v.X), -80, 80), math.clamp(math.round(v.Y), -50, 50),
					math.clamp(math.round(v.Z * 20) / 20, 0, 1)))
			end
		end
	end
end)

local function onPlayer(p)
	p.CharacterAdded:Connect(rig)
	if p.Character then
		task.spawn(rig, p.Character)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayer, p)
end
Players.PlayerRemoving:Connect(function(p)
	budget[p], pendingLook[p] = nil, nil
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX15"><Properties><string name="Name">MovementClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- MovementClient: moving like a real person, with real weight. (MovementService is the server half.)
--   Momentum: you push off and build speed (slower the faster you already are), you can't stop on a dime (a
--   sprint skids a couple of steps), you corner in arcs that widen with speed, and asking to go the opposite way
--   at speed makes you plant and brake before turning. Walls kill your momentum; running flat out into one knocks
--   you back. Uphill is slower, downhill a touch faster.
--   Gaits: walk (hold Left Alt, or tilt the stick a little), jog (default), sprint (hold Left Shift; L3 or the
--   Sprint button toggle it). Sprinting burns stamina; tired, you slow down; empty, you have to jog it off.
--   Jumps are human-sized and carry your momentum, with little steering once you're off the ground.
--   Landings: soft dip, hard landing (you crouch and lose speed), a roll if you're moving, a ragdoll from higher;
--   fall damage from the impact speed (MovementService).
--   Vault and climb (press jump facing it): vault fences and rails, mantle onto low walls and counters, jump,
--   hang and pull up over walls and fences up to about 9 studs, dropping down the far side of thin ones.
--   Ragdoll: hard falls and being hit by a car; you get back up facing where your head was.
--   Body: everyone leans into acceleration and corners, heads turn toward where players look, out-of-breath
--   players breathe hard, and feet stand on stairs and slopes instead of floating. Everything is seen by all.
-- Other scripts can slow or freeze you without fighting this: Humanoid attributes SpeedFactor_<anything>
-- multiply your speed (0 freezes you and stops jumps), and a plain WalkSpeed change scales it too (16 = normal).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Remotes = RS:WaitForChild("Remotes")
local ActRE = Remotes:WaitForChild("MoveAct")
local LookRE = Remotes:WaitForChild("MoveLook")

-- the Blender-made animations (NCAnimPlayer + NCAnimations in ReplicatedStorage); without them the default
-- Roblox animations play with this script's procedural poses on top
local Anim = nil
task.spawn(function()
	local m = RS:FindFirstChild("NCAnimPlayer") or RS:WaitForChild("NCAnimPlayer", 10)
	if m then
		local ok, mod = pcall(require, m)
		if ok and type(mod) == "table" and mod.init() then
			Anim = mod
		end
	end
end)
-- which Blender clip plays each act; LEGS = acts that take over your legs (the rest only change how you look)
local ACT_CLIP = { vault = "Vault", mantle = "Mantle", climb = "Climb", roll = "Roll", land = "LandHard", stumble = "Stumble",
	getup = "GetUp", bump = "Bump", skid = "Skid", pivot = "Pivot", soft = "Land" }
local LEGS = { roll = true, land = true, stumble = true, getup = true, bump = true }

-- studs/s in this world's scale (~3.8 studs to a metre): walk ~1.3 m/s, jog ~4.2, sprint ~6.6
local WALK, JOG, SPRINT = 5, 16, 25
local BASE = 16 -- the WalkSpeed every other script thinks of as normal
local ACCEL0, ACCEL1 = 42, 6 -- push-off from a standstill / at full sprint (0->jog 0.5 s, jog->sprint ~0.75 s)
local SLOW_DECEL, STOP_DECEL, SKID_DECEL, PIVOT_DECEL = 30, 50, 40, 72 -- a sprint skids ~7 studs to a stop
local A_LAT = 75 -- how hard you can corner, studs/s^2 (sprint turns ~8 studs wide, jog ~3.4)
local TURN_MAX = math.rad(720)
local PIVOT_ANGLE = math.rad(125)
local AIR_ACCEL = 9
local JUMP_HEIGHT = 4.2
local SPRINT_TIME, REGEN_TIME, REGEN_IDLE = 12, 7, 4.5
local MAX_CLIMB, MAX_VAULT, MIN_OBST, REACH = 9.2, 4.6, 1.6, 3.4
local SPRINT_FOV = 5
local rad = math.rad
local ST = Enum.HumanoidStateType

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end
local function bodyOf(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and hum then
		return hrp, hum
	end
	return nil
end
local function lerp(a, b, t)
	return a + (b - a) * t
end
local function clamp01(x)
	return math.clamp(x, 0, 1)
end
local function wrapAngle(a)
	return (a + math.pi) % (2 * math.pi) - math.pi
end

---------------------------------------------------------------------------------------------- the world
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.RespectCanCollide = true
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
overlap.RespectCanCollide = true
local function refreshFilter()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local chutes = workspace:FindFirstChild("NC_LocalChutes")
	if chutes then
		table.insert(list, chutes)
	end
	params.FilterDescendantsInstances = list
	overlap.FilterDescendantsInstances = list
end
refreshFilter()

local function inWater(pos)
	for _, w in CollectionService:GetTagged("NC_Water") do
		if w:IsA("BasePart") and w:IsDescendantOf(workspace) then
			local lp = w.CFrame:PointToObjectSpace(pos)
			local h = w.Size / 2
			if math.abs(lp.X) <= h.X and math.abs(lp.Z) <= h.Z and math.abs(lp.Y) <= h.Y + 0.5 then
				return true
			end
		end
	end
	return false
end

-- is this box of space really empty? (true shapes, not bounding boxes, so a big building mesh next to a counter
-- doesn't block the vault)
local probe = Instance.new("Part")
probe.Name = "NC_MoveProbe"
probe.Anchored, probe.CanCollide, probe.CanTouch, probe.CanQuery = true, false, false, false
probe.Transparency = 1
probe.Parent = workspace.CurrentCamera
local function boxClear(cf, size)
	probe.Size = size
	probe.CFrame = cf
	return #workspace:GetPartsInPart(probe, overlap) == 0
end

---------------------------------------------------------------------------------------------- joints
local JN = { "Root", "Waist", "Neck", "RightShoulder", "LeftShoulder", "RightElbow", "LeftElbow", "RightHip", "LeftHip",
	"RightKnee", "LeftKnee", "RightAnkle", "LeftAnkle", "RightWrist", "LeftWrist" }
local JSET = {}
for _, n in JN do
	JSET[n] = true
end
local jointCache = setmetatable({}, { __mode = "k" })
local function jointsOf(char)
	local e = jointCache[char]
	-- (rescan if the body was rebuilt, e.g. a new outfit swapped the body parts and their joints)
	if e and (e.n >= #JN or os.clock() - e.t < 2) and not (e.Waist and e.Waist.Parent == nil) then
		return e
	end
	e = { n = 0, t = os.clock() }
	for _, d in char:GetDescendants() do
		if JSET[d.Name] and (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) and not e[d.Name] then
			e[d.Name] = d
			e.n += 1
		end
	end
	local hip, knee, ankle = e.RightHip, e.RightKnee, e.RightAnkle
	if hip and knee and ankle and hip:IsA("Motor6D") and knee:IsA("Motor6D") and ankle:IsA("Motor6D") then
		e.L1 = (hip.C1.Position - knee.C0.Position).Magnitude
		e.L2 = (knee.C1.Position - ankle.C0.Position).Magnitude
	end
	jointCache[char] = e
	return e
end

local function frames(j)
	if j:IsA("Motor6D") then
		return j.C0.Rotation, j.C1.Rotation
	end
	local a0, a1 = j.Attachment0, j.Attachment1
	local p0 = a0 and a0:FindFirstAncestorWhichIsA("BasePart")
	local p1 = a1 and a1:FindFirstAncestorWhichIsA("BasePart")
	if not (p0 and p1) then
		return nil
	end
	return p0.CFrame:ToObjectSpace(a0.WorldCFrame).Rotation, p1.CFrame:ToObjectSpace(a1.WorldCFrame).Rotation
end

-- absolute pose: the child's rotation (and offset) q relative to its rest pose, blended over the animation by alpha
local function setJoint(j, q, alpha)
	if not j then
		return
	end
	local c0, c1 = frames(j)
	if not c0 then
		return
	end
	local target = c0:Inverse() * q * c1
	j.Transform = alpha < 1 and j.Transform:Lerp(target, alpha) or target
end

-- additive pose: rotate the child by q (parent's axes, about the joint) on top of whatever the animation did this
-- frame. Remembers what it wrote so an un-animated joint doesn't pile the same offset up frame after frame.
local written = setmetatable({}, { __mode = "k" })
local function addTo(j, q)
	if not j then
		return
	end
	local c0 = frames(j)
	if not c0 then
		return
	end
	local cur = j.Transform
	local rec = written[j]
	local base = (rec and cur == rec[1]) and rec[2] or cur
	local value = c0:Inverse() * q * c0 * base
	j.Transform = value
	written[j] = { value, base }
end

local A_ = CFrame.Angles
local function D(x, y, z)
	return A_(rad(x), rad(y or 0), rad(z or 0))
end

-- how far the hips come down when the hip bends h and the knee k (radians, knee bends negative)
local function crouchDrop(J, h, k)
	local L1, L2 = J.L1 or 1.2, J.L2 or 1.2
	return (L1 + L2) - (L1 * math.cos(h) + L2 * math.cos(h + k))
end

---------------------------------------------------------------------------------------------- act poses
-- every act is a function of its progress u (0..1), so the same pose plays on every screen
local function crouchPose(J, a, w, deep)
	local h, k = rad((deep and 95 or 75) * a), rad(-(deep and 125 or 110) * a)
	setJoint(J.RightHip, A_(h, 0, rad(6 * a)), w)
	setJoint(J.LeftHip, A_(h, 0, rad(-6 * a)), w)
	setJoint(J.RightKnee, A_(k, 0, 0), w)
	setJoint(J.LeftKnee, A_(k, 0, 0), w)
	setJoint(J.RightAnkle, A_(-(h + k), 0, 0), w)
	setJoint(J.LeftAnkle, A_(-(h + k), 0, 0), w)
	setJoint(J.Waist, D(-(deep and 35 or 28) * a), w)
	setJoint(J.Neck, D(12 * a), w)
	setJoint(J.RightShoulder, D(40 * a, 0, 12 * a), w)
	setJoint(J.LeftShoulder, D(40 * a, 0, -12 * a), w)
	setJoint(J.RightElbow, D(45 * a), w)
	setJoint(J.LeftElbow, D(45 * a), w)
	setJoint(J.Root, CFrame.new(0, -crouchDrop(J, h, k), 0), w)
end

local POSE = {}
function POSE.vault(J, u)
	local a = clamp01((u - 0.12) / 0.22) * (1 - clamp01((u - 0.68) / 0.27))
	local w = clamp01(math.min(u / 0.1, (1 - u) / 0.12))
	setJoint(J.RightShoulder, D(20 + 40 * a, 0, 25 * a), w) -- hand planted on the top
	setJoint(J.RightElbow, D(10), w)
	setJoint(J.LeftShoulder, D(30 * a, 0, -75 * a), w) -- the free arm out for balance
	setJoint(J.LeftElbow, D(25 * a), w)
	setJoint(J.RightHip, D(80 * a), w) -- legs tucked and swung through
	setJoint(J.LeftHip, D(70 * a), w)
	setJoint(J.RightKnee, D(-100 * a), w)
	setJoint(J.LeftKnee, D(-95 * a), w)
	setJoint(J.Waist, D(-18 * a), w)
	setJoint(J.Neck, D(-8 * a), w)
	setJoint(J.Root, D(0, 0, -25 * a), w) -- body tipped over the planted hand
end
function POSE.mantle(J, u)
	local reach, push = clamp01(u / 0.3), clamp01((u - 0.3) / 0.4)
	local knee = clamp01((u - 0.45) / 0.3) * (1 - clamp01((u - 0.85) / 0.15))
	local w = clamp01(math.min(u / 0.08, (1 - u) / 0.12))
	local sh = lerp(lerp(20, 150, reach), 25, push)
	local el = 15 + 80 * math.sin(math.pi * push)
	setJoint(J.RightShoulder, D(sh, 0, 10), w)
	setJoint(J.LeftShoulder, D(sh, 0, -10), w)
	setJoint(J.RightElbow, D(el), w)
	setJoint(J.LeftElbow, D(el), w)
	setJoint(J.RightHip, D(100 * knee), w)
	setJoint(J.RightKnee, D(-115 * knee), w)
	setJoint(J.LeftHip, D(20 * knee), w)
	setJoint(J.LeftKnee, D(-50 * knee), w)
	setJoint(J.Waist, D(-25 * math.sin(math.pi * u)), w)
end
function POSE.climb(J, u)
	local w = clamp01(math.min(u / 0.08, (1 - u) / 0.1))
	local sh, el, hip, kn, waist, neck = 0, 0, 0, 0, 0, 0
	local rHip, rKnee
	if u < 0.26 then -- jump and reach
		local a = u / 0.26
		sh, el, hip, kn, neck = lerp(30, 170, a), lerp(30, 10, a), 20 * a, -35 * a, 20 * a
	elseif u < 0.38 then -- hanging from the edge
		local s = math.sin((u - 0.26) / 0.12 * math.pi)
		sh, el, hip, kn, neck = 168, 12, 12 + 4 * s, -20 - 6 * s, 20
	elseif u < 0.72 then -- pull up, feet walking the wall
		local b = (u - 0.38) / 0.34
		sh, el = lerp(168, 35, b), 12 + 93 * math.sin(math.pi * b * 0.75) -- elbows bend hard, then start to press
		hip, kn, waist, neck = lerp(12, 40, b), lerp(-20, -60, b), -10 * b, lerp(20, -5, b)
	else -- knee up onto the top
		local c = (u - 0.72) / 0.28
		local s = math.sin(math.pi * c)
		sh, el = lerp(35, 10, c), lerp(78, 10, c)
		rHip, rKnee = lerp(40, 105, s), lerp(-60, -115, s)
		hip, kn, waist, neck = lerp(40, -5, c), lerp(-60, -30, c), lerp(-10, -20, s), -5
	end
	setJoint(J.RightShoulder, D(sh, 0, 8), w)
	setJoint(J.LeftShoulder, D(sh, 0, -8), w)
	setJoint(J.RightElbow, D(el), w)
	setJoint(J.LeftElbow, D(el), w)
	setJoint(J.RightHip, D(rHip or hip), w)
	setJoint(J.RightKnee, D(rKnee or kn), w)
	setJoint(J.LeftHip, D(hip), w)
	setJoint(J.LeftKnee, D(kn), w)
	setJoint(J.Waist, D(waist), w)
	setJoint(J.Neck, D(neck), w)
end
function POSE.roll(J, u)
	local a = math.sin(math.pi * u)
	setJoint(J.RightHip, D(115 * a), 1)
	setJoint(J.LeftHip, D(115 * a), 1)
	setJoint(J.RightKnee, D(-135 * a), 1)
	setJoint(J.LeftKnee, D(-135 * a), 1)
	setJoint(J.RightShoulder, D(70 * a, 0, 15 * a), 1)
	setJoint(J.LeftShoulder, D(70 * a, 0, -15 * a), 1)
	setJoint(J.RightElbow, D(100 * a), 1)
	setJoint(J.LeftElbow, D(100 * a), 1)
	setJoint(J.Neck, D(-40 * a), 1)
	setJoint(J.Waist, D(-30 * a), 1)
	-- head over heels around the tucked body's middle, which travels low along the ground
	local s = u * u * (3 - 2 * u)
	local p = Vector3.new(0, -0.5, 0)
	setJoint(J.Root, CFrame.new(0, -1.4 * a, 0) * CFrame.new(p) * A_(-2 * math.pi * s, 0, 0) * CFrame.new(-p), 1)
end
function POSE.land(J, u)
	crouchPose(J, (1 - u) ^ 1.6, clamp01(u / 0.04), false)
end
function POSE.stumble(J, u)
	crouchPose(J, 0.55 * (1 - u) ^ 1.4, clamp01(u / 0.04), false)
end
function POSE.getup(J, u)
	crouchPose(J, (1 - u) ^ 1.3, 1, true)
end
function POSE.bump(J, u)
	local a = math.sin(math.pi * u)
	setJoint(J.Waist, D(16 * a), a)
	setJoint(J.Neck, D(22 * a), a)
	setJoint(J.RightShoulder, D(60 * a, 0, 20 * a), a)
	setJoint(J.LeftShoulder, D(60 * a, 0, -20 * a), a)
	setJoint(J.RightElbow, D(85 * a), a)
	setJoint(J.LeftElbow, D(85 * a), a)
end

---------------------------------------------------------------------------------------------- local state
local M = {
	V = Vector3.zero, dir = Vector3.new(0, 0, -1), raw = Vector3.zero, controlling = false, lastSet = nil, ext = 1,
	factor = 1, stamina = 1, exhausted = false, lastSprint = -9, sprintHeld = false, sprintToggle = false,
	walkHeld = false, stopT = 0, blockT = 0, air = false, airVy = 0, jumpLockUntil = 0, jumpEnabled = nil,
	fovOff = 0, lookT = 0, lookSent = Vector3.new(999, 0, 0), lastActEnd = -9, sprinting = false, lastFull = 0,
}
local A = { kind = nil } -- the act in progress
local R = { on = false } -- ragdoll

local controls
task.spawn(function()
	local ok, res = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)):GetControls()
	end)
	if ok then
		controls = res
	end
end)

-- shift lock moves to Right Shift so Left Shift can sprint
task.spawn(function()
	pcall(function()
		local ml = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10):WaitForChild("CameraModule", 5)
			:WaitForChild("MouseLockController", 5)
		local bk = ml:WaitForChild("BoundKeys", 5)
		if bk and bk:IsA("StringValue") then
			bk.Value = "RightShift"
		end
	end)
end)

local function rawInput(hum)
	if controls then
		local mv = controls:GetMoveVector()
		if mv.Magnitude < 0.01 then
			return Vector3.zero
		end
		local cf = workspace.CurrentCamera.CFrame
		local fwd = flat(cf.LookVector)
		if fwd.Magnitude < 0.2 then
			fwd = flat(cf.UpVector)
		end
		fwd = fwd.Unit
		local right = fwd:Cross(Vector3.yAxis)
		local w = right * mv.X - fwd * mv.Z
		return w.Magnitude > 0 and w.Unit * math.min(1, mv.Magnitude) or Vector3.zero
	end
	return hum.MoveDirection
end

local function setJumpEnabled(hum, on)
	if M.jumpEnabled ~= on then
		M.jumpEnabled = on
		hum:SetStateEnabled(ST.Jumping, on)
	end
end

local function recalcFactor(hum)
	local f = 1
	for k, v in hum:GetAttributes() do
		if typeof(v) == "number" and string.sub(k, 1, 12) == "SpeedFactor_" then
			f *= math.max(0, v)
		end
	end
	M.factor = f
end

---------------------------------------------------------------------------------------------- acts
local function startPoseAct(kind, dur, extra)
	A = { kind = kind, dur = dur, t0 = os.clock(), pose = true }
	if extra then
		for k, v in extra do
			A[k] = v
		end
	end
	ActRE:FireServer(kind, dur, workspace:GetServerTimeNow())
end

local function pathAt(keys, u)
	for i = 1, #keys - 1 do
		local k0, k1 = keys[i], keys[i + 1]
		if u <= k1.u or i == #keys - 1 then
			local s = clamp01((u - k0.u) / math.max(k1.u - k0.u, 1e-3))
			local h = k0.p:Lerp(k1.p, s)
			local e = k1.ease == "out" and (1 - (1 - s) ^ 2) or (k1.ease == "in" and s * s) or (s * s * (3 - 2 * s))
			return Vector3.new(h.X, lerp(k0.p.Y, k1.p.Y, e), h.Z)
		end
	end
	return keys[#keys].p
end

-- what's in front of you, and can you get over or onto it?
local function planObstacle(hrp, hum, f)
	local rootH = hrp.Size.Y / 2 + hum.HipHeight
	local feetY = hrp.Position.Y - rootH
	local base = Vector3.new(hrp.Position.X, feetY, hrp.Position.Z)
	local hitD, hitN, hitPart
	for _, h in { 1.7, 3.0, 4.4, 6.0, 7.6 } do
		local r = workspace:Raycast(base + Vector3.new(0, h, 0), f * REACH, params)
		if r and math.abs(r.Normal.Y) < 0.35 and (not hitD or r.Distance < hitD) then
			hitD, hitN, hitPart = r.Distance, r.Normal, r.Instance
		end
	end
	if not hitD then
		return nil
	end
	if not hitPart.Anchored and hitPart.AssemblyLinearVelocity.Magnitude > 4 then
		return nil -- not onto moving traffic
	end
	local fw = -flat(hitN)
	if fw.Magnitude < 0.5 or fw.Unit:Dot(f) < 0.6 then
		return nil
	end
	f = fw.Unit -- square up to the face
	if workspace:Raycast(base + Vector3.new(0, MAX_CLIMB + 0.4, 0), f * (hitD + 1.2), params) then
		return nil -- taller than you can reach
	end
	-- stairs or a ramp (the ground already climbs before the face): that's just a jump
	if hitD > 0.9 then
		local pre = base + f * (hitD - 0.5)
		local gnd = workspace:Raycast(Vector3.new(pre.X, feetY + 3, pre.Z), Vector3.new(0, -4, 0), params)
		if gnd and gnd.Position.Y > feetY + 0.5 then
			return nil
		end
	end
	-- find the top just past the near face (two probes, so a thin rail or fence panel is found too)
	local top, edgeOff
	for _, off in { 0.1, 0.35 } do
		local edge = base + f * (hitD + off)
		local r = workspace:Raycast(Vector3.new(edge.X, feetY + MAX_CLIMB + 0.4, edge.Z), Vector3.new(0, -(MAX_CLIMB - 0.6), 0), params)
		if r and r.Normal.Y >= 0.7 and (not top or r.Position.Y > top.Position.Y + 0.05) then
			top, edgeOff = r, off
		end
	end
	if not top then
		return nil
	end
	local topY = top.Position.Y
	local h = topY - feetY
	if h < MIN_OBST or h > MAX_CLIMB then
		return nil
	end
	-- thin (a fence, a rail) or deep (a wall top, a counter, a roof)?
	local depth, prev = nil, edgeOff
	for k = 1, 8 do
		local d = 0.35 + k * 0.45
		local q = base + f * (hitD + d)
		if not workspace:Raycast(Vector3.new(q.X, topY + 0.6, q.Z), Vector3.new(0, -1.4, 0), params) then
			depth = prev + 0.2
			break
		end
		prev = d
	end
	local thin = depth ~= nil and depth <= 3.2
	local look = CFrame.lookAt(Vector3.zero, f)
	local function at(s, y)
		local p = base + f * s
		return Vector3.new(p.X, y, p.Z)
	end
	local speedIn = flat(hrp.AssemblyLinearVelocity):Dot(f)
	local start = hrp.Position
	if thin then
		-- room to get the body across and come down beyond?
		local mid = at(hitD + depth / 2, topY + 1.9)
		if not boxClear(look + mid, Vector3.new(1.8, 3.2, depth + 0.8)) then
			return nil
		end
		if not boxClear(look + at(hitD + depth + 1.5, topY + 1.6), Vector3.new(1.8, 3.0, 1.8)) then
			return nil
		end
	else
		local onto = at(hitD + 1.4, topY + rootH + 0.1)
		if not boxClear(look + onto, Vector3.new(1.8, rootH * 2 - 0.4, 1.8)) then
			return nil -- no headroom up there
		end
	end
	if h <= MAX_VAULT then
		if thin then
			local dur = math.clamp(0.62 - 0.012 * math.max(0, speedIn), 0.42, 0.62) * (1 + hitD * 0.06)
			return { kind = "vault", f = f, dur = dur, keys = {
				{ u = 0, p = start },
				{ u = 0.38, p = at(hitD - 0.2, topY + 1.55), ease = "out" },
				{ u = 0.8, p = at(hitD + depth + 0.4, topY + 1.45) },
				{ u = 1, p = at(hitD + depth + 1.1, topY + 1.1), ease = "in" },
			}, release = f * math.max(9, speedIn * 0.85) - Vector3.new(0, 6, 0), cost = 0.04 }
		end
		return { kind = "mantle", f = f, dur = 0.6 + 0.05 * h, keys = {
			{ u = 0, p = start },
			{ u = 0.45, p = at(hitD - 0.25, math.max(topY + 1.0, feetY + rootH)), ease = "out" },
			{ u = 1, p = at(hitD + 1.3, topY + rootH) },
		}, cost = 0.05 }
	end
	-- (never lower than standing height, or the legs would go into the ground on lower walls)
	local standY = feetY + rootH
	local keys = {
		{ u = 0, p = start },
		{ u = 0.26, p = at(hitD - 0.95, math.max(topY - 2.9, standY)), ease = "out" }, -- hanging, hands on the edge
		{ u = 0.38, p = at(hitD - 0.92, math.max(topY - 3.0, standY)) },
		{ u = 0.72, p = at(hitD - 0.3, topY + 0.9) },
	}
	local release
	if thin then
		table.insert(keys, { u = 1, p = at(hitD + depth + 0.7, topY + 1.5) })
		release = f * 5 - Vector3.new(0, 2, 0)
	else
		table.insert(keys, { u = 1, p = at(hitD + 1.3, topY + rootH) })
	end
	return { kind = "climb", f = f, dur = 1.25 + 0.07 * (h - MAX_VAULT), keys = keys, release = release, cost = 0.12 }
end

local function setBodyCollide(char, hrp, saved, mode)
	for _, p in char:GetDescendants() do
		if p:IsA("BasePart") then
			if saved[p] == nil then
				saved[p] = p.CanCollide
			end
			if mode == "none" then
				p.CanCollide = false
			elseif mode == "body" then
				p.CanCollide = p ~= hrp and p.Parent == char
			end
		end
	end
end
local function restoreCollide(saved)
	for p, c in saved do
		if p.Parent then
			p.CanCollide = c
		end
	end
end

local function startPathAct(char, hrp, hum, plan)
	if M.stamina < plan.cost then
		plan.dur *= 1.25 -- tired: slower over
	end
	M.stamina = math.max(0, M.stamina - plan.cost)
	A = { kind = plan.kind, dur = plan.dur, t0 = os.clock(), path = true, keys = plan.keys, f = plan.f,
		release = plan.release, lastP = hrp.Position, saved = {} }
	hum.Jump = false
	setBodyCollide(char, hrp, A.saved, "none")
	hum:ChangeState(ST.Physics)
	ActRE:FireServer(plan.kind, plan.dur, workspace:GetServerTimeNow())
end

local function endAct(hum, hrp)
	if A.path then
		restoreCollide(A.saved)
		if hrp then
			local rel = A.release or (A.f * 4)
			hrp.AssemblyLinearVelocity = rel
			M.V = flat(rel)
			M.dir = A.f
		end
		if hum then
			hum.Jump = false
			hum:ChangeState(A.release and ST.Freefall or ST.Running)
		end
	end
	A = { kind = nil }
	M.lastActEnd = os.clock()
end

---------------------------------------------------------------------------------------------- ragdoll
local RAGJ = {}
for _, n in { "Neck", "Waist", "LeftShoulder", "RightShoulder", "LeftElbow", "RightElbow", "LeftWrist", "RightWrist",
	"LeftHip", "RightHip", "LeftKnee", "RightKnee", "LeftAnkle", "RightAnkle", "Right Shoulder", "Left Shoulder",
	"Right Hip", "Left Hip" } do
	RAGJ[n] = true
end
local function localMotors(char, enabled)
	for _, m in char:GetDescendants() do
		if m:IsA("Motor6D") and RAGJ[m.Name] then
			m.Enabled = enabled
		end
	end
end

local function startRagdoll(char, hrp, hum, vel, minT)
	if R.on or not char:FindFirstChild("NC_Ragdoll") then
		return false
	end
	if A.kind then
		endAct(nil, nil)
	end
	R = { on = true, t0 = os.clock(), minT = minT, saved = {} }
	hum.CameraOffset = Vector3.zero
	setBodyCollide(char, hrp, R.saved, "body")
	localMotors(char, false)
	hum:ChangeState(ST.Physics)
	if vel then
		for p in R.saved do
			if p.Parent == char then
				p.AssemblyLinearVelocity = vel + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 6
			end
		end
	end
	ActRE:FireServer("ragdoll")
	M.V = Vector3.zero
	return true
end

local function getUp(char, hrp, hum)
	local lt = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or hrp
	local ut = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or hrp
	local facing = flat(ut.CFrame.UpVector) -- stand up facing where your head was
	if facing.Magnitude < 0.2 then
		facing = flat(ut.CFrame.LookVector)
	end
	facing = facing.Magnitude > 0.05 and facing.Unit or Vector3.new(0, 0, -1)
	local base = lt.Position
	local hit = workspace:Raycast(base + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), params)
	local gy = hit and hit.Position.Y or (base.Y - 1)
	local rootH = hrp.Size.Y / 2 + hum.HipHeight
	local at = Vector3.new(base.X, gy + rootH, base.Z)
	restoreCollide(R.saved)
	hrp.CFrame = CFrame.lookAt(at, at + facing)
	hrp.AssemblyLinearVelocity = Vector3.zero
	localMotors(char, true)
	R = { on = false }
	M.dir = facing
	hum:ChangeState(ST.GettingUp)
	ActRE:FireServer("getup")
	A = { kind = "getup", dur = 0.9, t0 = os.clock(), pose = true } -- (the server announces it to everyone)
end

---------------------------------------------------------------------------------------------- landings
local function onLand(char, hrp, hum, v)
	local feet = hrp.Position - Vector3.new(0, hrp.Size.Y / 2 + hum.HipHeight, 0)
	if inWater(feet) or inWater(hrp.Position) then
		return
	end
	local hs = M.V.Magnitude
	if v > 68 then
		ActRE:FireServer("fall", v)
	end
	if v > 90 then
		if not startRagdoll(char, hrp, hum, flat(hrp.AssemblyLinearVelocity) * 0.5, v > 120 and 3.5 or 2.2) then
			startPoseAct("land", 0.8)
			M.V = Vector3.zero
		end
	elseif v > 68 then
		if hs > 10 then
			startPoseAct("roll", 0.65, { f = M.dir, v0 = math.min(hs, 18) })
		else
			startPoseAct("land", 0.6)
			M.V = Vector3.zero
		end
	elseif v > 50 then
		startPoseAct("stumble", 0.4)
		M.V *= 0.5
	elseif v > 22 then
		if Anim then
			startPoseAct("soft", 0.32) -- knees give a little (everyone sees it; you keep moving)
		else
			M.dip = os.clock()
			M.dipAmt = clamp01((v - 22) / 28)
		end
	end
	M.jumpLockUntil = os.clock() + (v > 50 and 0.6 or 0.25) -- no bunny hopping
end

---------------------------------------------------------------------------------------------- input
local function onSprint(_, state, input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		M.sprintHeld = state == Enum.UserInputState.Begin
	elseif state == Enum.UserInputState.Begin then
		M.sprintToggle = not M.sprintToggle
	end
	return Enum.ContextActionResult.Sink
end
local function onWalk(_, state)
	M.walkHeld = state == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Pass
end
CAS:BindActionAtPriority("NC_Sprint", onSprint, true, 2500, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
CAS:SetTitle("NC_Sprint", "Sprint")
pcall(function()
	CAS:SetPosition("NC_Sprint", UDim2.new(1, -170, 1, -150))
end)
CAS:BindActionAtPriority("NC_Walk", onWalk, false, 2500, Enum.KeyCode.LeftAlt)

UserInputService.JumpRequest:Connect(function()
	local char = player.Character
	local hrp, hum = bodyOf(char)
	if not hrp or (A.kind and (A.path or LEGS[A.kind])) or R.on or not M.controlling or M.factor < 0.01 then
		return
	end
	local st = hum:GetState()
	if not (st == ST.Running or st == ST.RunningNoPhysics or st == ST.Landed) then
		return
	end
	if os.clock() - M.lastActEnd < 0.3 then
		return
	end
	local f = M.raw.Magnitude > 0.1 and M.raw.Unit or flat(hrp.CFrame.LookVector).Unit
	local plan = planObstacle(hrp, hum, f)
	if plan then
		startPathAct(char, hrp, hum, plan)
	elseif M.sprinting then
		M.stamina = math.max(0, M.stamina - 0.04)
	end
end)

---------------------------------------------------------------------------------------------- HUD
local gui = Instance.new("ScreenGui")
gui.Name = "MovementHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local barBg = Instance.new("Frame")
barBg.AnchorPoint = Vector2.new(0.5, 1)
barBg.Position = UDim2.new(0.5, 0, 1, -88)
barBg.Size = UDim2.fromOffset(170, 6)
barBg.BackgroundColor3 = Color3.fromRGB(10, 12, 16)
barBg.BackgroundTransparency = 0.45
barBg.BorderSizePixel = 0
barBg.Visible = false
barBg.Parent = gui
Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)
local bar = Instance.new("Frame")
bar.Size = UDim2.fromScale(1, 1)
bar.BackgroundColor3 = Color3.fromRGB(26, 216, 216)
bar.BorderSizePixel = 0
bar.Parent = barBg
Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

---------------------------------------------------------------------------------------------- the local body
local function releaseControl(hum)
	if M.controlling then
		M.controlling = false
		local ws = BASE * M.ext
		hum.WalkSpeed = ws
		M.lastSet = ws
	end
end

local function groundBelow(hrp, hum)
	local rootH = hrp.Size.Y / 2 + hum.HipHeight
	return workspace:Raycast(hrp.Position, Vector3.new(0, -(rootH + 1.5), 0), params)
end

local function stepMove(dt)
	local char = player.Character
	local hrp, hum = bodyOf(char)
	if not hrp then
		return
	end
	dt = math.min(dt, 0.1)
	local now = os.clock()
	local cam = workspace.CurrentCamera

	-- ragdolled: let physics have the body; get up once it has come to rest
	if R.on then
		if hum.Health > 0 then
			if hum:GetState() ~= ST.Physics then
				hum:ChangeState(ST.Physics)
			end
			for p, _ in R.saved do
				if p.Parent == char and p ~= hrp then
					p.CanCollide = true
				end
			end
			local lt = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or hrp
			local t = now - R.t0
			if t > R.minT and (lt.AssemblyLinearVelocity.Magnitude < 3 or t > R.minT + 4) then
				getUp(char, hrp, hum)
			end
		end
		return
	end
	-- vault / mantle / climb: the body follows the planned path
	if A.kind and A.path then
		local u = (now - A.t0) / A.dur
		if u >= 1 or hum.Health <= 0 then
			endAct(hum, hrp)
		else
			local p = pathAt(A.keys, u)
			local v = (p - A.lastP) / math.max(dt, 1 / 240)
			A.lastP = p
			hrp.CFrame = CFrame.lookAt(p, p + A.f)
			hrp.AssemblyLinearVelocity = v
			hrp.AssemblyAngularVelocity = Vector3.zero
			if hum:GetState() ~= ST.Physics then
				hum:ChangeState(ST.Physics)
			end
		end
		return
	end
	if A.kind and A.pose and now - A.t0 >= A.dur then
		A = { kind = nil }
		M.lastActEnd = now
		hum.CameraOffset = Vector3.zero
	end

	local st = hum:GetState()
	local busy = hum.Health <= 0 or hum.SeatPart ~= nil or hum.Sit or hum.PlatformStand or st == ST.Physics or st == ST.Seated
		or st == ST.Dead or st == ST.Climbing or st == ST.Swimming or st == ST.PlatformStanding
	if busy then
		releaseControl(hum)
		setJumpEnabled(hum, true) -- never leave someone unable to jump out of a seat or off a ladder
		M.V = flat(hrp.AssemblyLinearVelocity)
		M.air = false
		-- the sprint view: gone at once when another script takes the body (skydiving, swimming: they save and
		-- restore the FOV themselves, minus the NC_FovOffset we publish), eased out otherwise
		if M.fovOff ~= 0 then
			local newOff = (st == ST.Physics or math.abs(M.fovOff) < 0.05) and 0 or M.fovOff * math.max(0, 1 - dt * 4)
			cam.FieldOfView += newOff - M.fovOff
			M.fovOff = newOff
			cam:SetAttribute("NC_FovOffset", newOff)
		end
		return
	end
	-- someone else changed WalkSpeed (a slow-down, a freeze, a boost): that scales us
	if M.lastSet == nil or math.abs(hum.WalkSpeed - M.lastSet) > 0.01 then
		M.ext = math.clamp(hum.WalkSpeed / BASE, 0, 4)
		if not M.controlling then
			M.V = flat(hrp.AssemblyLinearVelocity)
		end
	end
	M.controlling = true
	local mult = M.ext * M.factor

	local raw = rawInput(hum)
	M.raw = raw
	local mag = raw.Magnitude
	local grounded = st ~= ST.Freefall and st ~= ST.Jumping and st ~= ST.FallingDown
	if not grounded then
		M.air = true
		M.airVy = hrp.AssemblyLinearVelocity.Y
	end

	-- gait
	if mag < 0.05 then
		M.stopT += dt
		if M.stopT > 0.4 then
			M.sprintToggle = false
		end
	else
		M.stopT = 0
	end
	local target, sprinting = 0, false
	if mag >= 0.05 then
		if M.walkHeld then
			target = WALK
		elseif mag < 0.55 then
			target = WALK * math.clamp(mag / 0.55, 0.35, 1)
		elseif (M.sprintHeld or M.sprintToggle) and not M.exhausted and M.stamina > 0 then
			sprinting = true
			target = JOG + (SPRINT - JOG) * (0.55 + 0.45 * clamp01(M.stamina / 0.3))
		else
			target = JOG
		end
	end
	-- the ground: slopes, and what you're standing on (moving floors)
	local g = groundBelow(hrp, hum)
	local floorVel = Vector3.zero
	if g then
		if not g.Instance.Anchored then
			floorVel = flat(g.Instance:GetVelocityAtPosition(g.Position))
		end
		local d = mag > 0.05 and raw.Unit or M.dir
		local n = g.Normal
		if n.Y > 0.3 then
			local grade = -(n.X * d.X + n.Z * d.Z) / n.Y
			target *= grade > 0 and (1 - 0.4 * clamp01(grade)) or (1 + 0.08 * clamp01(-grade))
		end
	end
	target *= mult

	-- a pose act takes the legs for a moment (soft landings, skids and pivots are just how the body looks)
	if A.kind and A.pose and LEGS[A.kind] then
		local u = clamp01((now - A.t0) / A.dur)
		if A.kind == "roll" then
			M.dir = A.f or M.dir
			M.V = M.dir * lerp(A.v0 or 14, 8, u) * mult
		else
			M.V = M.V * math.max(0, 1 - dt * 12)
		end
		local shake = (A.kind == "land" or A.kind == "stumble") and (1 - u) * 0.25 or 0
		hum.CameraOffset = shake > 0.01 and Vector3.new(0, -shake * (A.kind == "land" and 1.6 or 0.8), 0) or Vector3.zero
		sprinting = false
	elseif grounded then
		local speed = M.V.Magnitude
		local dir = speed > 0.05 and M.V.Unit or M.dir
		if target > 0 then
			local want = raw.Unit
			if speed < 2 then
				dir = want -- from (nearly) standing you just turn and go
			end
			local ang = math.atan2(dir:Cross(want).Y, dir:Dot(want))
			if math.abs(ang) > PIVOT_ANGLE and speed > 13 then
				speed = math.max(0, speed - PIVOT_DECEL * dt) -- plant and brake before turning round
				if not A.kind then
					startPoseAct("pivot", 0.38)
				end
			else
				local maxTurn = math.min(TURN_MAX, A_LAT / math.max(speed, 1)) * dt
				dir = CFrame.Angles(0, math.clamp(ang, -maxTurn, maxTurn), 0):VectorToWorldSpace(dir)
				if speed < target then
					local a = lerp(ACCEL0, ACCEL1, clamp01(speed / SPRINT))
					speed = math.min(target, speed + a * dt)
				else
					speed = math.max(target, speed - SLOW_DECEL * dt)
				end
			end
		else
			if speed > 19 and not A.kind then
				startPoseAct("skid", 0.55) -- stopping from a sprint: lean back, dig the front heel in
			end
			speed = math.max(0, speed - (speed > JOG + 1 and SKID_DECEL or STOP_DECEL) * dt)
		end
		-- walls take your momentum: if the body isn't actually getting where the momentum says, bleed it off
		local actual = flat(hrp.AssemblyLinearVelocity) - floorVel
		local along = actual:Dot(dir)
		if speed > 2 and along < speed - 7 then
			M.blockT += dt
			if M.blockT > 0.18 then
				speed = math.max(0, along) + 1
			end
		else
			M.blockT = 0
		end
		-- flat out into a wall: it knocks you back
		if speed > 21 then
			local r = workspace:Raycast(hrp.Position + Vector3.new(0, 0.5, 0), dir * 1.9, params)
			if r and math.abs(r.Normal.Y) < 0.3 and r.Normal:Dot(dir) < -0.8 then
				speed = 0
				hrp.AssemblyLinearVelocity = -dir * 10 + Vector3.new(0, 4, 0)
				startPoseAct("bump", 0.45)
			end
		end
		M.V = dir * speed
		if speed > 0.05 then
			M.dir = dir
		end
	else
		-- in the air you keep what you had; a little steering, no brakes
		if target > 0 then
			local want = raw.Unit * target
			local dv = want - M.V
			if dv.Magnitude > AIR_ACCEL * dt then
				dv = dv.Unit * AIR_ACCEL * dt
			end
			local nv = M.V + dv
			if nv.Magnitude > math.max(M.V.Magnitude, target) then
				nv = nv.Unit * math.max(M.V.Magnitude, target)
			end
			M.V = nv
		end
	end

	-- drive the Humanoid with the momentum
	local speed = M.V.Magnitude
	if controls then
		hum:Move(speed > 0.05 and M.V.Unit or Vector3.zero, false)
	end
	hum.WalkSpeed = speed
	M.lastSet = speed
	setJumpEnabled(hum, M.factor > 0.01 and now >= M.jumpLockUntil and not (A.kind and (A.path or LEGS[A.kind])))

	-- stamina
	M.sprinting = sprinting and speed > JOG + 0.5
	if M.sprinting then
		M.stamina = math.max(0, M.stamina - dt / SPRINT_TIME)
		M.lastSprint = now
		if M.stamina <= 0 then
			M.exhausted = true
		end
	elseif now - M.lastSprint > 1 then
		M.stamina = math.min(1, M.stamina + dt / (speed < 1 and REGEN_IDLE or REGEN_TIME))
	end
	if M.exhausted and M.stamina > 0.35 then
		M.exhausted = false
	end
	if M.stamina < 0.999 or M.sprinting then
		M.lastFull = now
	end
	barBg.Visible = now - M.lastFull < 1.5
	bar.Size = UDim2.fromScale(M.stamina, 1)
	bar.BackgroundColor3 = M.exhausted and Color3.fromRGB(255, 90, 80) or Color3.fromRGB(26, 216, 216)

	-- the view opens up a little at a sprint (added on top of whatever FOV the game sets)
	local wantOff = M.sprinting and SPRINT_FOV * clamp01((speed - JOG) / (SPRINT - JOG)) or 0
	local newOff = M.fovOff + (wantOff - M.fovOff) * math.min(1, dt * 4)
	if math.abs(newOff - M.fovOff) > 1e-4 then
		cam.FieldOfView += newOff - M.fovOff
		M.fovOff = newOff
		cam:SetAttribute("NC_FovOffset", newOff)
	end

	-- where you're looking, and how hard you're breathing, for everyone else
	if now - M.lookT > 0.1 then
		local lv = hrp.CFrame:VectorToObjectSpace(cam.CFrame.LookVector)
		local yaw = math.deg(math.atan2(-lv.X, -lv.Z))
		local pitch = math.deg(math.asin(math.clamp(lv.Y, -1, 1)))
		if math.abs(yaw) > 110 then
			yaw, pitch = 0, 0
		end
		local v = Vector3.new(math.clamp(yaw, -75, 75), math.clamp(pitch, -45, 45), M.stamina)
		if (v - M.lookSent).Magnitude > 3 or math.abs(v.Z - M.lookSent.Z) > 0.05 then
			M.lookSent = v
			M.lookT = now
			LookRE:FireServer(v)
		end
	end
end
RunService:BindToRenderStep("NC_Movement", Enum.RenderPriority.Input.Value + 1, stepMove)

---------------------------------------------------------------------------------------------- every body on screen
local CS = setmetatable({}, { __mode = "k" })
local NOSKIP = {}
local RIGHT_ARM = { RightShoulder = true, RightElbow = true, RightWrist = true }
local BOTH_ARMS = { RightShoulder = true, RightElbow = true, RightWrist = true, LeftShoulder = true, LeftElbow = true, LeftWrist = true }
local function stateOf(char)
	local s = CS[char]
	if not s then
		s = { v = Vector3.zero, vPrev = Vector3.zero, acc = Vector3.zero, yaw = 0, yawRate = 0, pitch = 0, roll = 0,
			ly = 0, lp = 0, ik = 0 }
		CS[char] = s
	end
	return s
end

local frame = 0
RunService.Stepped:Connect(function(_, dt)
	dt = math.clamp(dt, 1 / 240, 0.1)
	frame += 1
	if frame % 30 == 1 then
		refreshFilter()
	end
	local cam = workspace.CurrentCamera
	local camPos = cam.CFrame.Position
	local now = os.clock()
	local sNow = workspace:GetServerTimeNow()
	local g = workspace.Gravity
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local hrp, hum = bodyOf(char)
		if not hrp or (hrp.Position - camPos).Magnitude > 160 then
			continue
		end
		local isMe = p == player
		if hum.Health <= 0 or hum.SeatPart or char:GetAttribute("SwimPose") or char:GetAttribute("ChuteState") then
			continue
		end
		if (isMe and R.on) or (not isMe and char:GetAttribute("Ragdoll")) then
			continue
		end
		local J = jointsOf(char)
		local cs = stateOf(char)
		local st = hum:GetState()
		if not isMe and (st == ST.Climbing or st == ST.Swimming) then
			continue -- ladders and terrain water keep their own animations
		end

		-- how this body is moving
		local vel = (isMe and M.controlling) and M.V or flat(hrp.AssemblyLinearVelocity)
		cs.vPrev = cs.v
		cs.v = cs.v:Lerp(vel, 1 - math.exp(-dt / (isMe and 0.03 or 0.1)))
		cs.acc = cs.acc:Lerp((cs.v - cs.vPrev) / dt, 1 - math.exp(-dt / 0.12))
		local speed = cs.v.Magnitude
		if speed > 2 then
			local yaw = math.atan2(-cs.v.X, -cs.v.Z)
			cs.yawRate += (wrapAngle(yaw - cs.yaw) / dt - cs.yawRate) * (1 - math.exp(-dt / 0.12))
			cs.yaw = yaw
		else
			cs.yawRate *= math.exp(-dt / 0.1)
		end
		local grounded
		if isMe then
			grounded = st == ST.Running or st == ST.RunningNoPhysics or st == ST.Landed
			if st == ST.Jumping and not cs.wasJump then
				cs.takeoffT = now
			end
			cs.wasJump = st == ST.Jumping
		else
			local vy = hrp.AssemblyLinearVelocity.Y
			grounded = math.abs(vy) < 4
			if vy > 8 and (cs.lastVy or 0) <= 8 then
				cs.takeoffT = now
			end
			cs.lastVy = vy
		end

		-- where they're looking, and how out of breath they are
		local ly, lp, stamina
		if isMe then
			ly, lp, stamina = M.lookSent.X, M.lookSent.Y, M.stamina
			if M.lookSent.X == 999 then
				ly, lp = 0, 0
			end
		else
			local lk = char:GetAttribute("Look")
			if typeof(lk) == "Vector3" then
				ly, lp, stamina = lk.X, lk.Y, lk.Z
			else
				ly, lp, stamina = 0, 0, 1
			end
		end

		-- an act in progress?
		local kind, u
		if isMe then
			if A.kind then
				kind, u = A.kind, (now - A.t0) / A.dur
			end
		else
			local s = char:GetAttribute("MoveAct")
			if typeof(s) == "string" then
				local n, d, t0 = string.match(s, "^(%a+)|([%d%.]+)|([%d%.]+)$")
				if n and (POSE[n] or (Anim and ACT_CLIP[n] and Anim.has(ACT_CLIP[n]))) then
					local uu = (sNow - tonumber(t0)) / math.max(tonumber(d), 0.05)
					if uu >= 0 and uu <= 1 then
						kind, u = n, uu
					end
				end
			end
		end
		local hasAct = kind ~= nil and u >= 0 and u <= 1
		if isMe and not hasAct and (st == ST.Physics or st == ST.Climbing or st == ST.Swimming or st == ST.Seated or st == ST.PlatformStanding) then
			continue -- someone else is driving this body (swimming, diving board, skydiving, ladders)
		end
		if cs.acting and not hasAct then
			-- act over: forget what we wrote so nothing builds on a leftover pose (no snap: the next pose takes over)
			cs.acting = false
			for _, n in JN do
				if J[n] then
					written[J[n]] = nil
				end
			end
		end

		-- the Blender animations: idle / walk / jog / sprint by speed on one step cycle, jump and fall in the air
		local skip = NOSKIP
		if char:GetAttribute("BallPose") then
			skip = BOTH_ARMS -- the basketball script has the arms
		elseif char:FindFirstChildOfClass("Tool") then
			skip = RIGHT_ARM -- holding something: the tool pose keeps that arm
		end
		local animOn = Anim ~= nil and J.L1 ~= nil
		if animOn then
			local pose = Anim.locomotion(cs, speed, grounded, dt, now, (stamina or 1) < 0.35)
			for jn, cf in pose do
				if not skip[jn] then
					setJoint(J[jn], cf, 1)
				end
			end
		end
		if hasAct then
			local clip = animOn and ACT_CLIP[kind]
			local c = clip and Anim.clip(clip)
			if c then
				local w = math.min(c.blendIn > 0 and u / c.blendIn or 1, c.blendOut > 0 and (1 - u) / c.blendOut or 1)
				local pose = Anim.blendInto({}, clip, u, 1)
				for jn, cf in pose do
					if not skip[jn] then
						setJoint(J[jn], cf, math.clamp(w, 0, 1))
					end
				end
			elseif POSE[kind] then
				POSE[kind](J, u)
			end
			cs.ik = 0
			cs.acting = true
			continue
		end

		-- lean: into acceleration (back when braking) and into corners, like a body keeping its balance
		local facing = flat(hrp.CFrame.LookVector)
		facing = facing.Magnitude > 0.01 and facing.Unit or Vector3.new(0, 0, -1)
		local tp, tr = 0, 0
		if grounded then
			tp = math.clamp(cs.acc:Dot(facing) * 0.0045, -0.15, 0.12)
			if not animOn then
				tp += math.clamp(speed / SPRINT, 0, 1.2) * 0.055 -- (the run cycles already lean with speed)
			end
			tr = math.clamp(math.atan(speed * cs.yawRate / g) * 0.6, -0.32, 0.32)
		end
		cs.pitch += (tp - cs.pitch) * math.min(1, dt * 9)
		cs.roll += (tr - cs.roll) * math.min(1, dt * 9)

		-- feet on the ground: standing on stairs or a slope, the lower foot reaches down, the hips drop to it and
		-- the higher knee bends
		local rootH = hrp.Size.Y / 2 + hum.HipHeight
		local drop = 0
		cs.ik += ((grounded and speed < 0.7 and 1 or 0) - cs.ik) * math.min(1, dt * 8)
		if cs.ik > 0.01 and J.L1 and (hrp.Position - camPos).Magnitude < 80 then
			local y0 = hrp.Position.Y - rootH
			local rise = {}
			local dy = {}
			for _, side in { "Left", "Right" } do
				local foot = char:FindFirstChild(side .. "Foot")
				if foot then
					local fp = foot.Position
					local hit = workspace:Raycast(Vector3.new(fp.X, y0 + 2.0, fp.Z), Vector3.new(0, -5, 0), params)
					-- (nothing under that foot, e.g. over a kerb or roof edge: leave it be rather than reach into the gap)
					dy[side] = hit and math.clamp(hit.Position.Y - y0, -1.3, 1.3) or 0
				end
			end
			if dy.Left and dy.Right then
				drop = math.min(0, dy.Left, dy.Right) * cs.ik
				local L1, L2 = J.L1, J.L2
				for _, side in { "Left", "Right" } do
					local r = dy[side] * cs.ik - drop
					if r > 0.03 then
						local Dd = math.max((L1 + L2) * 0.5, L1 + L2 - 0.02 - r)
						local inner = math.acos(math.clamp((L1 * L1 + L2 * L2 - Dd * Dd) / (2 * L1 * L2), -1, 1))
						local hipA = math.acos(math.clamp((L1 * L1 + Dd * Dd - L2 * L2) / (2 * L1 * Dd), -1, 1))
						local kneeA = -(math.pi - inner)
						rise[side] = { hipA, kneeA }
					end
				end
				for side, a in rise do
					addTo(J[side .. "Hip"], A_(a[1], 0, 0))
					addTo(J[side .. "Knee"], A_(a[2], 0, 0))
					addTo(J[side .. "Ankle"], A_(-(a[1] + a[2]), 0, 0))
				end
			end
		end

		-- the whole body tips about the feet (so they stay put); a soft landing gives at the knees
		local root = J.Root
		if root and root:IsA("Motor6D") and root.Part0 == hrp then
			local jy = root.C0.Position.Y
			local pv = Vector3.new(0, -rootH - jy, 0)
			local dip = 0
			if isMe and M.dip then
				local t = (now - M.dip) / 0.28
				if t < 1 then
					dip = -0.45 * (M.dipAmt or 0.5) * math.sin(math.pi * t)
				else
					M.dip = nil
				end
			end
			addTo(root, CFrame.new(0, drop + dip, 0) * CFrame.new(pv) * A_(-cs.pitch, 0, cs.roll) * CFrame.new(-pv))
		end

		-- head and shoulders turn toward where they're looking; out of breath, the chest heaves
		cs.ly += (ly - cs.ly) * math.min(1, dt * 8)
		cs.lp += (lp - cs.lp) * math.min(1, dt * 8)
		local yawR, pitchR = rad(cs.ly), rad(cs.lp)
		local firstPerson = isMe and char:FindFirstChild("Head") and (camPos - char.Head.Position).Magnitude < 1.5
		if not firstPerson then
			addTo(J.Neck, A_(0, yawR * 0.55, 0) * A_(pitchR * 0.6, 0, 0))
		end
		local tired = (1 - math.clamp(stamina or 1, 0, 1)) ^ 1.5
		local breath = math.sin(now * math.pi * 2 * 1.4) * 0.05 * tired
		local sprintLean = animOn and 0 or -0.1 * clamp01((speed - JOG) / (SPRINT - JOG))
		addTo(J.Waist, A_(0, yawR * 0.35, 0) * A_(pitchR * 0.2 + breath + sprintLean, 0, 0))
	end
end)

---------------------------------------------------------------------------------------------- per character
local function onCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not (hum and hrp) then
		return
	end
	if A.kind then
		A = { kind = nil }
	end
	R = { on = false }
	M.V, M.controlling, M.lastSet, M.ext, M.air, M.jumpEnabled = Vector3.zero, false, nil, 1, false, nil
	M.stamina, M.exhausted = 1, false
	hum:SetAttribute("NC_Movement", true) -- (local only: tells the pool and TV scripts to slow you through SpeedFactor_)
	if hum.UseJumpPower then
		hum.JumpPower = math.sqrt(2 * workspace.Gravity * JUMP_HEIGHT)
	else
		hum.JumpHeight = JUMP_HEIGHT
	end
	recalcFactor(hum)
	hum.AttributeChanged:Connect(function()
		recalcFactor(hum)
	end)
	hum.StateChanged:Connect(function(_, new)
		if new == ST.Landed or ((new == ST.Running or new == ST.RunningNoPhysics) and M.air) then
			if M.air and not R.on and not A.path then
				onLand(char, hrp, hum, -M.airVy)
			end
			M.air = false
		elseif new == ST.Physics or new == ST.Swimming or new == ST.Seated or new == ST.Dead or new == ST.Climbing then
			M.air = false
		end
	end)
	-- bodies crumple when they die (the server unhooks the joints for everyone; this makes them land on the floor)
	hum.Died:Connect(function()
		if A.kind and A.path then
			restoreCollide(A.saved)
		end
		A = { kind = nil }
		if not R.on and char:FindFirstChild("NC_Ragdoll") then
			R = { on = true, t0 = os.clock(), minT = math.huge, saved = {}, dead = true }
			setBodyCollide(char, hrp, R.saved, "body")
			localMotors(char, false)
		end
	end)
	-- hit by something big and fast (a car): knocked down
	for _, part in char:GetChildren() do
		if part:IsA("BasePart") then
			part.Touched:Connect(function(other)
				if R.on or hum.Health <= 0 or hum.SeatPart or other.Anchored or not other.CanCollide or other:IsDescendantOf(char) then
					return
				end
				if hum:GetState() == ST.Physics or char:GetAttribute("SwimPose") or char:GetAttribute("ChuteState") then
					return -- swimming, skydiving or mid-vault: another script owns the body
				end
				local model = other:FindFirstAncestorOfClass("Model")
				if model and model:FindFirstChildOfClass("Humanoid") then
					return
				end
				local ov = other.AssemblyLinearVelocity
				local rel = ov - hrp.AssemblyLinearVelocity
				if ov.Magnitude > 30 and rel.Magnitude > 36 and other.AssemblyMass > 40 then
					local push = ov * 0.8 + Vector3.new(0, 16 + rel.Magnitude * 0.18, 0)
					if not startRagdoll(char, hrp, hum, push, 2.6) then
						startPoseAct("stumble", 0.5)
					end
				end
			end)
		end
	end
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">NCAnimPlayer</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NCAnimPlayer (ModuleScript in ReplicatedStorage): plays the Blender-made movement animations (NCAnimations, from
-- build_anims.py / NeonCoast_Animations.blend) straight onto the body joints, on every screen, for every player.
-- No uploads: the clips are data, sampled and blended here and written to Motor6D.Transform by MovementClient.
--   locomotion(): idle -> walk -> jog -> sprint blended by speed, all on one shared step cycle that advances at
--   speed / stride, so the planted foot moves with the ground at any speed (no skating); out of breath, the idle
--   bends over into hands-on-knees; in the air it crossfades through the jump into the falling loop.
--   blendInto(): any clip (loops wrap, one-shots clamp) at a point in time, mixed into a pose with a weight.
local RS = game:GetService("ReplicatedStorage")

local P = { ok = false }
local clips = {}

local function build(data)
	for name, c in data.clips do
		local frames = table.create(c.n)
		for i = 1, c.n do
			local f = {}
			local k, pk = (i - 1) * 4, (i - 1) * 3
			for jn, q in c.q do
				if jn == "Root" then
					f[jn] = CFrame.new(c.p[pk + 1], c.p[pk + 2], c.p[pk + 3], q[k + 1], q[k + 2], q[k + 3], q[k + 4])
				else
					f[jn] = CFrame.new(0, 0, 0, q[k + 1], q[k + 2], q[k + 3], q[k + 4])
				end
			end
			frames[i] = f
		end
		clips[name] = { dur = c.dur, loop = c.loop, n = c.n, frames = frames, speed = c.speed, stride = c.stride,
			blendIn = c.blendIn or 0.1, blendOut = c.blendOut or 0.15 }
	end
end

function P.init()
	local mod = RS:FindFirstChild("NCAnimations") or RS:WaitForChild("NCAnimations", 8)
	if not mod then
		return false
	end
	local ok, data = pcall(require, mod)
	if ok and type(data) == "table" and data.clips then
		build(data)
		P.ok = clips.Idle ~= nil and clips.Walk ~= nil and clips.Jog ~= nil and clips.Sprint ~= nil
	end
	return P.ok
end

function P.has(name)
	return clips[name] ~= nil
end
function P.clip(name)
	return clips[name]
end

-- the clip's pose at u (0..1; loops wrap, one-shots clamp), mixed into out with weight w
function P.blendInto(out, name, u, w)
	local c = clips[name]
	if not c or w <= 0 then
		return out
	end
	local fa, fb, t
	if c.loop then
		local x = (u % 1) * c.n
		local a = math.floor(x)
		t = x - a
		fa, fb = c.frames[a + 1], c.frames[(a + 1) % c.n + 1]
	else
		local x = math.clamp(u, 0, 1) * (c.n - 1)
		local a = math.min(math.floor(x), c.n - 2)
		t = x - a
		fa, fb = c.frames[a + 1], c.frames[a + 2]
	end
	for jn, cfa in fa do
		local cf = cfa:Lerp(fb[jn], t)
		if w >= 1 then
			out[jn] = cf
		else
			out[jn] = (out[jn] or CFrame.identity):Lerp(cf, w)
		end
	end
	return out
end

local function mix(out, pose, w)
	if w <= 0 then
		return
	end
	for jn, cf in pose do
		out[jn] = w >= 1 and cf or (out[jn] or CFrame.identity):Lerp(cf, w)
	end
end

-- cs: the per-character state table (phase, idle clock, air and tired weights live in it)
function P.locomotion(cs, speed, grounded, dt, now, tired)
	local out = {}
	local walk, jog, sprint = clips.Walk, clips.Jog, clips.Sprint
	cs.idleT = (cs.idleT or 0) + dt
	cs.tiredW = (cs.tiredW or 0) + ((tired and 1 or 0) - (cs.tiredW or 0)) * math.min(1, dt * 1.5)
	P.blendInto(out, "Idle", cs.idleT / clips.Idle.dur, 1)
	if cs.tiredW > 0.01 and clips.TiredIdle then
		P.blendInto(out, "TiredIdle", cs.idleT / clips.TiredIdle.dur, cs.tiredW)
	end
	if speed > 0.1 then
		local A, B, w
		if speed <= walk.speed then
			A, B, w = "Walk", "Walk", 0
		elseif speed <= jog.speed then
			A, B, w = "Walk", "Jog", (speed - walk.speed) / (jog.speed - walk.speed)
		else
			A, B, w = "Jog", "Sprint", math.min(1, (speed - jog.speed) / (sprint.speed - jog.speed))
		end
		local stride = clips[A].stride + (clips[B].stride - clips[A].stride) * w
		cs.phase = ((cs.phase or 0) + speed / stride * dt) % 1
		local g = P.blendInto({}, A, cs.phase, 1)
		if w > 0 then
			P.blendInto(g, B, cs.phase, w)
		end
		mix(out, g, math.clamp(speed / 1.5, 0, 1))
	end
	cs.airW = (cs.airW or 0) + ((grounded and 0 or 1) - (cs.airW or 0)) * math.min(1, dt * (grounded and 14 or 8))
	if cs.airW > 0.01 and clips.Fall then
		local a = {}
		local since = cs.takeoffT and (now - cs.takeoffT) or 99
		local jd = clips.JumpUp and clips.JumpUp.dur or 0
		if since < jd then
			P.blendInto(a, "JumpUp", since / jd, 1)
		else
			P.blendInto(a, "Fall", cs.idleT / clips.Fall.dur, 1)
			if clips.JumpUp and since < jd + 0.3 then
				local j = P.blendInto({}, "JumpUp", 1, 1)
				mix(j, a, (since - jd) / 0.3)
				a = j
			end
		end
		mix(out, a, cs.airW)
	end
	return out
end

return P
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">NCAnimations</string><ProtectedString name="Source"><![CDATA[-- NCAnimations: generated by build_anims.py from NeonCoast_Animations.blend. Do not hand-edit; re-run it.
-- Per clip: dur (s), loop, n samples (evenly spaced over the loop, or start..end for one-shots), q = per joint
-- (Motor6D name) flat quaternions qx,qy,qz,qw per sample (= Motor6D.Transform rotation), p = Root translation
-- x,y,z per sample. Gaits also carry speed and stride (studs per cycle: play at speed/stride cycles per second
-- and the feet don't slide). blendIn/blendOut: fractions of a one-shot to fade in and out over.
return {
	clips = {
		Bump = {
			blendIn = 0.1,
			blendOut = 0.3,
			dur = 0.45,
			loop = false,
			n = 15,
			p = {0,0,0,0,-0.0215,0.0143,0,-0.0696,0.0464,0,-0.1203,0.0802,0,-0.149,0.0993,0,-0.1472,0.0981,0,-0.1367,0.0911,0,-0.1203,0.0802,0,-0.0998,0.0666,0,-0.0773,0.0515,0,-0.0546,0.0364,0,-0.0336,0.0224,0,-0.0162,0.0108,0,-0.0044,0.0029,0,0,0},
			q = {
				LeftAnkle = {0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1,0,0,0,1},
				LeftElbow = {0.1736,0,0,0.9848,0.2529,0,0,0.9675,0.424,0,0,0.9056,0.5886,0,0,0.8084,0.6728,0,0,0.7398,0.6667,0,0,0.7454,0.6328,0,0,0.7743,0.5773,0,0,0.8165,0.5044,0,0,0.8635,0.4196,0,0,0.9077,0.3302,0,0,0.9439,0.2448,0,0,0.9696,0.1726,0,0,0.985,0.123,0,0,0.9924,0.1045,0,0,0.9945},
				LeftHip = {0,0,0,1,0.025,0,0,0.9997,0.0809,0,0,0.9967,0.1395,0,0,0.9902,0.1725,0,0,0.985,0.1704,0,0,0.9854,0.1584,0,0,0.9874,0.1395,0,0,0.9902,0.1159,0,0,0.9933,0.0898,0,0,0.996,0.0635,0,0,0.998,0.039,0,0,0.9992,0.0188,0,0,0.9998,0.0051,0,0,1,0,0,0,1},
				LeftKnee = {0,0,0,1,-0.0312,0,0,0.9995,-0.1011,0,0,0.9949,-0.174,0,0,0.9847,-0.215,0,0,0.9766,-0.2124,0,0,0.9772,-0.1975,0,0,0.9803,-0.174,0,0,0.9847,-0.1447,0,0,0.9895,-0.1122,0,0,0.9937,-0.0793,0,0,0.9969,-0.0488,0,0,0.9988,-0.0235,0,0,0.9997,-0.0064,0,0,1,0,0,0,1},
				LeftShoulder = {0.087,0.0046,-0.0521,0.9948,0.1488,0.0104,-0.069,0.9864,0.2841,0.0311,-0.1043,0.9526,0.4185,0.0634,-0.1357,0.8958,0.49,0.086,-0.1499,0.8544,0.4849,0.0843,-0.149,0.8577,0.4565,0.075,-0.1438,0.8748,0.4109,0.0615,-0.1347,0.8996,0.3521,0.0463,-0.1219,0.9268,0.2851,0.0318,-0.1062,0.9521,0.2156,0.0197,-0.089,0.9722,0.1501,0.011,-0.072,0.986,0.0951,0.0055,-0.0575,0.9938,0.0575,0.0027,-0.0473,0.9972,0.0436,0.0019,-0.0436,0.9981},
