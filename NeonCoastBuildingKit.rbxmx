			{-44.0, 0.0, -47.2, -43.2, 0.35, -0.8, "deck"},
			{47.2, 0.0, -47.2, 48.0, 0.35, -0.8, "deck"},
			{-35.5, 0.0, -36.6, 35.5, 0.42, -35.45, "coping"},
